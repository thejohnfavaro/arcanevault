{
  "author": "RNGesus",
  "id": "com.rngesus.arcanevault.edge",
  "name": "Arcane Vault — Deck Dashboard",
  "description": "A commander art, verified deck W/L, account rank and collection dashboard for XENEON EDGE.",
  "version": "0.7.0",
  "preview_icon": "resources/icon.svg",
  "min_app_version": "5.52",
  "min_framework_version": "1.9.0",
  "os": [
    {
      "platform": "windows"
    }
  ],
  "supported_devices": [
    {
      "type": "dashboard_lcd"
    }
  ],
  "interactive": true,
  "required_plugins": [
    "widgetbuilder.filesystemprovider:FileSystem:1.0"
  ],
  "permissions": [
    {
      "type": "file",
      "path": "<Runtime>/AppData/Local/ArcaneVault/streamdeck.json"
    },
    {
      "type": "url",
      "domain": "cards.scryfall.io",
      "port": 443
    }
  ]
}
