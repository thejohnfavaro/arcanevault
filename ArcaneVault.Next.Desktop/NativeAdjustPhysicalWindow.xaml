<Window x:Class="ArcaneVault.Next.Desktop.NativeAdjustPhysicalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault Next — Adjust physical ownership"
        Width="650" Height="445" MinWidth="570" MinHeight="405"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1017" Foreground="#F0F1F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Edit a selected physical row's quantity"
                   FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" x:Name="SelectedCardText" TextWrapping="Wrap"
                   Foreground="#DDC091" FontSize="14" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New total quantity" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="NewQuantityBox" Width="90" Padding="9,7"
                         Background="#202737" Foreground="White" BorderBrush="#343D51"
                         Margin="0,0,14,0"/>
                <Button Content="Set to 0 (remove line)" Padding="12,8"
                        Click="OnSetZeroClicked" Background="#382438"
                        Foreground="White" BorderBrush="#79516C"/>
            </StackPanel>
            <TextBlock Margin="0,9,0,0" Foreground="#9DA9BD" TextWrapping="Wrap"
                       Text="Change this exact row from 0 to 99,999 copies (0 removes it). Unresolved printing IDs remain unresolved; no identities or other rows are changed."/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="If removing, type REMOVE:" VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <TextBox x:Name="ConfirmRemoveBox" Width="110" Padding="9,7"
                     Background="#202737" Foreground="White" BorderBrush="#343D51"/>
        </StackPanel>
        <DockPanel Grid.Row="4" LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ApplyButton" Content="Review &amp; save change"
                        Padding="15,9" Click="OnApplyClicked" Margin="0,0,12,0"
                        Background="#7663B3" Foreground="White" BorderBrush="#B59BFC"/>
                <Button Content="Cancel" IsCancel="True" Padding="15,9"
                        Background="#202737" Foreground="White"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#9DA9BD" TextWrapping="Wrap"
                       Text="Edits are staged and checked. The previous native collection is retained for recovery; the installed Windows app is untouched."/>
        </DockPanel>
    </Grid>
</Window>
