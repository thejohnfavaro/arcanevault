<Window x:Class="ArcaneVault.Next.Desktop.NativeReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault — Backup Readiness" Width="710" Height="590"
        MinWidth="540" MinHeight="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="BACKUP READINESS" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource VaultAccent}"/>
            <TextBlock Text="Verify a full collection backup" FontSize="22"
                       Margin="0,5,0,6" FontWeight="Bold"
                       Foreground="{DynamicResource VaultText}"/>
            <TextBlock Text="Choose an exported schema-2 full backup. Inspection is read-only and never restores, imports, overwrites or changes the active collection. Keep a private backup before upgrading."
                       TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}"/>
        </StackPanel>
        <Button Grid.Row="1" x:Name="ChooseBackupButton"
                Content="Choose full backup to check…"
                Click="OnChooseBackupClicked"
                HorizontalAlignment="Left" Padding="12,7"
                Margin="0,0,0,12"
                Background="{DynamicResource VaultAccentMuted}"
                Foreground="{DynamicResource VaultText}"
                BorderBrush="{DynamicResource VaultAccentBorder}"/>
        <Border Grid.Row="2" Background="{DynamicResource VaultPanel}"
                BorderBrush="{DynamicResource VaultLine}" BorderThickness="1"
                CornerRadius="9" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ReadinessReport" TextWrapping="Wrap"
                           FontSize="12" LineHeight="19"
                           Foreground="{DynamicResource VaultText}"
                           Text="No export selected. Use Choose full backup to check… to validate your own exported file. No application data will be modified."/>
            </ScrollViewer>
        </Border>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyReadinessButton" Content="Copy report"
                    Click="OnCopyReportClicked" IsEnabled="False"
                    Padding="12,7" Margin="0,0,9,0"
                    Background="{DynamicResource VaultPanelRaised}"
                    Foreground="{DynamicResource VaultText}"/>
            <Button Content="Close" Click="OnCloseClicked" Padding="12,7"
                    Background="{DynamicResource VaultPanelRaised}"
                    Foreground="{DynamicResource VaultText}"/>
        </WrapPanel>
    </Grid>
</Window>