<Window x:Class="ArcaneVault.Next.Desktop.NativeImportDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review CSV / Excel collection differences"
        Width="1050" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1017" Foreground="#F0F1F6">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Review collection differences"
                   FontWeight="SemiBold" FontSize="20" Margin="0,0,0,8"/>
        <TextBlock x:Name="FileNameText" Grid.Row="1" TextWrapping="Wrap"
                   Foreground="#B5C1D3" Margin="0,0,0,8"/>
        <Border Grid.Row="2" Margin="0,0,0,12" CornerRadius="7"
                Padding="12" Background="#171C28" BorderBrush="#514276"
                BorderThickness="1">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="AuditText" TextWrapping="Wrap"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#D6C8FF" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                               FontSize="12" Foreground="#F0F1F6"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               FontSize="12" Foreground="#E5BF79"
                               Text="Imports only reconcile listed identities; local-only holdings remain owned. Explicit zero removes an exact match. Catalog-unverified printings are tracked as unresolved, not counted as verified set ownership."/>
                    <CheckBox x:Name="UnresolvedAcknowledged" Visibility="Collapsed"
                              Margin="0,11,0,0"
                              Foreground="#E5BF79"
                              Checked="OnAcknowledgementChanged"
                              Unchecked="OnAcknowledgementChanged">
                        <TextBlock TextWrapping="Wrap" MaxWidth="900"
                                   Text="I understand that unresolved or ambiguous source printings will remain unverified and may require manual printing selection after import."/>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <DataGrid Grid.Row="3" x:Name="ChangesTable" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="True" CanUserResizeColumns="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="29"
                  AlternatingRowBackground="#202737"
                  Background="#171C28" Foreground="#F0F1F6"
                  BorderBrush="#514276" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#252C3D"/>
                    <Setter Property="Foreground" Value="#F0F1F6"/>
                    <Setter Property="Padding" Value="9,8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="#514276"/>
                </Style>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Background" Value="#171C28"/>
                    <Setter Property="Foreground" Value="#F0F1F6"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110"/>
                <DataGridTextColumn Header="Card" Binding="{Binding Card}" Width="2*"/>
                <DataGridTextColumn Header="Printing / identity" Binding="{Binding Identity}" Width="2*"/>
                <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="85"/>
                <DataGridTextColumn Header="Imported" Binding="{Binding Imported}" Width="85"/>
                <DataGridTextColumn Header="Difference" Binding="{Binding ChangeLabel}" Width="95"/>
                <DataGridTextColumn Header="Verification" Binding="{Binding Verification}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="SafetyText" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="#B5C1D3" Margin="0,0,20,0"/>
            <Button Grid.Column="1" Content="Export audit…" Click="OnExportAuditClicked"
                    Padding="16,9" Margin="0,0,9,0"
                    Background="#202737" Foreground="White"
                    BorderBrush="#514276"/>
            <Button Grid.Column="2" Content="Cancel" IsCancel="True"
                    Padding="16,9" Margin="0,0,9,0"
                    Background="#202737" Foreground="White"
                    BorderBrush="#514276"/>
            <Button Grid.Column="3" x:Name="ApplyButton"
                    Content="Apply reviewed differences"
                    Click="OnApplyClicked" Padding="16,9"
                    Background="#7663B3" Foreground="White"
                    BorderBrush="#B59BFC"/>
        </Grid>
    </Grid>
</Window>