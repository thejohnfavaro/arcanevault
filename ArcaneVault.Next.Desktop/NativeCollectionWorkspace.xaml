<UserControl x:Class="ArcaneVault.Next.Desktop.NativeCollectionWorkspace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcaneVault.Next.Desktop"
        Background="{StaticResource VaultBackground}"
        Foreground="{StaticResource VaultText}">
    <Grid Margin="14,15,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource VaultEyebrow}"
                           Text="YOUR VAULT" Margin="0,0,0,6"/>
                <TextBlock Text="Collection &amp; Deck Library"
                           FontSize="29" FontWeight="Bold"/>
                <TextBlock x:Name="DataSourceLabel"
                           Style="{StaticResource VaultMutedText}"
                           Text="Read-only exported backup preview — not an import"
                           Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{StaticResource VaultAccentSurface}"
                    BorderBrush="{StaticResource VaultAccentBorder}"
                    BorderThickness="1" CornerRadius="18"
                    VerticalAlignment="Top" Padding="12,7" Margin="12,5,0,0">
                <TextBlock Text="✦  ARCANE VAULT"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource VaultAccent}"/>
            </Border>
        </Grid>

        <!-- Summary tiles mirror the original dashboard stats, but only
             show verified live/native data instead of guessed ownership. -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="13"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource VaultPanelCard}">
                <StackPanel>
                    <TextBlock Text="OWNED INVENTORY"
                               Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TotalsText"
                               Foreground="{StaticResource VaultText}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource VaultPanelCard}">
                <StackPanel>
                    <TextBlock Text="PRINTING VERIFICATION"
                               Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="VerificationText"
                               Foreground="{StaticResource VaultGood}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource VaultPanelCard}"
                Padding="12,10" Margin="0,0,0,13">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="MissingOnly"
                              Content="Unresolved printings only"
                              Margin="0,0,16,0"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                    <Button Content="Card details" Click="OnDetailsClicked"
                            Style="{StaticResource VaultPrimaryButton}"
                            Padding="17,9"/>
                </StackPanel>
                <TextBox x:Name="SearchBox"
                         ToolTip="Filter card names, set hints, collector numbers and verification"
                         TextChanged="OnFilterChanged"
                         Padding="11,9" FontSize="14"
                         Background="{StaticResource VaultPanelRaised}"
                         Foreground="{StaticResource VaultText}"
                         BorderBrush="{StaticResource VaultLine}"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="3" x:Name="CollectionTabs"
                    Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}" BorderBrush="{StaticResource VaultLine}">
            <TabItem Header="Physical Collection">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,4,0,12">
                        <Button x:Name="AddPhysicalButton" Content="＋  Add physical printing"
                                Click="OnAddPhysicalClicked" IsEnabled="False"
                                Style="{StaticResource VaultPrimaryButton}"
                                Padding="14,9" Margin="0,0,10,0"/>
                        <Button x:Name="AdjustPhysicalButton" Content="Edit selected quantity"
                                Click="OnAdjustPhysicalClicked" IsEnabled="False"
                                Style="{StaticResource VaultDangerButton}"
                                Padding="14,9" Margin="0,0,12,0"/>
                        <Button x:Name="ImportExcelButton" Content="Import CSV / Excel"
                                Click="OnImportExcelClicked" IsEnabled="False"
                                Style="{StaticResource VaultPrimaryButton}"
                                Padding="14,9" Margin="0,0,12,0"/>
                        <ComboBox x:Name="PhysicalViewMode" SelectedIndex="0"
                                  SelectionChanged="OnPhysicalViewModeChanged"
                                  MinWidth="128" Height="36" Padding="6,4"
                                  Background="{StaticResource VaultPanelRaised}"
                                  Foreground="{StaticResource VaultText}"
                                  ToolTip="Switch physical inventory between detailed and compact columns">
                            <ComboBoxItem Content="Detailed"/>
                            <ComboBoxItem Content="Compact"/>
                        </ComboBox>
                        <TextBlock Text="Exact print/finish values • missing quotes are not $0"
                                   Style="{StaticResource VaultMutedText}"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock x:Name="PhysicalValuationSummary" FontWeight="SemiBold"
                                   FontSize="15" Foreground="{StaticResource VaultText}"
                                   TextWrapping="Wrap"
                                   Text="Valuation not calculated yet."/>
                        <TextBlock x:Name="PhysicalValuationTimestamp" Margin="0,4,0,0"
                                   Foreground="{StaticResource VaultMuted}"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Text="Prices are indicative USD estimates from the official cached Scryfall bulk snapshot."/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="SORT PHYSICAL" Style="{StaticResource VaultEyebrow}"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PhysicalPriceSort" SelectedIndex="0"
                                  SelectionChanged="OnPhysicalSortChanged"
                                  Width="190" Height="32" Margin="0,0,13,0"
                                  Background="{StaticResource VaultPanelRaised}"
                                  Foreground="{StaticResource VaultText}">
                            <ComboBoxItem Content="Original inventory order"/>
                            <ComboBoxItem Content="Unit price: high to low"/>
                            <ComboBoxItem Content="Unit price: low to high"/>
                            <ComboBoxItem Content="Line value: high to low"/>
                            <ComboBoxItem Content="Line value: low to high"/>
                        </ComboBox>
                        <Button x:Name="RecalculatePricesButton"
                                Content="Recalculate cached prices"
                                Click="OnRecalculatePricesClicked"
                                Padding="12,7" Margin="0,0,12,0"
                                Background="{StaticResource VaultPanelRaised}"
                                Foreground="{StaticResource VaultText}"
                                BorderBrush="{StaticResource VaultLine}"/>
                        <TextBlock Text="For new quotes, run Full Scryfall Sync in the main window"
                                   Foreground="{StaticResource VaultMuted}"
                                   VerticalAlignment="Center" FontSize="11"/>
                    </WrapPanel>
                <ListView Grid.Row="3" x:Name="PhysicalList" MouseDoubleClick="OnCardRowDoubleClick"
                          Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Card" Width="285" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Qty" Width="50" DisplayMemberBinding="{Binding Quantity}"/>
                            <GridViewColumn Header="Set / #" Width="135" DisplayMemberBinding="{Binding SetAndNumber}"/>
                            <GridViewColumn Header="Finish" Width="95" DisplayMemberBinding="{Binding Finish}"/>
                            <GridViewColumn Header="Unit USD" Width="105" DisplayMemberBinding="{Binding UnitLabel}"/>
                            <GridViewColumn Header="Line USD" Width="105" DisplayMemberBinding="{Binding LineLabel}"/>
                            <GridViewColumn Header="Price status" Width="260" DisplayMemberBinding="{Binding PriceStatus}"/>
                            <GridViewColumn Header="Printing verification" Width="260" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Arena Collection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                Margin="8,9,8,9">
                        <Button x:Name="AddArenaButton" Content="Add Arena card"
                                Click="OnAddArenaClicked" IsEnabled="False"
                                Padding="14,8" Margin="0,0,12,0"
                                Background="{StaticResource VaultAccentMuted}" Foreground="White"
                                BorderBrush="{StaticResource VaultAccent}"/>
                        <Button x:Name="EditArenaButton" Content="Edit / remove selected Arena card"
                                Click="OnEditArenaClicked" IsEnabled="False"
                                Padding="14,8" Background="#382438"
                                Foreground="White" BorderBrush="#79516C"/>
                        <Button x:Name="ImportArenaButton" Content="Import CSV / Excel"
                                Click="OnImportArenaClicked" IsEnabled="False"
                                Padding="14,8" Margin="12,0,0,0"
                                Background="{StaticResource VaultPanelRaised}"
                                Foreground="{StaticResource VaultText}"
                                BorderBrush="{StaticResource VaultAccentBorder}"/>
                        <TextBlock VerticalAlignment="Center" Margin="17,0,0,0"
                                   Foreground="{StaticResource VaultMuted}" Text="Arena is name-only; no printing ID required."/>
                    </StackPanel>
                <ListView Grid.Row="1" x:Name="ArenaList" MouseDoubleClick="OnCardRowDoubleClick"
                          Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Card" Width="470" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Owned" Width="100" DisplayMemberBinding="{Binding Quantity}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Deck Library">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button x:Name="AddDeckButton" Content="New deck"
                                Click="OnAddDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{StaticResource VaultAccentMuted}" Foreground="White"
                                BorderBrush="{StaticResource VaultAccent}"/>
                        <Button x:Name="EditDeckButton" Content="Edit selected deck"
                                Click="OnEditDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{StaticResource VaultPanelRaised}" Foreground="White"
                                BorderBrush="#65778B"/>
                        <Button x:Name="DuplicateDeckButton" Content="Duplicate selected deck"
                                Click="OnDuplicateDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{StaticResource VaultPanelRaised}" Foreground="White"
                                BorderBrush="#65778B"/>
                        <Button x:Name="DeleteDeckButton" Content="Delete selected deck"
                                Click="OnDeleteDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="#382438" Foreground="White"
                                BorderBrush="#79516C"/>
                        <TextBox x:Name="DeckSearchBox" Width="160" Height="35"
                                 ToolTip="Search saved deck names, commanders and folders"
                                 TextChanged="OnDeckFilterChanged"
                                 Background="{StaticResource VaultPanelRaised}"
                                 Foreground="{StaticResource VaultText}" Padding="8,6"
                                 Margin="4,0,10,0"/>
                        <CheckBox x:Name="FavoriteDecksOnly" Content="★ Favorites"
                                  Foreground="{StaticResource VaultText}"
                                  VerticalAlignment="Center"
                                  Checked="OnDeckFilterChanged"
                                  Unchecked="OnDeckFilterChanged"
                                  Margin="0,0,10,0"/>
                    </WrapPanel>
                    <ListView Grid.Row="1" x:Name="DeckLibraryList"
                              SelectionChanged="OnDeckSelected"
                              Background="{StaticResource VaultPanel}"
                              Foreground="{StaticResource VaultText}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource VaultPanelRaised}"
                                        BorderBrush="{StaticResource VaultLine}"
                                        BorderThickness="1" CornerRadius="12"
                                        Margin="7,6" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="91"/>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="156"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Lightweight deck-box cover visual; no image request
                                             during virtualized deck-list scrolling. -->
                                        <Border Grid.Column="0" Width="85" Height="109"
                                                CornerRadius="9" ClipToBounds="True"
                                                BorderBrush="{StaticResource VaultAccentBorder}"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4A3362" Offset="0"/>
                                                    <GradientStop Color="#24203C" Offset="0.58"/>
                                                    <GradientStop Color="#141A28" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Border Background="#55000000"
                                                        Width="9" HorizontalAlignment="Left"
                                                        Margin="0,0,0,0"/>
                                                <TextBlock Text="✦" FontSize="37"
                                                           Foreground="{StaticResource VaultAccent}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.74"/>
                                                <TextBlock Text="DECK" FontWeight="Bold" FontSize="10"
                                                           Foreground="#D8C6FF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           Margin="0,0,0,10"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FavoriteLabel}"
                                                           Foreground="{StaticResource VaultWarning}"
                                                           FontSize="12" Margin="0,1,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource VaultText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Commander}"
                                                       FontSize="12" Foreground="{StaticResource VaultMuted}"
                                                       Margin="0,7,0,8"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel>
                                                <Border Background="{StaticResource VaultAccentSurface}"
                                                        BorderBrush="{StaticResource VaultAccentBorder}"
                                                        BorderThickness="1" CornerRadius="11"
                                                        Padding="9,4" Margin="0,0,9,0">
                                                    <TextBlock Text="{Binding Format}"
                                                               Foreground="{StaticResource VaultAccent}"
                                                               FontSize="11"/>
                                                </Border>
                                                <Border Background="#272E3D" CornerRadius="11"
                                                        Padding="9,4">
                                                    <TextBlock Text="{Binding Folder}" FontSize="11"
                                                               Foreground="{StaticResource VaultMuted}"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="3" Margin="12,4,0,4"
                                              VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding TotalCopies}" FontSize="21"
                                                           FontWeight="SemiBold" Foreground="{StaticResource VaultText}"/>
                                                <TextBlock Text=" copies" FontSize="11"
                                                           Margin="5,8,0,0" Foreground="{StaticResource VaultMuted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Margin="0,4,0,0"
                                                       Foreground="{StaticResource VaultMuted}" FontSize="11"
                                                       Text="{Binding EntryCount, StringFormat={}{0} unique names}"/>
                                            <TextBlock Grid.Row="2" Margin="0,4,0,0"
                                                       Foreground="{StaticResource VaultWarning}" FontSize="11"
                                                       Text="{Binding Revisions, StringFormat={}{0} saved revisions}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" x:Name="DeckLibraryStatus"
                               Foreground="{StaticResource VaultMuted}" TextWrapping="Wrap"
                               Margin="0,11,0,0"
                               Text="Saved decks are distinct from ownership. Format legality is not yet validated."/>
                </Grid>
            </TabItem>
            <TabItem Header="Set Progress">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="SetBrowseRow" Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="SetChecklistRow" Height="0"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,9">
                        <TextBlock Text="COLLECTION" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource VaultMuted}"/>
                        <ComboBox x:Name="SetScopeBox" Width="230" Height="38"
                                  SelectedIndex="0" SelectionChanged="OnSetScopeChanged"
                                  Background="{StaticResource VaultPanelRaised}"
                                  Foreground="{StaticResource VaultText}"
                                  Margin="0,0,18,0"
                                  ToolTip="Physical tracks verified printing slots; Arena tracks card-name availability only">
                            <ComboBoxItem Content="Physical · verified printings"/>
                            <ComboBoxItem Content="Arena · card-name coverage"/>
                        </ComboBox>
                        <TextBlock x:Name="FindSetLabel" Text="Find a set" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SetSearch" Width="220" Padding="8,5"
                                 Background="{StaticResource VaultPanelRaised}" Foreground="White" BorderBrush="{StaticResource VaultLine}"
                                 TextChanged="OnSetFilterChanged" Margin="0,0,18,0"/>
                        <CheckBox x:Name="ShowEmptySets" Content="Include sets with no progress"
                                  IsChecked="False" VerticalAlignment="Center"
                                  Checked="OnSetFilterChanged" Unchecked="OnSetFilterChanged"/>
                    </WrapPanel>
                    <ListView Grid.Row="1" x:Name="SetSummaryList"
                              SizeChanged="OnSetSummarySizeChanged"
                              Background="{StaticResource VaultPanel}"
                              Foreground="{StaticResource VaultText}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                <Border MouseLeftButtonDown="OnSetTileClicked" Cursor="Hand"
                                        ToolTip="Open the selected set and browse its cards"
                                        Background="{StaticResource VaultPanelRaised}"
                                        BorderBrush="{StaticResource VaultAccentBorder}"
                                        BorderThickness="1" CornerRadius="12"
                                        Height="196" Margin="6,6" ClipToBounds="True">
                                    <Grid x:Name="SetBannerSurface" ClipToBounds="True">
                                        <!-- ImageBrush paints the fixed-size tile background without
                                             affecting measure/arrange. UniformToFill crops the image at
                                             the tile edges instead of resizing the tile or adding bars. -->
                                        <Grid.Background>
                                            <ImageBrush ImageSource="{Binding Source, ElementName=SetBannerImage}"
                                                        Stretch="UniformToFill" AlignmentX="Center"
                                                        AlignmentY="Center" Opacity="0.9"/>
                                        </Grid.Background>
                                        <!-- Zero-size loader keeps the existing bounded Scryfall image
                                             cache, cancellation and decode path; only the brush paints. -->
                                        <local:NativeCardArtImage x:Name="SetBannerImage"
                                            ArtUrl="{Binding BannerArtworkUrl}" DecodeWidth="600"
                                            Width="0" Height="0" Opacity="0"
                                            IsHitTestVisible="False"/>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#AA101521" Offset="0"/>
                                                    <GradientStop Color="#30101520" Offset="0.35"/>
                                                    <GradientStop Color="#F5101523" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid Margin="15,12,15,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="54" Height="54" CornerRadius="9"
                                                        BorderBrush="#80FFFFFF" BorderThickness="1"
                                                        Background="#C0202532" Padding="8"
                                                        ToolTip="Official set symbol (cached locally from Scryfall)">
                                                    <local:NativeSetSymbol SetCode="{Binding SetCode}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplaySetCode}"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           FontWeight="Bold" Margin="10,0,0,0"
                                                           Foreground="White"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PercentLabel}"
                                                           FontSize="23" FontWeight="Bold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding SetName}" FontSize="17"
                                                           FontWeight="Bold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Grid Margin="0,4,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Released}" FontSize="11"
                                                               Foreground="#E0E8EF"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CopiesLabel}"
                                                               FontSize="11" Foreground="#E0E8EF"/>
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Height="7"
                                                             Value="{Binding Percent, Mode=OneWay}"
                                                             Background="#7A111827"
                                                             Foreground="{StaticResource VaultAccent}"/>
                                                <TextBlock Text="{Binding SlotsLabel}" FontSize="11"
                                                           Foreground="White" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid x:Name="SetDetailsControls" Grid.Row="2"
                          Visibility="Collapsed" Margin="0,14,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button x:Name="BackToSetsButton" Content="← All sets"
                                    Click="OnBackToSetsClicked" Padding="13,7"
                                    Margin="0,0,17,0" Background="{StaticResource VaultPanelRaised}"
                                    Foreground="{StaticResource VaultText}"
                                    BorderBrush="{StaticResource VaultAccentBorder}"/>
                            <CheckBox x:Name="HideUnownedSetSlots" Content="Hide unowned cards / printings"
                                      VerticalAlignment="Center"
                                      Checked="OnSetOwnedFilterChanged"
                                      Unchecked="OnSetOwnedFilterChanged"
                                      Foreground="{StaticResource VaultText}"
                                      ToolTip="In Physical view: only verified owned collector slots. In Arena view: only owned card names."/>
                        </WrapPanel>
                        <TextBlock x:Name="SetDetailsHeader" Grid.Row="1"
                                   Foreground="{StaticResource VaultMuted}"
                                   TextWrapping="Wrap"
                                   Text="Select a set to inspect its card checklist."/>
                    </Grid>
                    <ListView Grid.Row="3" x:Name="SetSlotsList"
                              Visibility="Collapsed"
                              MouseDoubleClick="OnCardRowDoubleClick"
                              Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource VaultPanelRaised}"
                                        BorderBrush="{StaticResource VaultLine}"
                                        BorderThickness="0,0,0,1" Padding="13,10"
                                        Margin="1,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="185"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="67" Height="90" CornerRadius="7"
                                                ClipToBounds="True" Background="{StaticResource VaultPanel}"
                                                BorderBrush="{StaticResource VaultAccentBorder}" BorderThickness="1">
                                            <local:NativeCardArtImage ArtUrl="{Binding ArtworkUrl}"
                                                Width="67" Height="90" Stretch="UniformToFill"
                                                ToolTip="Representative catalog artwork; does not establish owned printing or Arena card style"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="11,0,10,0">
                                            <TextBlock Text="{Binding CardName}" FontSize="15"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource VaultText}"/>
                                            <TextBlock Text="{Binding DisplayCollectorNumber}"
                                                       Foreground="{StaticResource VaultMuted}"
                                                       FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Ownership}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource VaultAccent}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0"
                   Foreground="#B7C9D8" TextWrapping="Wrap"
                   Text="The viewer never changes collection data. Verified set totals are not completion percentages."/>
    </Grid>
</UserControl>
