<UserControl x:Class="ArcaneVault.Next.Desktop.NativeCollectionWorkspace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcaneVault.Next.Desktop"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Grid Margin="14,15,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource VaultEyebrow}"
                           Text="YOUR VAULT" Margin="0,0,0,6"/>
                <TextBlock Text="Collection &amp; Deck Library"
                           FontSize="29" FontWeight="Bold"/>
                <TextBlock x:Name="DataSourceLabel"
                           Style="{StaticResource VaultMutedText}"
                           Text="Read-only exported backup preview — not an import"
                           Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                        HorizontalAlignment="Right">
                <Border Background="{DynamicResource VaultHeroWash}"
                        BorderBrush="{DynamicResource VaultEdgeLift}"
                        BorderThickness="1" CornerRadius="18"
                        HorizontalAlignment="Right"
                        Padding="12,7" Margin="0,5,0,7">
                    <TextBlock Text="✦  ARCANE VAULT"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource VaultAccent}"/>
                </Border>
                <Button x:Name="ClearInventoryButton"
                        Content="Clear inventory…"
                        Click="OnClearInventoryClicked" IsEnabled="False"
                        HorizontalAlignment="Right"
                        Padding="10,6"
                        Style="{StaticResource VaultDangerButton}"
                        ToolTip="Clear Physical, Arena or both using confirmation and a complete native recovery file; saved decks stay untouched."/>
            </StackPanel>
        </Grid>

        <!-- Summary tiles mirror the original dashboard stats, but only
             show verified live/native data instead of guessed ownership. -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="13"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource VaultElevatedPanel}">
                <StackPanel>
                    <TextBlock Text="OWNED INVENTORY"
                               Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TotalsText"
                               Foreground="{DynamicResource VaultText}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource VaultElevatedPanel}">
                <StackPanel>
                    <TextBlock Text="PRINTING VERIFICATION"
                               Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="VerificationText"
                               Foreground="{DynamicResource VaultGood}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource VaultElevatedPanel}"
                Padding="13,11" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="MissingOnly"
                              Content="Unresolved printings only"
                              Margin="0,0,16,0"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                    <Button Content="Card details" Click="OnDetailsClicked"
                            Style="{StaticResource VaultPrimaryButton}"
                            Padding="17,9"/>
                </StackPanel>
                <TextBox x:Name="SearchBox"
                         ToolTip="Filter card names, set hints, collector numbers and verification"
                         TextChanged="OnFilterChanged"
                         Padding="11,9" FontSize="14"
                         Background="{DynamicResource VaultPanelRaised}"
                         Foreground="{DynamicResource VaultText}"
                         BorderBrush="{DynamicResource VaultLine}"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="3" x:Name="CollectionTabs"
                    Background="{DynamicResource VaultPanel}" Foreground="{DynamicResource VaultText}" BorderBrush="{DynamicResource VaultEdgeLift}">
            <TabItem Header="Physical Collection">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,4,0,12">
                        <Button x:Name="AddPhysicalButton" Content="＋  Add physical printing"
                                Click="OnAddPhysicalClicked" IsEnabled="False"
                                Style="{StaticResource VaultPrimaryButton}"
                                Padding="14,9" Margin="0,0,10,0"/>
                        <Button x:Name="AdjustPhysicalButton" Content="Edit selected quantity"
                                Click="OnAdjustPhysicalClicked" IsEnabled="False"
                                Style="{StaticResource VaultDangerButton}"
                                Padding="14,9" Margin="0,0,12,0"/>
                        <Button x:Name="ImportExcelButton" Content="Import CSV / Excel"
                                Click="OnImportExcelClicked" IsEnabled="False"
                                Style="{StaticResource VaultPrimaryButton}"
                                ToolTip="Review printing-specific quantity changes before applying. Cards absent from the file remain owned; use Clear inventory first for a complete replacement."
                                Padding="14,9" Margin="0,0,12,0"/>
                        <ComboBox x:Name="PhysicalViewMode" SelectedIndex="0"
                                  SelectionChanged="OnPhysicalViewModeChanged"
                                  MinWidth="128" Height="36" Padding="6,4"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  Foreground="{DynamicResource VaultText}"
                                  ToolTip="Switch physical inventory between detailed and compact columns">
                            <ComboBoxItem Content="Detailed"/>
                            <ComboBoxItem Content="Compact"/>
                        </ComboBox>
                        <TextBlock Text="Exact print/finish values • missing quotes are not $0"
                                   Style="{StaticResource VaultMutedText}"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock x:Name="PhysicalValuationSummary" FontWeight="SemiBold"
                                   FontSize="15" Foreground="{DynamicResource VaultText}"
                                   TextWrapping="Wrap"
                                   Text="Valuation not calculated yet."/>
                        <TextBlock x:Name="PhysicalValuationTimestamp" Margin="0,4,0,0"
                                   Foreground="{DynamicResource VaultMuted}"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Text="Prices are indicative USD estimates from the official cached Scryfall bulk snapshot."/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="SORT PHYSICAL" Style="{StaticResource VaultEyebrow}"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PhysicalPriceSort" SelectedIndex="0"
                                  SelectionChanged="OnPhysicalSortChanged"
                                  Width="190" Height="32" Margin="0,0,13,0"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  Foreground="{DynamicResource VaultText}">
                            <ComboBoxItem Content="Original inventory order"/>
                            <ComboBoxItem Content="Unit price: high to low"/>
                            <ComboBoxItem Content="Unit price: low to high"/>
                            <ComboBoxItem Content="Line value: high to low"/>
                            <ComboBoxItem Content="Line value: low to high"/>
                        </ComboBox>
                        <Button x:Name="RecalculatePricesButton"
                                Content="Recalculate cached prices"
                                Click="OnRecalculatePricesClicked"
                                Padding="12,7" Margin="0,0,12,0"
                                Background="{DynamicResource VaultPanelRaised}"
                                Foreground="{DynamicResource VaultText}"
                                BorderBrush="{DynamicResource VaultLine}"/>
                        <TextBlock Text="For new quotes, run Full Scryfall Sync in the main window"
                                   Foreground="{DynamicResource VaultMuted}"
                                   VerticalAlignment="Center" FontSize="11"/>
                    </WrapPanel>
                <ListView Grid.Row="3" x:Name="PhysicalList" MouseDoubleClick="OnCardRowDoubleClick"
                          Background="{DynamicResource VaultPanel}" Foreground="{DynamicResource VaultText}"
                          AlternationCount="2"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="{DynamicResource VaultPanel}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource VaultNavHoverWash}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource VaultEdgeLift}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource VaultAccentSurface}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Card / Printing" Width="285">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3,3,0,3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource VaultText}"/>
                                            <TextBlock Text="{Binding SetAndNumber}" FontSize="11"
                                                       Foreground="{DynamicResource VaultMuted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Owned" Width="67">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource VaultAccentSurface}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                BorderThickness="1" CornerRadius="9" Padding="8,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity}" FontWeight="Bold"
                                                       Foreground="{DynamicResource VaultAccent}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Set / #" Width="135" DisplayMemberBinding="{Binding SetAndNumber}"/>
                            <GridViewColumn Header="Finish" Width="95" DisplayMemberBinding="{Binding Finish}"/>
                            <GridViewColumn Header="Unit USD" Width="105" DisplayMemberBinding="{Binding UnitLabel}"/>
                            <GridViewColumn Header="Line USD" Width="105" DisplayMemberBinding="{Binding LineLabel}"/>
                            <GridViewColumn Header="Price status" Width="260" DisplayMemberBinding="{Binding PriceStatus}"/>
                            <GridViewColumn Header="Printing verification" Width="260" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Arena Collection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                Margin="8,9,8,9">
                        <Button x:Name="AddArenaButton" Content="Add Arena card"
                                Click="OnAddArenaClicked" IsEnabled="False"
                                Padding="14,8" Margin="0,0,12,0"
                                Background="{DynamicResource VaultAccentMuted}" Foreground="White"
                                BorderBrush="{DynamicResource VaultAccent}"/>
                        <Button x:Name="EditArenaButton" Content="Edit / remove selected Arena card"
                                Click="OnEditArenaClicked" IsEnabled="False"
                                Padding="14,8" Background="#382438"
                                Foreground="White" BorderBrush="#79516C"/>
                        <Button x:Name="ImportArenaButton" Content="Import CSV / Excel"
                                Click="OnImportArenaClicked" IsEnabled="False"
                                Padding="14,8" Margin="12,0,0,0"
                                Background="{DynamicResource VaultPanelRaised}"
                                Foreground="{DynamicResource VaultText}"
                                BorderBrush="{DynamicResource VaultAccentBorder}"/>
                        <TextBlock VerticalAlignment="Center" Margin="17,0,0,0"
                                   Foreground="{DynamicResource VaultMuted}" Text="Arena is name-only; no printing ID required."/>
                    </StackPanel>
                <ListView Grid.Row="1" x:Name="ArenaList" MouseDoubleClick="OnCardRowDoubleClick"
                          Background="{DynamicResource VaultPanel}" Foreground="{DynamicResource VaultText}"
                          AlternationCount="2"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="9,7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="#111923"/>
                            <Setter Property="BorderBrush" Value="#28394B"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#1B2532"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#35485A"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccentBorder}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Arena Card" Width="470">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource VaultText}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Owned" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource VaultAccentSurface}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}" BorderThickness="1"
                                                CornerRadius="9" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Quantity}" FontWeight="Bold"
                                                       Foreground="{DynamicResource VaultAccent}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Deck Library">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button x:Name="AddDeckButton" Content="New deck"
                                Click="OnAddDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{DynamicResource VaultAccentMuted}" Foreground="White"
                                BorderBrush="{DynamicResource VaultAccent}"/>
                        <Button x:Name="EditDeckButton" Content="Edit selected deck"
                                Click="OnEditDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{DynamicResource VaultPanelRaised}" Foreground="White"
                                BorderBrush="#65778B"/>
                        <Button x:Name="EditDeckInEdhLabButton" Content="Edit in EDH Lab"
                                Click="OnEditDeckInEdhLabClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{DynamicResource VaultAccentMuted}"
                                Foreground="{DynamicResource VaultText}"
                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                ToolTip="Open a saved Commander or Arena Brawl deck with the EDH Lab blueprint and eligible collection suggestions; requires locally verified commander metadata"/>
                        <Button x:Name="DuplicateDeckButton" Content="Duplicate selected deck"
                                Click="OnDuplicateDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{DynamicResource VaultPanelRaised}" Foreground="White"
                                BorderBrush="#65778B"/>
                        <Button x:Name="DeleteDeckButton" Content="Delete selected deck"
                                Click="OnDeleteDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="#382438" Foreground="White"
                                BorderBrush="#79516C"/>
                        <TextBox x:Name="DeckSearchBox" Width="160" Height="35"
                                 ToolTip="Search saved deck names, commanders and folders"
                                 TextChanged="OnDeckFilterChanged"
                                 Background="{DynamicResource VaultPanelRaised}"
                                 Foreground="{DynamicResource VaultText}" Padding="8,6"
                                 Margin="4,0,10,0"/>
                        <CheckBox x:Name="FavoriteDecksOnly" Content="★ Favorites"
                                  Foreground="{DynamicResource VaultText}"
                                  VerticalAlignment="Center"
                                  Checked="OnDeckFilterChanged"
                                  Unchecked="OnDeckFilterChanged"
                                  Margin="0,0,10,0"/>
                    </WrapPanel>
                    <Grid Grid.Row="1" MinHeight="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListView Grid.Column="0" x:Name="DeckLibraryList"
                              SelectionChanged="OnDeckSelected"
                              Background="{DynamicResource VaultPanel}"
                              Foreground="{DynamicResource VaultText}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource VaultEdgeLift}"
                                        BorderThickness="1" CornerRadius="12"
                                        Background="{DynamicResource VaultTileWash}"
                                        Margin="5,5" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="114"/>
                                            <ColumnDefinition Width="13"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="156"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Fallback deck-box cover remains visible without local
                                             artwork. Virtualized on-screen covers reuse the bounded
                                             Scryfall image cache; no prefetch for off-screen decks. -->
                                        <Border Grid.Column="0" Width="108" Height="145"
                                                CornerRadius="9" ClipToBounds="True"
                                                Background="{DynamicResource VaultHeroWash}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                BorderThickness="1">
                                            <Grid ClipToBounds="True" Background="{DynamicResource VaultHeroWash}">
                                                <Border Width="7" HorizontalAlignment="Left" Background="#A9E38B54"/>
                                                <Ellipse Width="94" Height="94" Margin="20,-30,-28,0"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                                         Fill="{DynamicResource VaultAccentSurface}"
                                                         Stroke="{DynamicResource VaultEdgeLift}" StrokeThickness="2"/>
                                                <Ellipse Width="64" Height="64" Margin="0,0,0,10"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Stroke="{DynamicResource VaultAccent}" StrokeThickness="2"/>
                                                <TextBlock Text="✦" FontSize="35" FontWeight="Bold"
                                                           Foreground="{DynamicResource VaultAccent}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <local:NativeCardArtImage
                                                    ArtUrl="{Binding CoverArtworkUrl}" DecodeWidth="260"
                                                    Stretch="UniformToFill"
                                                    ToolTip="Illustrative commander artwork from the local Scryfall catalog; not proof of an owned printing"/>
                                                <Border Height="27" VerticalAlignment="Bottom" Background="#D80C1623">
                                                    <TextBlock Text="{Binding Format}" FontSize="10"
                                                               FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FavoriteLabel}"
                                                           Foreground="{DynamicResource VaultWarning}"
                                                           FontSize="12" Margin="0,1,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource VaultText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Commander}"
                                                       FontSize="12" Foreground="{DynamicResource VaultMuted}"
                                                       Margin="0,7,0,8"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel>
                                                <Border Background="{DynamicResource VaultAccentSurface}"
                                                        BorderBrush="{DynamicResource VaultAccentBorder}"
                                                        BorderThickness="1" CornerRadius="11"
                                                        Padding="9,4" Margin="0,0,9,0">
                                                    <TextBlock Text="{Binding Format}"
                                                               Foreground="{DynamicResource VaultAccent}"
                                                               FontSize="11"/>
                                                </Border>
                                                <Border Background="{DynamicResource VaultPanelRaised}" CornerRadius="11"
                                                        Padding="9,4">
                                                    <TextBlock Text="{Binding Folder}" FontSize="11"
                                                               Foreground="{DynamicResource VaultMuted}"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="3" Margin="12,4,0,4"
                                              VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding TotalCopies}" FontSize="21"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource VaultText}"/>
                                                <TextBlock Text=" copies" FontSize="11"
                                                           Margin="5,8,0,0" Foreground="{DynamicResource VaultMuted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource VaultMuted}" FontSize="11"
                                                       Text="{Binding EntryCount, StringFormat={}{0} unique names}"/>
                                            <TextBlock Grid.Row="2" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource VaultWarning}" FontSize="11"
                                                       Text="{Binding Revisions, StringFormat={}{0} saved revisions}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                        <Border x:Name="DeckInspectorPanel" Grid.Column="1"
                                Width="332" Visibility="Collapsed"
                                Margin="10,0,0,0" Padding="12" CornerRadius="12"
                                Background="{DynamicResource VaultTileWash}"
                                BorderBrush="{DynamicResource VaultEdgeLift}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,9">
                                    <Button DockPanel.Dock="Right" Content="×"
                                            Width="29" Height="29" FontSize="18"
                                            Padding="0" Click="OnHideDeckInspectorClicked"
                                            Background="{DynamicResource VaultPanelRaised}"
                                            Foreground="{DynamicResource VaultText}"
                                            ToolTip="Hide saved-deck inspector"/>
                                    <StackPanel>
                                        <TextBlock Text="SAVED DECK INSPECTOR"
                                                   Style="{StaticResource VaultEyebrow}"/>
                                        <TextBlock x:Name="DeckInspectorTitle"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource VaultText}"
                                                   TextWrapping="Wrap" Margin="0,5,5,0"
                                                   MaxHeight="54"/>
                                        <TextBlock x:Name="DeckInspectorSummary"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource VaultMuted}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <!-- Name-level inventory check: entirely read-only. -->
                                        <TextBlock Text="RECORDED COLLECTION COVERAGE"
                                                   Style="{StaticResource VaultEyebrow}"
                                                   Margin="0,2,0,6"/>
                                        <ComboBox x:Name="DeckInspectorOwnershipPool"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnDeckInspectorOwnershipPoolChanged"
                                                  Background="{DynamicResource VaultPanelRaised}"
                                                  Foreground="{DynamicResource VaultText}"
                                                  Margin="0,0,0,6"
                                                  Padding="7,4"
                                                  ToolTip="Compare the saved deck with either Physical or Arena recorded copies. This does not verify exact printings, format legality or card availability for multiple decks.">
                                            <ComboBoxItem Content="Physical collection"/>
                                            <ComboBoxItem Content="Arena collection"/>
                                        </ComboBox>
                                        <TextBlock x:Name="DeckInspectorCoverageSummary"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource VaultText}"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock x:Name="DeckInspectorCoverageGaps"
                                                   FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource VaultMuted}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="MAINBOARD"
                                                   Style="{StaticResource VaultEyebrow}"
                                                   Margin="0,2,0,6"/>
                                        <ListBox x:Name="DeckInspectorCardsList"
                                                 Height="152" MinHeight="70"
                                                 SelectionChanged="OnDeckInspectorCardSelected"
                                                 MouseDoubleClick="OnDeckInspectorCardDoubleClick"
                                                 Background="{DynamicResource VaultPanel}"
                                                 Foreground="{DynamicResource VaultText}"
                                                 BorderBrush="{DynamicResource VaultLine}"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="3,3" LastChildFill="True">
                                                        <TextBlock Text="{Binding Quantity}"
                                                                   Foreground="{DynamicResource VaultAccent}"
                                                                   Width="25" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource VaultText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DeckInspectorCardName"
                                                   FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource VaultText}"
                                                   TextWrapping="Wrap" Margin="0,12,0,8"
                                                   Text="Choose a card to inspect"/>
                                        <TextBlock x:Name="DeckInspectorCardAvailability"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource VaultMuted}"
                                                   Margin="0,0,0,8"/>
                                        <Border Width="158" Height="222" CornerRadius="9"
                                                HorizontalAlignment="Center" ClipToBounds="True"
                                                Background="{DynamicResource VaultPanel}"
                                                BorderBrush="{DynamicResource VaultEdgeLift}"
                                                BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="Artwork not cached"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource VaultMuted}"
                                                           Margin="9"/>
                                                <local:NativeCardArtImage x:Name="DeckInspectorArt"
                                                                          DecodeWidth="310"
                                                                          Width="156" Height="220"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="DeckInspectorCardType"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource VaultText}"
                                                   Margin="0,10,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Text="MANA COST (EXACT)"
                                                   Style="{StaticResource VaultEyebrow}"
                                                   Margin="0,7,0,5"/>
                                        <local:NativeManaStrip x:Name="DeckInspectorManaCost"
                                                               Kind="Cost" SymbolSize="20"
                                                               AutomationProperties.Name="Exact saved deck card mana cost"/>
                                        <ItemsControl x:Name="DeckInspectorColorIdentity">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:NativeManaSymbol Symbol="{Binding Symbol}"
                                                                            Width="24" Height="24"
                                                                            Margin="0,0,4,0"
                                                                            ToolTip="{Binding Name}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="ORACLE TEXT"
                                                   Style="{StaticResource VaultEyebrow}"
                                                   Margin="0,12,0,5"/>
                                        <FlowDocumentScrollViewer x:Name="DeckInspectorOracle"
                                                                  Height="170"
                                                                  IsSelectionEnabled="True"
                                                                  IsToolBarVisible="False"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  Foreground="{DynamicResource VaultText}"
                                                                  AutomationProperties.Name="Saved deck card Oracle rules"/>
                                        <TextBlock x:Name="DeckInspectorStatus"
                                                   FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource VaultMuted}"
                                                   Margin="0,9,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <Button x:Name="ReviewDeckShortagesButton"
                                            Content="Review shortages in EDH Lab"
                                            Click="OnReviewDeckShortagesClicked"
                                            IsEnabled="False" Padding="10,8"
                                            Margin="0,0,0,7"
                                            Background="{DynamicResource VaultAccentMuted}"
                                            Foreground="{DynamicResource VaultText}"
                                            BorderBrush="{DynamicResource VaultAccentBorder}"
                                            ToolTip="Open eligible Commander or Arena Brawl saved deck in the Improve tab, focused on recorded-copy shortages. Does not change collection or deck until Review and save."/>
                                <Button Content="Full card details &amp; printings"
                                        x:Name="DeckInspectorFullDetailsButton"
                                        Click="OnDeckInspectorFullDetailsClicked"
                                        IsEnabled="False" Padding="10,8"
                                        Margin="0,9,0,0"
                                        Background="{DynamicResource VaultAccentSurface}"
                                        Foreground="{DynamicResource VaultText}"
                                        BorderBrush="{DynamicResource VaultAccentBorder}"
                                        ToolTip="Open full read-only details for the selected mainboard card"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" x:Name="DeckLibraryStatus"
                               Foreground="{DynamicResource VaultMuted}" TextWrapping="Wrap"
                               Margin="0,11,0,0"
                               Text="Saved decks are distinct from ownership. Format legality is not yet validated."/>
                </Grid>
            </TabItem>
            <TabItem Header="Set Progress">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="SetBrowseRow" Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="SetChecklistRow" Height="0"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,9">
                        <TextBlock Text="COLLECTION" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource VaultMuted}"/>
                        <ComboBox x:Name="SetScopeBox" Width="230" Height="38"
                                  SelectedIndex="0" SelectionChanged="OnSetScopeChanged"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  Foreground="{DynamicResource VaultText}"
                                  Margin="0,0,18,0"
                                  ToolTip="Physical tracks verified printing slots; Arena tracks card-name availability only">
                            <ComboBoxItem Content="Physical · verified printings"/>
                            <ComboBoxItem Content="Arena · card-name coverage"/>
                        </ComboBox>
                        <TextBlock x:Name="FindSetLabel" Text="Find a set" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SetSearch" Width="220" Padding="8,5"
                                 Background="{DynamicResource VaultPanelRaised}" Foreground="White" BorderBrush="{DynamicResource VaultLine}"
                                 TextChanged="OnSetFilterChanged" Margin="0,0,18,0"/>
                        <CheckBox x:Name="ShowEmptySets" Content="Include sets with no progress"
                                  IsChecked="False" VerticalAlignment="Center"
                                  Checked="OnSetFilterChanged" Unchecked="OnSetFilterChanged"/>
                    </WrapPanel>
                    <ListView Grid.Row="1" x:Name="SetSummaryList"
                              SizeChanged="OnSetSummarySizeChanged"
                              Background="{DynamicResource VaultPanel}"
                              Foreground="{DynamicResource VaultText}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                <Border MouseLeftButtonDown="OnSetTileClicked" Cursor="Hand"
                                        ToolTip="Open the selected set and browse its cards"
                                        Background="{DynamicResource VaultPanelRaised}"
                                        BorderBrush="{DynamicResource VaultAccentBorder}"
                                        BorderThickness="1" CornerRadius="12"
                                        Height="196" Margin="6,6" ClipToBounds="True">
                                    <Grid x:Name="SetBannerSurface" ClipToBounds="True">
                                        <!-- ImageBrush paints the fixed-size tile background without
                                             affecting measure/arrange. UniformToFill crops the image at
                                             the tile edges instead of resizing the tile or adding bars. -->
                                        <Grid.Background>
                                            <ImageBrush ImageSource="{Binding Source, ElementName=SetBannerImage}"
                                                        Stretch="UniformToFill" AlignmentX="Center"
                                                        AlignmentY="Center" Opacity="0.9"/>
                                        </Grid.Background>
                                        <!-- Zero-size loader keeps the existing bounded Scryfall image
                                             cache, cancellation and decode path; only the brush paints. -->
                                        <local:NativeCardArtImage x:Name="SetBannerImage"
                                            ArtUrl="{Binding BannerArtworkUrl}" DecodeWidth="600"
                                            Width="0" Height="0" Opacity="0"
                                            IsHitTestVisible="False"/>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#AA101521" Offset="0"/>
                                                    <GradientStop Color="#30101520" Offset="0.35"/>
                                                    <GradientStop Color="#F5101523" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid Margin="15,12,15,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="54" Height="54" CornerRadius="9"
                                                        BorderBrush="#80FFFFFF" BorderThickness="1"
                                                        Background="#C0202532" Padding="8"
                                                        ToolTip="Official set symbol (cached locally from Scryfall)">
                                                    <local:NativeSetSymbol SetCode="{Binding SetCode}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplaySetCode}"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           FontWeight="Bold" Margin="10,0,0,0"
                                                           Foreground="White"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PercentLabel}"
                                                           FontSize="23" FontWeight="Bold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding SetName}" FontSize="17"
                                                           FontWeight="Bold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Grid Margin="0,4,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Released}" FontSize="11"
                                                               Foreground="#E0E8EF"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CopiesLabel}"
                                                               FontSize="11" Foreground="#E0E8EF"/>
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Height="7"
                                                             Value="{Binding Percent, Mode=OneWay}"
                                                             Background="#7A111827"
                                                             Foreground="{DynamicResource VaultAccent}"/>
                                                <TextBlock Text="{Binding SlotsLabel}" FontSize="11"
                                                           Foreground="White" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid x:Name="SetDetailsControls" Grid.Row="2"
                          Visibility="Collapsed" Margin="0,14,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button x:Name="BackToSetsButton" Content="← All sets"
                                    Click="OnBackToSetsClicked" Padding="13,7"
                                    Margin="0,0,17,0" Background="{DynamicResource VaultPanelRaised}"
                                    Foreground="{DynamicResource VaultText}"
                                    BorderBrush="{DynamicResource VaultAccentBorder}"/>
                            <CheckBox x:Name="HideUnownedSetSlots" Content="Hide unowned cards / printings"
                                      VerticalAlignment="Center"
                                      Checked="OnSetOwnedFilterChanged"
                                      Unchecked="OnSetOwnedFilterChanged"
                                      Foreground="{DynamicResource VaultText}"
                                      ToolTip="In Physical view: only verified owned collector slots. In Arena view: only owned card names."/>
                        </WrapPanel>
                        <TextBlock x:Name="SetDetailsHeader" Grid.Row="1"
                                   Foreground="{DynamicResource VaultMuted}"
                                   TextWrapping="Wrap"
                                   Text="Select a set to inspect its card checklist."/>
                    </Grid>
                    <ListView Grid.Row="3" x:Name="SetSlotsList"
                              Visibility="Collapsed"
                              MouseDoubleClick="OnCardRowDoubleClick"
                              Background="{DynamicResource VaultPanel}" Foreground="{DynamicResource VaultText}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource VaultPanelRaised}"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="0,0,0,1" Padding="13,10"
                                        Margin="1,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="185"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="67" Height="90" CornerRadius="7"
                                                ClipToBounds="True" Background="{DynamicResource VaultPanel}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}" BorderThickness="1">
                                            <local:NativeCardArtImage ArtUrl="{Binding ArtworkUrl}"
                                                Width="67" Height="90" Stretch="UniformToFill"
                                                ToolTip="Representative catalog artwork; does not establish owned printing or Arena card style"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="11,0,10,0">
                                            <TextBlock Text="{Binding CardName}" FontSize="15"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource VaultText}"/>
                                            <TextBlock Text="{Binding DisplayCollectorNumber}"
                                                       Foreground="{DynamicResource VaultMuted}"
                                                       FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Ownership}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource VaultAccent}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>
            <!-- This is NOT physical ownership. No Scryfall printing identity,
                 price lookup, collection valuation or set-progress credit. -->
            <TabItem Header="Proxies · no value">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap"
                               Margin="0,0,0,12" FontSize="12"
                               Foreground="{DynamicResource VaultMuted}"
                               Text="Record third-party / proxy cards separately from owned Magic printings. Proxies may be used in paper decks, but are excluded entirely from collection value, physical ownership, printing progress and Scryfall price lookup."/>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="CARD NAME" FontSize="10"
                                       Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProxyNameBox" Width="270" MaxLength="255"
                                     Padding="9,8" Background="{DynamicResource VaultPanel}"
                                     Foreground="{DynamicResource VaultText}"
                                     BorderBrush="{DynamicResource VaultEdgeLift}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="PROXY COPIES" FontSize="10"
                                       Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProxyQuantityBox" Width="92" Text="1"
                                     MaxLength="6" Padding="9,8"
                                     Background="{DynamicResource VaultPanel}"
                                     Foreground="{DynamicResource VaultText}"
                                     BorderBrush="{DynamicResource VaultEdgeLift}"/>
                        </StackPanel>
                        <Button x:Name="ProxySaveButton" Content="Record / update proxy"
                                Click="OnProxySaveClicked" IsEnabled="False"
                                Padding="12,8" Margin="0,16,8,0"
                                Style="{StaticResource VaultPrimaryButton}"/>
                        <Button x:Name="ProxyRemoveButton" Content="Remove selected proxy"
                                Click="OnProxyRemoveClicked" IsEnabled="False"
                                Padding="12,8" Margin="0,16,0,0"
                                Style="{StaticResource VaultDangerButton}"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="2" x:Name="ProxyStatusText"
                               Text="Proxy inventory is loading…" FontSize="12"
                               Foreground="{DynamicResource VaultAccent}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ListView Grid.Row="3" x:Name="ProxyList"
                              SelectionChanged="OnProxySelected"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              Background="{DynamicResource VaultPanelRaised}"
                              Foreground="{DynamicResource VaultText}"
                              BorderBrush="{DynamicResource VaultEdgeLift}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Card / proxy name" Width="290"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Copies" Width="100"
                                                DisplayMemberBinding="{Binding Quantity}"/>
                                <GridViewColumn Header="Inventory type" Width="110"
                                                DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="Collection valuation" Width="230"
                                                DisplayMemberBinding="{Binding Valuation}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0"
                   Foreground="#B7C9D8" TextWrapping="Wrap"
                   Text="The viewer never changes collection data. Verified set totals are not completion percentages."/>
    </Grid>
</UserControl>
