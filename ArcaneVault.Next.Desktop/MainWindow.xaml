<Window x:Class="ArcaneVault.Next.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcaneVault.Next.Desktop"
        Title="Arcane Vault" Icon="/ArcaneVault.Next.Desktop;component/Assets/ArcaneVault.ico"
        Width="1330" Height="850"
        MinWidth="965" MinHeight="655"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Window.Resources>
        <Style x:Key="VaultColorToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinWidth" Value="41"/>
            <Setter Property="Height" Value="37"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,7,6"/>
            <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleChrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background"
                                        Value="{DynamicResource VaultAccentSurface}"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                                <Setter TargetName="ToggleChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Catalog pages render at most 200 local results at a time; never
             launch remote art requests during list scrolling. -->
        <DataTemplate x:Key="CatalogCompactTemplate">
            <Grid Margin="5,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="9,3" Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontSize="12"
                               Foreground="{DynamicResource VaultText}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding OwnershipLabel}" FontSize="10"
                               Foreground="{DynamicResource VaultAccent}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RolesLabel}" FontSize="10"
                               Foreground="{DynamicResource VaultGood}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DisplaySetCode}" FontSize="11"
                           Margin="5,5" Foreground="{DynamicResource VaultAccent}"/>
                <TextBlock Grid.Column="2" Text="{Binding DisplayCollectorNumber}" FontSize="11"
                           Margin="5,5" Foreground="{DynamicResource VaultMuted}"/>
            </Grid>
        </DataTemplate>
        <!-- Card art tiles read as physical objects, but use a shadow ONLY
             while hovered (off-screen tiles never instantiate image controls). -->
        <Style x:Key="VaultCatalogTileStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource VaultTileWash}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultEdgeLift}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VaultAccentSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
                    <Setter Property="Effect" Value="{StaticResource VaultPanelShadow}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Each card widget stays exactly 218 DIPs wide; only the number
             of columns changes when the viewport grows or shrinks.
             The outer ListView virtualizes rows, so off-screen artwork never loads. -->
        <!-- Card-first density: the artwork now occupies most of each cell.
             All images are still hosted inside virtualized catalog ROWS. -->
        <DataTemplate x:Key="CatalogTileRowTemplate">
            <ItemsControl ItemsSource="{Binding Cards}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3,4" Padding="5"
                                Width="218" HorizontalAlignment="Center"
                                Height="366" Style="{StaticResource VaultCatalogTileStyle}"
                                Tag="{Binding}"
                                PreviewMouseLeftButtonDown="OnCatalogTileMouseDown"
                                ToolTip="Single-click to inspect; double-click for full details and printings">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" HorizontalAlignment="Center"
                                        Width="200" Height="278" CornerRadius="9"
                                        Background="{DynamicResource VaultBackground}"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="1" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <local:NativeCardArtImage ArtUrl="{Binding ImageUrl}"
                                                                  Width="196" Height="274"
                                                                  DecodeWidth="320"/>
                                        <Button x:Name="CardFaceFlip" Content="⟳"
                                                Tag="{Binding}" Width="34" Height="34"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,5,31" Padding="0" FontSize="20" Cursor="Hand"
                                                Click="OnCatalogTileFaceFlipClicked"
                                                Background="#E017202E"
                                                Foreground="{DynamicResource VaultText}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                ToolTip="Tap to show alternate card face">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BackImageUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border VerticalAlignment="Bottom" Height="25"
                                                Background="#DA10151F">
                                            <DockPanel Margin="7,0" LastChildFill="True">
                                                <TextBlock Text="{Binding RarityLabel}"
                                                           DockPanel.Dock="Left"
                                                           FontWeight="Bold" FontSize="10.5"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource VaultMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="uncommon">
                                                                    <Setter Property="Foreground" Value="#C9D1DD"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="rare">
                                                                    <Setter Property="Foreground" Value="#EDC875"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="mythic">
                                                                    <Setter Property="Foreground" Value="#FFAD79"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplaySetCode}"
                                                           FontSize="10" TextAlignment="Right"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="7,0,0,0"/>
                                            </DockPanel>
                                        </Border>
                                        <Button x:Name="CardShortlistStar"
                                                Content="{Binding ShortlistStar}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding ShortlistTooltip}"
                                                Click="OnCatalogShortlistStarClicked"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="33" Height="33" Margin="0,3,3,0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontSize="23" FontWeight="Bold"
                                                Background="#E017202E"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                Foreground="{DynamicResource VaultWarning}"
                                                Cursor="Hand"
                                                ToolTipService.ShowDuration="15000">
                                            <Button.ContentTemplate>
                                                <!-- Glyph metrics have uneven optical bounds;
                                                     center inside the square explicitly instead
                                                     of using the default button text baseline. -->
                                                <DataTemplate>
                                                    <Grid Width="28" Height="28">
                                                        <TextBlock Text="{Binding}" FontFamily="Segoe UI Symbol"
                                                                   FontSize="23" FontWeight="Normal"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   LineStackingStrategy="BlockLineHeight"
                                                                   LineHeight="28">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform X="0" Y="-1.5"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="5,6,5,0">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource VaultText}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding RolesLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource VaultGood}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RolesLabel}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding OwnershipLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource VaultAccent}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="CatalogSmallTileRowTemplate">
            <ItemsControl ItemsSource="{Binding Cards}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3,4" Padding="5"
                                Width="148" HorizontalAlignment="Center"
                                Height="264" Style="{StaticResource VaultCatalogTileStyle}"
                                Tag="{Binding}"
                                PreviewMouseLeftButtonDown="OnCatalogTileMouseDown"
                                ToolTip="Single-click to inspect; double-click for full details and printings">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" HorizontalAlignment="Center"
                                        Width="134" Height="187" CornerRadius="9"
                                        Background="{DynamicResource VaultBackground}"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="1" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <local:NativeCardArtImage ArtUrl="{Binding ImageUrl}"
                                                                  Width="130" Height="183"
                                                                  DecodeWidth="200"/>
                                        <Button Content="⟳"
                                                Tag="{Binding}" Width="25" Height="23"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,3,27" Padding="0" FontSize="15" Cursor="Hand"
                                                Click="OnCatalogTileFaceFlipClicked"
                                                Background="#E017202E"
                                                Foreground="{DynamicResource VaultText}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                ToolTip="Tap to show alternate card face">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BackImageUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border VerticalAlignment="Bottom" Height="25"
                                                Background="#DA10151F">
                                            <DockPanel Margin="7,0" LastChildFill="True">
                                                <TextBlock Text="{Binding RarityLabel}"
                                                           DockPanel.Dock="Left"
                                                           FontWeight="Bold" FontSize="9"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource VaultMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="uncommon">
                                                                    <Setter Property="Foreground" Value="#C9D1DD"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="rare">
                                                                    <Setter Property="Foreground" Value="#EDC875"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="mythic">
                                                                    <Setter Property="Foreground" Value="#FFAD79"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplaySetCode}"
                                                           FontSize="10" TextAlignment="Right"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="7,0,0,0"/>
                                            </DockPanel>
                                        </Border>
                                        <Button x:Name="CardShortlistStar"
                                                Content="{Binding ShortlistStar}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding ShortlistTooltip}"
                                                Click="OnCatalogShortlistStarClicked"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="26" Height="26" Margin="0,3,3,0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontSize="18" FontWeight="Bold"
                                                Background="#E017202E"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                Foreground="{DynamicResource VaultWarning}"
                                                Cursor="Hand"
                                                ToolTipService.ShowDuration="15000">
                                            <Button.ContentTemplate>
                                                <!-- Glyph metrics have uneven optical bounds;
                                                     center inside the square explicitly instead
                                                     of using the default button text baseline. -->
                                                <DataTemplate>
                                                    <Grid Width="24" Height="24">
                                                        <TextBlock Text="{Binding}" FontFamily="Segoe UI Symbol"
                                                                   FontSize="23" FontWeight="Normal"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   LineStackingStrategy="BlockLineHeight"
                                                                   LineHeight="24">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform X="0" Y="-1.5"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="5,6,5,0">
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource VaultText}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding RolesLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource VaultGood}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RolesLabel}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding OwnershipLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource VaultAccent}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="CatalogVirtualPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The original WebView application's compact, grouped left navigation.
             All commands keep their existing event handlers and confirmation flow. -->
        <Border Grid.Column="0" Background="{DynamicResource VaultSidebarWash}"
                BorderBrush="{DynamicResource VaultLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="15,22,15,18">
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource VaultTileWash}"
                        BorderBrush="{DynamicResource VaultEdgeLift}" BorderThickness="1"
                        CornerRadius="14" Padding="13" Margin="2,18,2,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource VaultEyebrow}"
                                   Text="PRIVATE BY DESIGN"/>
                        <TextBlock Style="{StaticResource VaultMutedText}"
                                   Margin="0,7,0,0"
                                   Text="Your inventory, decks, and recovery points are saved locally."/>
                        <Border Margin="0,12,0,0" BorderBrush="{DynamicResource VaultLine}"
                                BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <TextBlock Foreground="{DynamicResource VaultGood}"
                                       FontSize="11" Text="●  LOCAL DATABASE"/>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="3,0,0,28">
                            <Border Width="56" Height="56" CornerRadius="12"
                                    Background="{DynamicResource VaultHeroWash}"
                                    BorderBrush="{DynamicResource VaultEdgeLift}"
                                    BorderThickness="1" Margin="0,0,12,0"
                                    Effect="{StaticResource VaultPanelShadow}">
                                <Image Source="/ArcaneVault.Next.Desktop;component/Assets/ArcaneVaultSidebar.png"
                                       Width="52" Height="52"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="21" FontWeight="Bold">
                                    <Run Text="ARCANE "/><Run Text="VAULT"
                                            Foreground="{DynamicResource VaultAccent}"/>
                                </TextBlock>

                            </StackPanel>
                        </StackPanel>

                        <Border Height="5" CornerRadius="3"
                                Background="{DynamicResource VaultThemeBanner}"
                                Margin="7,-12,7,17"/>
                                                <TextBlock Text="DISCOVER" Style="{StaticResource VaultEyebrow}" Margin="10,14,0,8"/>
                        <Button x:Name="CatalogNavigationButton"
                                Tag="M4,4 L20,4 L20,20 L4,20 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="Card Catalog"
                                Click="OnShowCatalogClicked"
                                Style="{StaticResource VaultNavPrimary}"
                                ToolTip="Browse all Scryfall printings in the main window"
                                Margin="0,0,0,5"/>
                        <Button x:Name="MyShortlistButton"
                                Tag="M12,2 L15,8 L21,9 L16.5,13.5 L18,20 L12,16.7 L6,20 L7.5,13.5 L3,9 L9,8 Z"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="My Shortlist"
                                Click="OnOpenShortlistClicked"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse bookmarked cards in their own workspace"
                                Margin="0,0,0,5"/>
                        <Border BorderBrush="{DynamicResource VaultLine}" BorderThickness="0,1,0,0" Margin="8,9,8,9"/>
                        <TextBlock Text="COLLECTION" Style="{StaticResource VaultEyebrow}" Margin="10,14,0,8"/>
                        <Button x:Name="OpenNativeButton"
                                Tag="M3,6 L18,6 L21,9 L21,20 L3,20 Z M3,11 L21,11 M8,6 L8,11"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="My Collection"
                                Click="OnOpenNativeClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavPrimary}"
                                ToolTip="Browse your physical collection, Arena inventory and Set Progress in the main window"
                                Margin="0,0,0,5"/>
                        <Button x:Name="SetProgressNavigationButton"
                                Tag="M4,4 L20,4 L20,20 L4,20 Z M7,16 L10,13 L13,15 L18,8 M7,8 L11,8"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="Set Progress"
                                Click="OnOpenSetProgressClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse verified owned set progress in the main workspace"
                                Margin="0,0,0,5"/>
                        <Border BorderBrush="{DynamicResource VaultLine}" BorderThickness="0,1,0,0" Margin="8,9,8,9"/>
                        <TextBlock Text="BUILD &amp; PLAY" Style="{StaticResource VaultEyebrow}" Margin="10,14,0,8"/>
                        <Button x:Name="DeckLibraryNavigationButton"
                                Tag="M4,5 L17,3 L20,7 L7,9 Z M4,10 L17,8 L20,12 L7,14 Z M4,15 L17,13 L20,17 L7,19 Z"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="Deck Library"
                                Click="OnOpenDeckLibraryClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse and edit saved decks in the main workspace"
                                Margin="0,0,0,5"/>
                        <Button x:Name="DeckAnalyticsNavigationButton"
                                Tag="M3,20 L3,12 M8,20 L8,7 M13,20 L13,14 M18,20 L18,4 M2,20 L21,20"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="Deck Analytics"
                                Click="OnOpenDeckAnalyticsClicked"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Compare confirmed Arena deck performance and trends"
                                Margin="0,0,0,5"/>
                        <Button x:Name="MatchHistoryNavigationButton"
                                Tag="M5,3 L17,3 L20,6 L20,20 L4,20 L4,5 Z M8,8 L16,8 M8,12 L16,12 M8,16 L12,16"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="Match History"
                                Click="OnOpenMatchHistoryClicked"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Review Arena match results and assign unidentified matches to a saved deck"
                                Margin="0,0,0,5"/>
                        <Button x:Name="EdhLabButton"
                                Tag="M3,5 L10,3 L12,5 L18,3 L21,5 L21,19 L12,21 L3,19 Z M12,5 L12,21"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="EDH Lab"
                                Click="OnEdhLabClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse Commanders or Arena Brawl leaders and build with your collection. Requires a synced Scryfall catalog."
                                Margin="0,0,0,5"/>
                        <Border BorderBrush="{DynamicResource VaultLine}" BorderThickness="0,1,0,0" Margin="8,9,8,9"/>
                        <TextBlock Text="SYSTEM" Style="{StaticResource VaultEyebrow}" Margin="10,14,0,8"/>
                        <Button x:Name="DataSyncNavigationButton"
                                Tag="M4,7 L18,7 M14,3 L18,7 L14,11 M20,17 L6,17 M10,13 L6,17 L10,21"
                                ContentTemplate="{StaticResource VaultBrandedNavContent}"
                                Content="Data &amp; Sync"
                                Click="OnShowDataSyncClicked"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Full-page sync, snapshots, recovery, imports and application updates"
                                Margin="0,0,0,10"/>

                        <Expander x:Name="GeneralOptionsSettings" Header="Options" IsExpanded="False"
                                  Foreground="{DynamicResource VaultText}"
                                  Background="Transparent" Margin="0,0,0,10"
                                  ToolTip="Collection reset and local application settings">
                            <StackPanel Margin="11,9,0,4">
                                <Button Tag="M12,2 L15,7 L21,12 L15,17 L12,22 L9,17 L3,12 L9,7 Z M12,8 L16,12 L12,16 L8,12 Z" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="OpenAppearanceButton"
                                        Content="Appearance &amp; Themes"
                                        Click="OnOpenAppearanceClicked"
                                        Style="{StaticResource VaultNavPrimary}"
                                        ToolTip="Choose a classic or Magic color-identity application palette"
                                        Margin="0,0,0,7"/>
                                <Button x:Name="StartFreshButton"
                                    Content="＋   Start Fresh Collection"
                                    Click="OnStartFreshClicked"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    ToolTip="Start with zero ownership; keep a recovery point if a collection exists"
                                    Margin="0,0,0,5"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Dedicated workspace; the sidebar keeps only one navigation action. -->
        <Grid x:Name="DataSyncWorkspace" Grid.Column="1" Margin="21,15,21,13" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Height="4" CornerRadius="2" MaxWidth="240" HorizontalAlignment="Left"
                        Background="{DynamicResource VaultThemeBanner}" Margin="0,0,0,12"/>
                <TextBlock Text="YOUR DEVICES &amp; DATA" Style="{StaticResource VaultEyebrow}" Margin="0,0,0,7"/>
                <TextBlock Text="Data &amp; Sync" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource VaultText}"/>
                <TextBlock Text="Connect devices, review inventory differences, and protect your collection."
                           Style="{StaticResource VaultMutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="DataSyncDevicesTab" Content="Device Sync" Tag="devices"
                            Click="OnDataSyncSectionClicked" Style="{StaticResource VaultNavPrimary}" Padding="13,9" Margin="0,0,9,7"/>
                    <Button x:Name="DataSyncSnapshotsTab" Content="Snapshots" Tag="snapshots"
                            Click="OnDataSyncSectionClicked" Style="{StaticResource VaultNavButtonDepth}" Padding="13,9" Margin="0,0,9,7"/>
                    <Button x:Name="DataSyncImportsTab" Content="Import &amp; Export" Tag="imports"
                            Click="OnDataSyncSectionClicked" Style="{StaticResource VaultNavButtonDepth}" Padding="13,9" Margin="0,0,9,7"/>
                    <Button x:Name="DataSyncUpdatesTab" Content="Updates" Tag="updates"
                            Click="OnDataSyncSectionClicked" Style="{StaticResource VaultNavButtonDepth}" Padding="13,9" Margin="0,0,9,7"/>
                </WrapPanel>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
<StackPanel x:Name="DataSyncDevicesPanel" Visibility="Visible" MaxWidth="840" HorizontalAlignment="Left">
                <Border Background="{DynamicResource VaultPanelRaised}" BorderBrush="{DynamicResource VaultLine}" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,12,12" MinWidth="260">
                    <StackPanel>
                        <TextBlock Text="DEVICE SYNC" Style="{StaticResource VaultEyebrow}" Foreground="{DynamicResource VaultAccent}" Margin="0,0,0,7"/>
                        <TextBlock Text="Pair Windows and Android on your trusted Wi-Fi. Preview changes and explicitly approve write-back." TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,12"/>
                        <Button x:Name="SharePeerLanButton"
                        Content="📶   Share Sync to Phone (Wi-Fi)"
                        Click="OnSharePeerLanClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Five-minute one-use LAN link; copies the URL for Android to review"/>
                        <Button x:Name="ReceivePeerLanButton"
                        Content="📶   Receive Phone Sync (Wi-Fi)"
                        Click="OnReceivePeerLanClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="One-use LAN address for the phone to upload a peer snapshot for read-only review"/>
                        <Button Tag="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="ReceiveAndApplyPeerLanButton"
                        Content="Receive &amp; Apply Phone Sync (Wi-Fi)"
                        Click="OnReceiveAndApplyPeerLanClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Scan QR with Android Send to PC. Then choose your previous common baseline, review and approve a verified Windows-only merge with rollback."/>
                        <TextBlock Text="USB CABLE SYNC (ADB)" Style="{StaticResource VaultEyebrow}"
                            Foreground="{DynamicResource VaultAccent}" Margin="0,12,0,7"/>
                        <TextBlock Text="Connect one authorized Android phone by USB with debugging enabled. No Wi-Fi or QR code required. The same reviewed peer merge and recovery rules apply."
                            TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,9"/>
                        <Button Tag="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="CreateSharedBaselineUsbButton"
                            Content="First USB Sync / Create Shared Baseline"
                            Click="OnCreateSharedBaselineUsbClicked"
                            Style="{StaticResource VaultNavButtonDepth}" Margin="0,0,0,5"
                            ToolTip="Compare both collections, review differences, synchronize the chosen source, and verify matching checkpoints on both devices"/>
                        <Button Tag="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="SharePeerUsbButton"
                            Content="Share Sync to Phone (USB)"
                            Click="OnSharePeerUsbClicked"
                            Style="{StaticResource VaultNavButtonDepth}" Margin="0,0,0,5"
                            ToolTip="ADB reverse on USB only; launches Arcane Vault on the phone for reviewed Windows-to-Android sync"/>
                        <Button Tag="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="ReceiveAndApplyPeerUsbButton"
                            Content="Receive &amp; Review Phone Sync (USB)"
                            Click="OnReceiveAndApplyPeerUsbClicked"
                            Style="{StaticResource VaultNavButtonDepth}" Margin="0,0,0,5"
                            ToolTip="Receive Android peer snapshot by USB, then review a three-way merge before applying on Windows"/>
                        <Button x:Name="CancelPeerUsbButton"
                            Content="×   Cancel USB Sync Offer"
                            Click="OnCancelPeerUsbClicked"
                            Style="{StaticResource VaultNavButtonDepth}" Margin="0,0,0,8"
                            ToolTip="Close the pending cable offer and remove its ADB reverse mapping"/>
                        <Button x:Name="CancelPeerLanButton"
                        Content="×   Cancel Wi-Fi Sync Offer"
                        Click="OnCancelPeerLanClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Immediately closes any pending peer transfer link"/>
                        <Button Tag="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="ExportPeerSyncButton"
                        Content="Export PC / Android Sync"
                        Click="OnExportPeerSyncClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Export a lossless schema-2 peer snapshot from the verified native workspace; no cloud or overwrite"/>
                        <Button Tag="M12,3 A9,9 0 1 1 11.99,3 M12,7 L12,12 L16,14" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="PreviewPeerSyncButton"
                        Content="Preview Incoming Peer Sync"
                        Click="OnPreviewPeerSyncClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Review individual physical, Arena, deck and artwork differences without changing any data"/>
                        <Button x:Name="ComparePeerBaselineButton"
                        Content="≋   Three-Way Peer Comparison"
                        Click="OnComparePeerBaselineClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Select the incoming peer file and a verified previously shared baseline. Preview independent edits versus real conflicts; no data is written."/>
                        <Button Tag="M4,13 L9,18 L20,6" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="ApplyPeerMergeButton"
                        Content="Review &amp; Apply Peer Changes"
                        Click="OnApplyPeerMergeClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Select a latest peer snapshot and your common baseline; fail closed on conflict or deletions and preserve a verified rollback."/>

                    </StackPanel>
                </Border>
                    </StackPanel>
<StackPanel x:Name="DataSyncSnapshotsPanel" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <Border Background="{DynamicResource VaultPanelRaised}" BorderBrush="{DynamicResource VaultLine}" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,12,12" MinWidth="260">
                    <StackPanel>
                        <TextBlock Text="SNAPSHOTS &amp; RECOVERY" Style="{StaticResource VaultEyebrow}" Foreground="{DynamicResource VaultAccent}" Margin="0,0,0,7"/>
                        <TextBlock Text="Create a verified local snapshot before syncing. Recovery actions require confirmation." TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,12"/>
                        <Button Tag="M12,3 A9,9 0 1 1 11.99,3 M12,7 L12,12 L16,14" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="CreateSyncSnapshotButton"
                        Content="Save Sync Snapshot (One Click)"
                        Click="OnCreateSyncSnapshotClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"
                        ToolTip="Immediately save a verified, timestamped local peer snapshot before Wi-Fi syncing. No file picker and no collection changes. This is not automatically a verified shared-device baseline."/>
                        <Button Tag="M9,5 L4,10 L9,15 M4,10 L14,10 C19,10 21,13 21,18" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="RestoreRecoveryButton"
                        Content="Restore Recovery Point"
                        Click="OnRestoreRecoveryClicked" IsEnabled="False"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"/>

                    </StackPanel>
                </Border>
                    </StackPanel>
<StackPanel x:Name="DataSyncImportsPanel" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <Border Background="{DynamicResource VaultPanelRaised}" BorderBrush="{DynamicResource VaultLine}" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,12,12" MinWidth="260">
                    <StackPanel>
                        <TextBlock Text="IMPORT &amp; EXPORT" Style="{StaticResource VaultEyebrow}" Foreground="{DynamicResource VaultAccent}" Margin="0,0,0,7"/>
                        <TextBlock Text="Move backups and legacy data without silently replacing your collection." TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,12"/>
                        <Button Tag="M12,3 L12,17 M7,12 L12,17 L17,12 M5,21 L19,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="ImportNativeButton"
                        Content="Import Full Backup"
                        Click="OnImportNativeClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"/>
                        <Button Tag="M12,20 L12,5 M7,10 L12,5 L17,10 M5,2 L19,2" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="ExportFullBackupButton"
                        Content="Export Full Backup"
                        Click="OnExportFullBackupClicked" IsEnabled="False"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"/>
                        <Button Tag="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="MigrateLegacyButton"
                        Content="Inspect / Refresh Old Data"
                        Click="OnMigrateLegacyClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        ToolTip="Import or compare against the installed legacy app without altering its data"
                        Margin="0,0,0,5"/>
                        <Button Tag="M12,3 A9,9 0 1 1 11.99,3 M12,7 L12,12 L16,14" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="CollectionBackupButton"
                        Content="Preview External Backup"
                        Click="OnCollectionBackupClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"/>

                    </StackPanel>
                </Border>
                    </StackPanel>
<StackPanel x:Name="DataSyncUpdatesPanel" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <Border Background="{DynamicResource VaultPanelRaised}" BorderBrush="{DynamicResource VaultLine}" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,12,12" MinWidth="260">
                    <StackPanel>
                        <TextBlock Text="APP &amp; CATALOG UPDATES" Style="{StaticResource VaultEyebrow}" Foreground="{DynamicResource VaultAccent}" Margin="0,0,0,7"/>
                        <TextBlock Text="Manage your local Scryfall catalog and install verified native versions." TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,12"/>
                        <Button Tag="M20,12 A8,8 0 1 1 12,4 M12,4 L17,4 L17,9" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="SyncCatalogButton"
                        Content="Sync Scryfall Catalog"
                        Click="OnSyncCatalogClicked"
                        Style="{StaticResource VaultNavPrimary}"
                        ToolTip="Download or refresh official Scryfall bulk printing data"
                        Margin="0,0,0,5"/>
                        <Button x:Name="CancelCatalogButton"
                        Content="×   Cancel Catalog Sync"
                        Click="OnCancelCatalogClicked" IsEnabled="False"
                        Style="{StaticResource VaultDangerButton}"
                        Margin="0,0,0,6"/>
                        <Button Tag="M3,7 L9,7 L11,5 L21,5 L21,19 L3,19 Z M3,9 L21,9" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="OpenCatalogButton"
                        Content="Open Local Catalog"
                        Click="OnOpenCatalogClicked"
                        Style="{StaticResource VaultNavButtonDepth}"
                        ToolTip="Open an existing catalog using a private SQLite snapshot"
                        Margin="0,0,0,5"/>
                        <Button Tag="M12,3 L12,17 M7,12 L12,17 L17,12 M5,21 L19,21" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="SaveNativeCatalogButton"
                        Content="Keep Catalog Natively"
                        Click="OnSaveNativeCatalogClicked" IsEnabled="False"
                        Style="{StaticResource VaultNavButtonDepth}"
                        Margin="0,0,0,5"/>
                        <Button x:Name="SyntheticButton" Visibility="Collapsed"
                        Content="Use synthetic cards"
                        Click="OnSyntheticClicked"
                        Style="{StaticResource VaultNavButtonDepth}"/>
                        <Button x:Name="CheckNativeUpdatesButton"
                        Content="⬆   Check for Updates"
                        Click="OnCheckNativeUpdatesClicked"
                        Style="{StaticResource VaultNavPrimary}"
                        ToolTip="Check verified Arcane Vault releases and safely install the latest version"
                        Margin="0,12,0,5"/>
                        <TextBlock x:Name="NativeVersionLabel"
                        Style="{StaticResource VaultMutedText}"
                        Text="Installed version" Margin="10,2,0,5"/>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="CatalogWorkspace" Grid.Column="1" Margin="21,15,21,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Height="4" CornerRadius="2" MaxWidth="240"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource VaultThemeBanner}"
                            Margin="0,0,0,12"/>
                    <TextBlock Text="THE ARCHIVE" Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,7"/>
                    <TextBlock Text="Card Catalog" FontSize="31"
                               FontWeight="Bold" Foreground="{DynamicResource VaultText}"/>
                    <TextBlock Text="Find cards, explore printings, and manage your own vault."
                               Style="{StaticResource VaultMutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Tag="M12,3 A9,9 0 1 1 11.99,3 M12,7 L12,12 L16,14" ContentTemplate="{StaticResource VaultBrandedNavContent}" x:Name="ActivityHistoryButton" Grid.Column="1"
                        Content="Activity (0)" Click="OnActivityHistoryClicked"
                        FontSize="11" FontWeight="SemiBold"
                        Padding="13,7" Margin="10,6,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource VaultAccentSurface}"
                        BorderBrush="{DynamicResource VaultAccentBorder}"
                        Foreground="{DynamicResource VaultAccent}"
                        ToolTip="View Arcane Vault in-app notification history"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource VaultElevatedPanel}"
                    Margin="0,0,0,12" Padding="16,12">
                <!-- Stable vertical groups: full-width search, wrapping field
                     groups, then color filters and view mode. No fixed right
                     column or uneven WrapPanel vertical alignment. -->
                <StackPanel>
                        <TextBlock Text="SEARCH PRINTINGS"
                                   Style="{StaticResource VaultEyebrow}"
                                   Margin="0,0,0,7"/>
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                                 ToolTip="Search card names or Scryfall Oracle mechanics and rules text (Banding, Connive, Replicate); use Next to browse matching printings"
                                 FontSize="15" Height="44"
                                 Padding="14,7"
                                 Background="{DynamicResource VaultPanelRaised}"
                                 Foreground="{DynamicResource VaultText}"
                                 BorderBrush="{DynamicResource VaultLine}"/>
                        <WrapPanel Margin="0,13,0,7">
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="SET CODE" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="SetFilterBox" Width="90" Height="36"
                                         TextChanged="OnCatalogFilterChanged"
                                         ToolTip="Exact set abbreviation (e.g. MH3, CMM)"
                                         Padding="7,4" Background="{DynamicResource VaultPanelRaised}"
                                         Foreground="{DynamicResource VaultText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="KEYWORD / RULES TEXT" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="OracleFilterBox" Width="235" Height="36"
                                         TextChanged="OnOracleKeywordChanged"
                                         PreviewKeyDown="OnOracleKeywordKeyDown"
                                         ToolTip="Type a mechanic and press Space or Enter to complete; tap suggestions or use commas for custom Oracle phrases. Completed keywords can be removed."
                                         Padding="7,4" Background="{DynamicResource VaultPanelRaised}"
                                         Foreground="{DynamicResource VaultText}"/>
                                <WrapPanel x:Name="OracleTokensPanel" MaxWidth="250" Margin="0,4,0,0"/>
                                <ListBox x:Name="OracleKeywordSuggestions" Width="235" MaxHeight="132"
                                         Visibility="Collapsed"
                                         SelectionChanged="OnOracleSuggestionSelected"
                                         Background="{DynamicResource VaultPanelRaised}"
                                         Foreground="{DynamicResource VaultText}"
                                         BorderBrush="{DynamicResource VaultLine}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="MECHANIC MATCH" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="OracleMatchBox" Width="130" Height="36"
                                          SelectedIndex="0" SelectionChanged="OnCatalogFilterChanged"
                                          ToolTip="Match every comma-separated Oracle phrase, or any one of them."
                                          Background="{DynamicResource VaultPanelRaised}"
                                          Foreground="{DynamicResource VaultText}">
                                    <ComboBoxItem Content="Match All" Tag="all"/>
                                    <ComboBoxItem Content="Match Any" Tag="any"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="RARITY" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="RarityFilterBox" Width="135" Height="36"
                                          SelectedIndex="0"
                                          SelectionChanged="OnCatalogFilterChanged"
                                          Background="{DynamicResource VaultPanelRaised}"
                                          Foreground="{DynamicResource VaultText}">
                                    <ComboBoxItem Content="All rarities" Tag=""/>
                                    <ComboBoxItem Content="Common" Tag="common"/>
                                    <ComboBoxItem Content="Uncommon" Tag="uncommon"/>
                                    <ComboBoxItem Content="Rare" Tag="rare"/>
                                    <ComboBoxItem Content="Mythic" Tag="mythic"/>
                                    <ComboBoxItem Content="Special" Tag="special"/>
                                    <ComboBoxItem Content="Bonus" Tag="bonus"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="UTILIZATION TAG" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="RoleFilterBox" Width="155" Height="36"
                                          SelectedIndex="0"
                                          SelectionChanged="OnCatalogFilterChanged"
                                          ToolTip="Heuristics from cached Scryfall Oracle text; a card can have multiple tags">
                                    <ComboBoxItem Content="All roles" Tag=""/>
                                    <ComboBoxItem Content="Ramp" Tag="Ramp"/>
                                    <ComboBoxItem Content="Removal" Tag="Removal"/>
                                    <ComboBoxItem Content="Board Wipe" Tag="Board Wipe"/>
                                    <ComboBoxItem Content="Discard" Tag="Discard"/>
                                    <ComboBoxItem Content="Counterspell" Tag="Counterspell"/>
                                    <ComboBoxItem Content="Card Draw" Tag="Card Draw"/>
                                    <ComboBoxItem Content="Card Selection" Tag="Card Selection"/>
                                    <ComboBoxItem Content="Lifegain" Tag="Lifegain"/>
                                    <ComboBoxItem Content="Tutor" Tag="Tutor"/>
                                    <ComboBoxItem Content="Stax" Tag="Stax"/>
                                    <ComboBoxItem Content="Haste" Tag="Haste"/>
                                    <ComboBoxItem Content="Protection" Tag="Protection"/>
                                    <ComboBoxItem Content="Recursion" Tag="Recursion"/>
                                    <ComboBoxItem Content="Sacrifice" Tag="Sacrifice"/>
                                    <ComboBoxItem Content="Tokens" Tag="Tokens"/>
                                    <ComboBoxItem Content="Graveyard Hate" Tag="Graveyard Hate"/>
                                    <ComboBoxItem Content="Finisher" Tag="Finisher"/>
                                    <ComboBoxItem Content="Equipment" Tag="Equipment"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="MANA VALUE (MIN–MAX)" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ManaValueMinBox" Width="66" Height="36"
                                             ToolTip="Minimum mana value (CMC), inclusive. Set both fields to the same value for exact."
                                             TextChanged="OnCatalogFilterChanged"
                                             Padding="7,4" Background="{DynamicResource VaultPanelRaised}"
                                             Foreground="{DynamicResource VaultText}"/>
                                    <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"
                                               Foreground="{DynamicResource VaultMuted}"/>
                                    <TextBox x:Name="ManaValueMaxBox" Width="66" Height="36"
                                             ToolTip="Maximum mana value (CMC), inclusive; works with rarity and role filters"
                                             TextChanged="OnCatalogFilterChanged"
                                             Padding="7,4" Background="{DynamicResource VaultPanelRaised}"
                                             Foreground="{DynamicResource VaultText}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="TYPE CONTAINS" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="TypeFilterBox" Width="163" Height="36"
                                         TextChanged="OnCatalogFilterChanged"
                                         ToolTip="Filter oracle card type line: Creature, Enchantment, Wizard, etc."
                                         Padding="7,4" Background="{DynamicResource VaultPanelRaised}"
                                         Foreground="{DynamicResource VaultText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,7">
                                <TextBlock Text="CATALOG SCOPE"
                                           Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <Border Height="36" Padding="6,0"
                                        Background="{DynamicResource VaultPanelRaised}"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="1" CornerRadius="5">
                                    <CheckBox x:Name="ArenaOnlyBox"
                                              Content="Arena catalog (one per card)"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource VaultText}"
                                              Checked="OnCatalogFilterChanged"
                                              Unchecked="OnCatalogFilterChanged"
                                              ToolTip="Show only cards available in MTG Arena, once per card name. This is NOT your owned Arena inventory; use Collection Ownership to filter owned cards."/>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="COLLECTION OWNERSHIP"
                                           Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="OwnershipFilterBox" Width="227" Height="36"
                                          SelectedIndex="1"
                                          SelectionChanged="OnCatalogFilterChanged"
                                          Background="{DynamicResource VaultPanelRaised}"
                                          Foreground="{DynamicResource VaultText}"
                                          ToolTip="Physical requires matching exact printing ID; Arena uses card names">
                                    <ComboBoxItem Content="All printings"/>
                                    <ComboBoxItem Content="Owned physical printing"/>
                                    <ComboBoxItem Content="Physical not verified owned"/>
                                    <ComboBoxItem Content="Owned on Arena (card name)"/>
                                    <ComboBoxItem Content="Not owned on Arena (name)"/>
                                </ComboBox>
                                <CheckBox x:Name="CatalogIncludeProxiesBox"
                                          Content="Include Proxies"
                                          IsEnabled="True" IsChecked="False"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged"
                                          Margin="0,7,0,0"
                                          Foreground="{DynamicResource VaultText}"
                                          ToolTip="With Owned physical printing, also show names recorded as paper proxies. These are not verified owned printings, are shown once per name, and never contribute to prices or collection value."/>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="COLOR IDENTITY" Style="{StaticResource VaultEyebrow}"
                                       VerticalAlignment="Center" Margin="0,0,11,6"/>
                            <ToggleButton x:Name="ColorWBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="White color identity — click to toggle"
                                          AutomationProperties.Name="White color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="W" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorUBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Blue color identity — click to toggle"
                                          AutomationProperties.Name="Blue color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="U" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorBBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Black color identity — click to toggle"
                                          AutomationProperties.Name="Black color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="B" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorRBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Red color identity — click to toggle"
                                          AutomationProperties.Name="Red color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="R" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorGBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Green color identity — click to toggle"
                                          AutomationProperties.Name="Green color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="G" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorlessOnlyBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Colorless identity only — click to toggle"
                                          AutomationProperties.Name="Colorless identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="C" Width="22" Height="22"/>
                            </ToggleButton>
                            <ComboBox x:Name="ColorMatchBox" SelectedIndex="0"
                                      SelectionChanged="OnCatalogFilterChanged"
                                      Width="127" Height="28" Margin="0,0,0,6"
                                      Background="{DynamicResource VaultPanelRaised}"
                                      Foreground="{DynamicResource VaultText}"
                                      ToolTip="Includes all: W+U shows Azorius and more colors; Exact: only WU">
                                <ComboBoxItem Content="Contains all"/>
                                <ComboBoxItem Content="Exact colors"/>
                                <ComboBoxItem Content="Contains any"/>
                            </ComboBox>
                        </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="CATALOG VIEW" Style="{StaticResource VaultEyebrow}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CatalogViewMode" Width="178" SelectedIndex="0"
                                  SelectionChanged="OnCatalogViewModeChanged"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  Foreground="{DynamicResource VaultText}"
                                  Padding="6,4" Height="32"
                                  ToolTip="Choose large card artwork, small card artwork or a text-only list">
                            <ComboBoxItem Content="Big Art"/>
                            <ComboBoxItem Content="Small Art"/>
                            <ComboBoxItem Content="Text Only"/>
                        </ComboBox>
                        <TextBlock Text="CARDS / PAGE" Style="{StaticResource VaultEyebrow}"
                                   VerticalAlignment="Center" Margin="20,0,10,0"/>
                        <ComboBox x:Name="CatalogPageSizeBox" Width="100" Height="32"
                                  SelectedIndex="3" Padding="6,4"
                                  SelectionChanged="OnCatalogPageSizeChanged"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  Foreground="{DynamicResource VaultText}"
                                  ToolTip="Show 25, 50, 100 or 200 cards per page">
                            <ComboBoxItem Content="25" Tag="25"/>
                            <ComboBoxItem Content="50" Tag="50"/>
                            <ComboBoxItem Content="100" Tag="100"/>
                            <ComboBoxItem Content="200" Tag="200"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" MinHeight="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                    Background="{DynamicResource VaultPanel}"
                    BorderBrush="{DynamicResource VaultEdgeLift}"
                    BorderThickness="1" CornerRadius="16"
                    Effect="{StaticResource VaultPanelShadow}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="CatalogColumnHeaders" Grid.Row="0" Background="{DynamicResource VaultPanelRaised}"
                          Height="45">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="126"/>
                            <ColumnDefinition Width="116"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CARD NAME" Grid.Column="0"
                                   Style="{StaticResource VaultEyebrow}"
                                   Foreground="{DynamicResource VaultMuted}"
                                   Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SET" Grid.Column="1"
                                   Style="{StaticResource VaultEyebrow}"
                                   Foreground="{DynamicResource VaultMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="COLLECTOR #" Grid.Column="2"
                                   Style="{StaticResource VaultEyebrow}"
                                   Foreground="{DynamicResource VaultMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ListView Grid.Row="1" x:Name="CardsList"
                              SelectionChanged="OnCatalogRowSelectionChanged"
                              SizeChanged="OnCatalogListSizeChanged"
                              HorizontalContentAlignment="Stretch"
                              MouseDoubleClick="OnCatalogCardRowDoubleClick"
                              Background="{DynamicResource VaultPanel}"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3,2" Padding="12,12"
                                        CornerRadius="8" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource VaultLine}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="126"/>
                                            <ColumnDefinition Width="104"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource VaultText}"/>
                                            <TextBlock Text="{Binding OwnershipLabel}"
                                                       Foreground="{DynamicResource VaultAccent}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RolesLabel}"
                                                       Foreground="{DynamicResource VaultGood}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTip="Derived from Scryfall Oracle text and type"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="11"
                                                HorizontalAlignment="Left"
                                                Padding="10,5"
                                                Background="{DynamicResource VaultAccentSurface}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding DisplaySetCode}" FontSize="11"
                                                       Foreground="{DynamicResource VaultAccent}"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayCollectorNumber}"
                                                   Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource VaultMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" Margin="12,8,12,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="CatalogPageStatus"
                                   Text="No catalog results" VerticalAlignment="Center"
                                   Foreground="{DynamicResource VaultMuted}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0"/>
                        <Button Grid.Column="1" x:Name="PreviousCatalogPageButton"
                                Content="Previous" Click="OnPreviousCatalogPageClicked"
                                IsEnabled="False" Padding="12,6" Margin="0,0,8,0"
                                Background="{DynamicResource VaultPanelRaised}"
                                Foreground="{DynamicResource VaultText}"
                                ToolTip="Show the previous page of matching cards"/>
                        <TextBlock Grid.Column="2" x:Name="CatalogPageLabel"
                                   Text="Page 1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource VaultText}"
                                   FontSize="12" Margin="4,0,12,0"/>
                        <Button Grid.Column="3" x:Name="NextCatalogPageButton"
                                Content="Next" Click="OnNextCatalogPageClicked"
                                IsEnabled="False" Padding="12,6"
                                Background="{DynamicResource VaultPanelRaised}"
                                Foreground="{DynamicResource VaultText}"
                                ToolTip="Show the next page of matching cards"/>
                    </Grid>
                </Grid>
            </Border>

                <!-- Persistent context: choose another catalog card without
                     opening or closing a separate window. Only the inspector
                     requests additional metadata and art for its current card. -->
                <Border x:Name="CardInspectorPanel" Grid.Column="1"
                        Width="342" Visibility="Collapsed"
                        Margin="12,0,0,0" Padding="13"
                        Background="{DynamicResource VaultTileWash}"
                        BorderBrush="{DynamicResource VaultEdgeLift}"
                        BorderThickness="1" CornerRadius="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource VaultEyebrow}"
                                           Text="CARD INSPECTOR"/>
                                <TextBlock x:Name="InspectorName" Text="Select a card"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource VaultText}"
                                           TextWrapping="Wrap" MaxHeight="55"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" FontSize="18" Width="30"
                                    Height="30" Padding="0" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Click="OnInspectorCloseClicked"
                                    Background="{DynamicResource VaultPanelRaised}"
                                    Foreground="{DynamicResource VaultText}"
                                    ToolTip="Hide card inspector; click another card to reopen"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel>
                                <Border x:Name="InspectorArtworkPanel" Width="182" Height="255" CornerRadius="9"
                                        HorizontalAlignment="Center" ClipToBounds="True"
                                        BorderThickness="1" BorderBrush="{DynamicResource VaultEdgeLift}"
                                        Background="{DynamicResource VaultPanel}">
                                    <Grid>
                                        <local:NativeCardArtImage x:Name="InspectorArt" DecodeWidth="350"
                                                                  Width="180" Height="253"/>
                                        <Button x:Name="InspectorFlipButton" Content="⟳"
                                                Visibility="Collapsed"
                                                Width="35" Height="35" FontSize="20"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,5,5" Padding="0" Cursor="Hand"
                                                Click="OnInspectorFlipClicked"
                                                Background="{DynamicResource VaultAccentSurface}"
                                                Foreground="{DynamicResource VaultText}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                BorderThickness="1"
                                                ToolTip="Tap to flip this double-faced card"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="InspectorPrinting" Margin="0,10,0,0"
                                           FontSize="11" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VaultAccent}"/>
                                <TextBlock x:Name="InspectorOwnership" Margin="0,6,0,0"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VaultMuted}"/>
                                <TextBlock x:Name="InspectorType" Margin="0,10,0,0"
                                           FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VaultText}"/>
                                <TextBlock Text="MANA COST (EXACT)"
                                           Style="{StaticResource VaultEyebrow}" Margin="0,10,0,5"/>
                                <local:NativeManaStrip x:Name="InspectorManaCost"
                                                       Kind="Cost" SymbolSize="21"
                                                       AutomationProperties.Name="Exact official catalog card mana cost"/>
                                <TextBlock Text="COLOR IDENTITY" Margin="0,10,0,5"
                                           Style="{StaticResource VaultEyebrow}"/>
                                <ItemsControl x:Name="InspectorIdentityIcons">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:NativeManaSymbol Symbol="{Binding Symbol}"
                                                                    Width="25" Height="25"
                                                                    Margin="0,0,5,0"
                                                                    ToolTip="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="{DynamicResource VaultEdgeLift}"
                                        BorderThickness="0,1,0,0" Margin="0,13,0,8"
                                        Padding="0,10,0,0">
                                    <TextBlock Text="ORACLE TEXT"
                                               Style="{StaticResource VaultEyebrow}"/>
                                </Border>
                                <!-- Native reading surface: no caret, text-box bezel,
                                     or editable-looking input chrome. -->
                                <FlowDocumentScrollViewer x:Name="InspectorOracle"
                                     Height="192"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource VaultText}"
                                     IsToolBarVisible="False" IsSelectionEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Selected card Oracle text with official symbols"/>
                                <TextBlock x:Name="InspectorStatus"
                                           Margin="0,7,0,0" FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource VaultMuted}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="InspectorFullDetailsButton"
                                    Content="Open full details &amp; printings"
                                    Click="OnInspectorFullDetailsClicked"
                                    Padding="10,8"
                                    Background="{DynamicResource VaultAccentSurface}"
                                    Foreground="{DynamicResource VaultText}"
                                    ToolTip="Optional full Card Details window for printings and ownership actions"/>
                            <Button x:Name="InspectorExpandButton"
                                    Content="Widen inspector"
                                    Click="OnInspectorExpandClicked"
                                    Padding="10,6" Margin="0,6,0,0"
                                    Background="{DynamicResource VaultPanelRaised}"
                                    Foreground="{DynamicResource VaultText}"
                                    ToolTip="Expand or restore the in-app inspector width"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Margin="0,14,0,0"
                    BorderBrush="{DynamicResource VaultEdgeLift}"
                    BorderThickness="0,1,0,0" Padding="4,11,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="●  WORKSPACE" Foreground="{DynamicResource VaultGood}"
                               FontWeight="SemiBold" FontSize="11"
                               Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeStatus"
                                   Foreground="{DynamicResource VaultMuted}"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Text="A new vault can start empty, then add physical and Arena cards using the native collection."/>
                        <TextBlock x:Name="FilterStatus" Margin="0,3,0,0"
                                   Foreground="{DynamicResource VaultMuted}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="No catalog loaded"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Embedded native workspace; Collection and Deck Library use the same
             verified data and editor flows as the old popup, without a Window. -->
        <ContentControl x:Name="NativeWorkspaceHost" Grid.Column="1"
                        Margin="10,12,10,12" Visibility="Collapsed"/>
        <!-- Bookmarks occupy the main content workspace, not a popup. -->
        <ContentControl x:Name="ShortlistWorkspaceHost" Grid.Column="1"
                        Margin="10,12,10,12" Visibility="Collapsed"/>
        <!-- Arena match reconciliation is a separate main-window workspace.
             Its corrections only update existing local match-history rows. -->
        <ContentControl x:Name="MatchHistoryWorkspaceHost" Grid.Column="1"
                        Margin="10,12,10,12" Visibility="Collapsed"/>
        <ContentControl x:Name="DeckAnalyticsWorkspaceHost" Grid.Column="1"
                        Margin="10,12,10,12" Visibility="Collapsed"/>

        <!-- Update decisions remain inside Arcane Vault, not Windows dialogs. -->
        <Grid x:Name="NativeUpdatePromptOverlay" Grid.ColumnSpan="2"
              Panel.ZIndex="200" Background="#BE090E18"
              Visibility="Collapsed" Focusable="True">
            <Border Width="510" MaxHeight="450" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14"
                    Background="{DynamicResource VaultPanelRaised}"
                    BorderBrush="{DynamicResource VaultAccentBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NativeUpdatePromptTitle" Grid.Row="0"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource VaultText}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NativeUpdatePromptMessage"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource VaultText}"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="NativeUpdatePromptCancel" Content="Not now"
                                MinWidth="100" Padding="14,9" Margin="0,0,9,0"
                                Click="OnNativeUpdatePromptCancel"
                                Background="{DynamicResource VaultPanel}"
                                Foreground="{DynamicResource VaultText}"/>
                        <Button x:Name="NativeUpdatePromptApprove" Content="Continue"
                                MinWidth="125" Padding="14,9"
                                Click="OnNativeUpdatePromptApprove"
                                Background="{DynamicResource VaultAccentSurface}"
                                Foreground="{DynamicResource VaultText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- EDH commander discovery occupies the same central workspace
             as Card Catalog and Deck Library. No floating browser window. -->
        <Grid x:Name="EdhLabHost" Grid.Column="1"
              Margin="10,12,10,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,6"
                    BorderBrush="{DynamicResource VaultLine}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="EDH LAB" Foreground="{DynamicResource VaultAccent}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               DockPanel.Dock="Left" Margin="4,0,14,0"/>
                    <Button x:Name="EdhShowCommandersButton"
                            Content="Commander browser"
                            Click="OnEdhShowCommandersClicked"
                            Padding="10,5" Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            Background="{DynamicResource VaultPanelRaised}"
                            Foreground="{DynamicResource VaultText}"/>
                    <Button x:Name="EdhReturnToDraftButton"
                            Content="Return to draft"
                            Click="OnEdhReturnToDraftClicked" IsEnabled="False"
                            Padding="10,5" DockPanel.Dock="Left"
                            Background="{DynamicResource VaultPanelRaised}"
                            Foreground="{DynamicResource VaultText}"/>
                </DockPanel>
            </Border>
            <ContentControl x:Name="EdhLabSurface" Grid.Row="1"/>
        </Grid>

        <!-- App-owned, nonmodal notices and short session activity history.
             Empty grid areas do not intercept catalog navigation. -->
        <StackPanel Grid.ColumnSpan="2" Panel.ZIndex="90"
                    Width="395" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,34,18,0">
            <Border x:Name="ActivityHistoryPanel" Visibility="Collapsed"
                    Padding="12" Margin="0,0,0,9" MaxHeight="360"
                    Background="{DynamicResource VaultPanelRaised}"
                    BorderBrush="{DynamicResource VaultEdgeLift}"
                    BorderThickness="1" CornerRadius="13">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Clear history"
                                Click="OnClearActivityClicked"
                                Background="{DynamicResource VaultPanel}"
                                Foreground="{DynamicResource VaultText}"
                                Padding="8,4" Margin="8,0,0,0"/>
                        <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource VaultEyebrow}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="295">
                        <ItemsControl x:Name="ActivityHistoryItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource VaultLine}"
                                            BorderThickness="0,0,0,1" Padding="3,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding TimestampLabel}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="{DynamicResource VaultMuted}"
                                                           FontSize="10"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                           Foreground="{DynamicResource VaultText}"
                                                           FontSize="12"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource VaultMuted}"
                                                       MaxHeight="85"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <ItemsControl x:Name="ActiveNoticeItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,7" Padding="13,10" CornerRadius="12"
                                Background="{DynamicResource VaultPanelRaised}"
                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                BorderThickness="1" Effect="{StaticResource VaultPanelShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource VaultText}"/>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="11.5" TextWrapping="Wrap"
                                               MaxHeight="100"
                                               Foreground="{DynamicResource VaultMuted}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" Width="25" Height="25"
                                        Padding="0" Margin="7,0,0,0"
                                        Tag="{Binding Id}" Click="OnDismissNoticeClicked"
                                        Background="{DynamicResource VaultPanel}"
                                        Foreground="{DynamicResource VaultText}"
                                        ToolTip="Dismiss this in-app notification"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>