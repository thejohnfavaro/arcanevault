<Window x:Class="ArcaneVault.Next.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault Next — Native Workspace" Width="1080" Height="750"
        MinWidth="780" MinHeight="520" Background="#101620" Foreground="#EBF1F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="27" FontWeight="Bold" Text="Arcane Vault Next"/>
            <TextBlock FontSize="13" Foreground="#ADC0D1" Margin="0,4,0,0"
                       Text="Native Windows workspace · One-click import from installed app (no export) · Editing stays locked"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="OpenCatalogButton" Content="Open a read-only catalog snapshot"
                    Click="OnOpenCatalogClicked" Padding="12,9" Margin="0,0,12,0"
                    Background="#283F55" Foreground="White" BorderBrush="#65778B"/>
            <Button x:Name="SyntheticButton" Content="Use 25,000 synthetic cards"
                    Click="OnSyntheticClicked" Padding="12,9"
                    Background="#283F55" Foreground="White" BorderBrush="#65778B" Margin="0,0,12,0"/>
            <Button x:Name="SaveNativeCatalogButton" Content="Keep catalog natively"
                    Click="OnSaveNativeCatalogClicked" Padding="12,9" Margin="0,0,12,0"
                    IsEnabled="False" Background="#283F55" Foreground="White" BorderBrush="#65778B"/>
            <Button x:Name="MigrateLegacyButton" Content="Inspect / migrate installed data"
                    Click="OnMigrateLegacyClicked" Padding="12,9" Margin="0,0,12,0"
                    Background="#9A4E2D" Foreground="White" BorderBrush="#B97650"/>
            <Button x:Name="ImportNativeButton" Content="Import backup once"
                    Click="OnImportNativeClicked" Padding="12,9" Margin="0,0,12,0"
                    Background="#9A4E2D" Foreground="White" BorderBrush="#B97650"/>
            <Button x:Name="OpenNativeButton" Content="Open native collection"
                    Click="OnOpenNativeClicked" Padding="12,9" Margin="0,0,12,0"
                    IsEnabled="False" Background="#283F55" Foreground="White" BorderBrush="#65778B"/>
            <Button x:Name="CollectionBackupButton" Content="Preview external backup"
                    Click="OnCollectionBackupClicked" Padding="12,9" Margin="0,0,12,0"
                    Background="#283F55" Foreground="White" BorderBrush="#65778B"/>
            <!-- EDH Lab feature preserved but hidden until Windows core parity passes. -->
            <Button x:Name="EdhLabButton" Content="EDH Lab — Commanders"
                    Click="OnEdhLabClicked" Visibility="Collapsed" Padding="12,9" IsEnabled="False"
                    Background="#9A4E2D" Foreground="White" BorderBrush="#B97650"/>
        </WrapPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" x:Name="FilterStatus" TextAlignment="Right"
                       Width="340" VerticalAlignment="Center" Foreground="#B5CCD7"
                       Text="25,000 synthetic rows"/>
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                     ToolTip="Catalog mode performs bounded name-prefix searches, max 200 printings"
                     Padding="12,9" FontSize="15" Background="#202C3B" Foreground="White"
                     BorderBrush="#516174"/>
        </DockPanel>
        <ListView Grid.Row="3" x:Name="CardsList"
                  Background="#17202D" Foreground="#EAF0F6" BorderBrush="#405063"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CollectorNumber}" Grid.Column="0"
                                   Foreground="#A3C2D0"/>
                        <TextBlock Text="{Binding Name}" Grid.Column="1"
                                   FontWeight="Medium"/>
                        <TextBlock Text="{Binding SetCode}" Grid.Column="2"
                                   Foreground="#B8C7D6"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="4" x:Name="ModeStatus" Margin="0,12,0,0"
                   Foreground="#A8BACA" FontSize="12"
                   Text="No native workspace imported. Choose Import backup once to begin. Your installed Arcane Vault remains unchanged."/>
    </Grid>
</Window>
