<Window x:Class="ArcaneVault.Next.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcaneVault.Next.Desktop"
        Title="Arcane Vault — Native Windows" Width="1330" Height="850"
        MinWidth="965" MinHeight="655"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Window.Resources>
        <Style x:Key="VaultColorToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinWidth" Value="41"/>
            <Setter Property="Height" Value="37"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,7,6"/>
            <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleChrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background"
                                        Value="{DynamicResource VaultAccentSurface}"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                                <Setter TargetName="ToggleChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Catalog pages render at most 200 local results at a time; never
             launch remote art requests during list scrolling. -->
        <DataTemplate x:Key="CatalogCompactTemplate">
            <Grid Margin="5,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="9,3" Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontSize="12"
                               Foreground="{DynamicResource VaultText}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding OwnershipLabel}" FontSize="10"
                               Foreground="{DynamicResource VaultAccent}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RolesLabel}" FontSize="10"
                               Foreground="{DynamicResource VaultGood}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DisplaySetCode}" FontSize="11"
                           Margin="5,5" Foreground="{DynamicResource VaultAccent}"/>
                <TextBlock Grid.Column="2" Text="{Binding DisplayCollectorNumber}" FontSize="11"
                           Margin="5,5" Foreground="{DynamicResource VaultMuted}"/>
            </Grid>
        </DataTemplate>
        <!-- Card art tiles read as physical objects, but use a shadow ONLY
             while hovered (off-screen tiles never instantiate image controls). -->
        <Style x:Key="VaultCatalogTileStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource VaultTileWash}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultEdgeLift}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VaultAccentSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
                    <Setter Property="Effect" Value="{StaticResource VaultPanelShadow}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Each card widget stays exactly 218 DIPs wide; only the number
             of columns changes when the viewport grows or shrinks.
             The outer ListView virtualizes rows, so off-screen artwork never loads. -->
        <!-- Card-first density: the artwork now occupies most of each cell.
             All images are still hosted inside virtualized catalog ROWS. -->
        <DataTemplate x:Key="CatalogTileRowTemplate">
            <ItemsControl ItemsSource="{Binding Cards}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3,4" Padding="5"
                                Width="218" HorizontalAlignment="Center"
                                Height="366" Style="{StaticResource VaultCatalogTileStyle}"
                                Tag="{Binding}"
                                PreviewMouseLeftButtonDown="OnCatalogTileMouseDown"
                                ToolTip="Single-click to inspect; double-click for full details and printings">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" HorizontalAlignment="Center"
                                        Width="200" Height="278" CornerRadius="9"
                                        Background="{DynamicResource VaultBackground}"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Image not cached"
                                                   Foreground="{DynamicResource VaultMuted}"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   Margin="14" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <local:NativeCardArtImage ArtUrl="{Binding ImageUrl}"
                                                                  Width="196" Height="274"
                                                                  DecodeWidth="320"/>
                                        <Border VerticalAlignment="Bottom" Height="25"
                                                Background="#DA10151F">
                                            <DockPanel Margin="7,0" LastChildFill="True">
                                                <TextBlock Text="{Binding RarityLabel}"
                                                           DockPanel.Dock="Left"
                                                           FontWeight="Bold" FontSize="10.5"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource VaultMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="uncommon">
                                                                    <Setter Property="Foreground" Value="#C9D1DD"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="rare">
                                                                    <Setter Property="Foreground" Value="#EDC875"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="mythic">
                                                                    <Setter Property="Foreground" Value="#FFAD79"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplaySetCode}"
                                                           FontSize="10" TextAlignment="Right"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="7,0,0,0"/>
                                            </DockPanel>
                                        </Border>
                                        <Button x:Name="CardShortlistStar"
                                                Content="{Binding ShortlistStar}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding ShortlistTooltip}"
                                                Click="OnCatalogShortlistStarClicked"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="33" Height="33" Margin="0,3,3,0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontSize="23" FontWeight="Bold"
                                                Background="#E017202E"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                Foreground="{DynamicResource VaultWarning}"
                                                Cursor="Hand"
                                                ToolTipService.ShowDuration="15000"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="5,6,5,0">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource VaultText}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding RolesLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource VaultGood}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RolesLabel}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding OwnershipLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource VaultAccent}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="CatalogVirtualPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The original WebView application's compact, grouped left navigation.
             All commands keep their existing event handlers and confirmation flow. -->
        <Border Grid.Column="0" Background="{DynamicResource VaultSidebarWash}"
                BorderBrush="{DynamicResource VaultLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="15,22,15,18">
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource VaultTileWash}"
                        BorderBrush="{DynamicResource VaultEdgeLift}" BorderThickness="1"
                        CornerRadius="14" Padding="13" Margin="2,18,2,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource VaultEyebrow}"
                                   Text="PRIVATE BY DESIGN"/>
                        <TextBlock Style="{StaticResource VaultMutedText}"
                                   Margin="0,7,0,0"
                                   Text="Your inventory, deck library and recovery points stay in the native Windows workspace."/>
                        <Border Margin="0,12,0,0" BorderBrush="{DynamicResource VaultLine}"
                                BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <TextBlock Foreground="{DynamicResource VaultGood}"
                                       FontSize="11" Text="●  LOCAL DATABASE"/>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="3,0,0,28">
                            <Border Width="43" Height="43" CornerRadius="11"
                                    Background="{DynamicResource VaultHeroWash}"
                                    BorderBrush="{DynamicResource VaultEdgeLift}"
                                    BorderThickness="1" Margin="0,0,10,0"
                                    Effect="{StaticResource VaultPanelShadow}">
                                <Image Source="/ArcaneVault.Next.Desktop;component/Assets/ArcaneVaultIcon.png"
                                       Width="36" Height="36"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="21" FontWeight="Bold">
                                    <Run Text="ARCANE "/><Run Text="VAULT"
                                            Foreground="{DynamicResource VaultAccent}"/>
                                </TextBlock>
                                <TextBlock Text="Windows · native edition"
                                           Style="{StaticResource VaultMutedText}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="5" CornerRadius="3"
                                Background="{DynamicResource VaultThemeBanner}"
                                Margin="7,-12,7,17"/>
                        <TextBlock Text="WORKSPACES" Style="{StaticResource VaultEyebrow}"
                                   Margin="10,0,0,10"/>
                        <Button x:Name="CatalogNavigationButton"
                                Content="▤   Card Catalog"
                                Click="OnShowCatalogClicked"
                                Style="{StaticResource VaultNavPrimary}"
                                ToolTip="Browse all Scryfall printings in the main window"
                                Margin="0,0,0,5"/>
                        <Button x:Name="OpenNativeButton"
                                Content="▣   My Collection"
                                Click="OnOpenNativeClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavPrimary}"
                                ToolTip="Browse your physical collection, Arena inventory and Set Progress in the main window"
                                Margin="0,0,0,5"/>
                        <Button x:Name="DeckLibraryNavigationButton"
                                Content="▧   Deck Library"
                                Click="OnOpenDeckLibraryClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse and edit saved decks in the main workspace"
                                Margin="0,0,0,5"/>
                        <Button x:Name="EdhLabButton"
                                Content="♜   EDH Lab"
                                Click="OnEdhLabClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse Commanders or Arena Brawl leaders and build with your collection. Requires a synced Scryfall catalog."
                                Margin="0,0,0,5"/>
                        <Button x:Name="SetProgressNavigationButton"
                                Content="▦   Set Progress"
                                Click="OnOpenSetProgressClicked" IsEnabled="False"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse verified owned set progress in the main workspace"
                                Margin="0,0,0,5"/>
                        <Button x:Name="MyShortlistButton"
                                Content="☆   My Shortlist"
                                Click="OnOpenShortlistClicked"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="Browse saved card bookmarks from the legacy-compatible native collection"
                                Margin="0,0,0,5"/>
                        <Border BorderBrush="{DynamicResource VaultLine}" BorderThickness="0,1,0,0"
                                Margin="8,9,8,16"/>
                        <Button x:Name="ActivityHistoryButton" Content="◉   Activity (0)"
                                Style="{StaticResource VaultNavButtonDepth}"
                                ToolTip="In-app updates and notifications; no Windows notification-center dependency"
                                Click="OnActivityHistoryClicked" Margin="0,0,0,12"/>
                        <TextBlock Text="TOOLS &amp; SETTINGS" Style="{StaticResource VaultEyebrow}" Margin="10,0,0,13"/>
                        <Expander x:Name="CardDatabaseSettings" Header="Card Database" IsExpanded="False"
                                  Foreground="{DynamicResource VaultText}"
                                  Background="Transparent" Margin="0,0,0,10"
                                  ToolTip="Sync, open, and retain Scryfall catalog metadata">
                            <StackPanel Margin="11,9,0,4">
                                <Button x:Name="SyncCatalogButton"
                                    Content="⟳   Sync Scryfall Catalog"
                                    Click="OnSyncCatalogClicked"
                                    Style="{StaticResource VaultNavPrimary}"
                                    ToolTip="Download or refresh official Scryfall bulk printing data"
                                    Margin="0,0,0,5"/>
                                <Button x:Name="CancelCatalogButton"
                                    Content="×   Cancel Catalog Sync"
                                    Click="OnCancelCatalogClicked" IsEnabled="False"
                                    Style="{StaticResource VaultDangerButton}"
                                    Margin="0,0,0,6"/>
                                <Button x:Name="OpenCatalogButton"
                                    Content="◫   Open Local Catalog"
                                    Click="OnOpenCatalogClicked"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    ToolTip="Open an existing catalog using a private SQLite snapshot"
                                    Margin="0,0,0,5"/>
                                <Button x:Name="SaveNativeCatalogButton"
                                    Content="↓   Keep Catalog Natively"
                                    Click="OnSaveNativeCatalogClicked" IsEnabled="False"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    Margin="0,0,0,5"/>
                                <Button x:Name="SyntheticButton" Visibility="Collapsed"
                                    Content="Use synthetic cards"
                                    Click="OnSyntheticClicked"
                                    Style="{StaticResource VaultNavButtonDepth}"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="DataSyncSettings" Header="Data &amp; Sync" IsExpanded="False"
                                  Foreground="{DynamicResource VaultText}"
                                  Background="Transparent" Margin="0,0,0,10"
                                  ToolTip="Legacy data migration, full exports and recovery">
                            <StackPanel Margin="11,9,0,4">
                                <Button x:Name="MigrateLegacyButton"
                                    Content="⇄   Inspect / Refresh Old Data"
                                    Click="OnMigrateLegacyClicked"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    ToolTip="Import or compare against the installed legacy app without altering its data"
                                    Margin="0,0,0,5"/>
                                <Button x:Name="ImportNativeButton"
                                    Content="↓   Import Full Backup"
                                    Click="OnImportNativeClicked"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    Margin="0,0,0,5"/>
                                <Button x:Name="ExportFullBackupButton"
                                    Content="↑   Export Full Backup"
                                    Click="OnExportFullBackupClicked" IsEnabled="False"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    Margin="0,0,0,5"/>
                                <Button x:Name="RestoreRecoveryButton"
                                    Content="↶   Restore Recovery Point"
                                    Click="OnRestoreRecoveryClicked" IsEnabled="False"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    Margin="0,0,0,5"/>
                                <Button x:Name="CollectionBackupButton"
                                    Content="◷   Preview External Backup"
                                    Click="OnCollectionBackupClicked"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    Margin="0,0,0,5"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="NativeUpdatesSettings" Header="Native Updates" IsExpanded="False"
                                  Foreground="{DynamicResource VaultText}"
                                  Background="Transparent" Margin="0,0,0,10"
                                  ToolTip="Check for verified side-by-side native Windows releases">
                            <StackPanel Margin="11,9,0,4">
                                <Button x:Name="CheckNativeUpdatesButton"
                                    Content="⬆   Check Native Updates"
                                    Click="OnCheckNativeUpdatesClicked"
                                    Style="{StaticResource VaultNavPrimary}"
                                    ToolTip="Find a newer native preview release, verify its checksum, and install side-by-side"
                                    Margin="0,12,0,5"/>
                                <TextBlock x:Name="NativeVersionLabel"
                                    Style="{StaticResource VaultMutedText}"
                                    Text="Native preview version" Margin="10,2,0,5"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="GeneralOptionsSettings" Header="Options" IsExpanded="False"
                                  Foreground="{DynamicResource VaultText}"
                                  Background="Transparent" Margin="0,0,0,10"
                                  ToolTip="Collection reset and local application settings">
                            <StackPanel Margin="11,9,0,4">
                                <Button x:Name="OpenAppearanceButton"
                                        Content="◈   Appearance &amp; Themes"
                                        Click="OnOpenAppearanceClicked"
                                        Style="{StaticResource VaultNavPrimary}"
                                        ToolTip="Choose a classic or Magic color-identity application palette"
                                        Margin="0,0,0,7"/>
                                <Button x:Name="StartFreshButton"
                                    Content="＋   Start Fresh Collection"
                                    Click="OnStartFreshClicked"
                                    Style="{StaticResource VaultNavButtonDepth}"
                                    ToolTip="Start with zero ownership; keep a recovery point if a collection exists"
                                    Margin="0,0,0,5"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="CatalogWorkspace" Grid.Column="1" Margin="21,15,21,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Height="4" CornerRadius="2" MaxWidth="240"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource VaultThemeBanner}"
                            Margin="0,0,0,12"/>
                    <TextBlock Text="THE ARCHIVE" Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,7"/>
                    <TextBlock Text="Card Catalog" FontSize="31"
                               FontWeight="Bold" Foreground="{DynamicResource VaultText}"/>
                    <TextBlock Text="Find cards, explore printings, and manage your own vault."
                               Style="{StaticResource VaultMutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource VaultAccentSurface}"
                        BorderBrush="{DynamicResource VaultAccentBorder}" BorderThickness="1"
                        CornerRadius="18" Padding="13,7"
                        VerticalAlignment="Top" Margin="10,6,0,0">
                    <TextBlock Text="●  NATIVE WINDOWS PREVIEW"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource VaultAccent}"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource VaultElevatedPanel}"
                    Margin="0,0,0,12" Padding="16,12">
                <!-- Stable vertical groups: full-width search, wrapping field
                     groups, then color filters and view mode. No fixed right
                     column or uneven WrapPanel vertical alignment. -->
                <StackPanel>
                        <TextBlock Text="SEARCH PRINTINGS"
                                   Style="{StaticResource VaultEyebrow}"
                                   Margin="0,0,0,7"/>
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                                 ToolTip="Search catalog card names by prefix; use Next to browse all matching pages"
                                 FontSize="15" Height="44"
                                 Padding="14,7"
                                 Background="{DynamicResource VaultPanelRaised}"
                                 Foreground="{DynamicResource VaultText}"
                                 BorderBrush="{DynamicResource VaultLine}"/>
                        <WrapPanel Margin="0,13,0,7">
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="SET CODE" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="SetFilterBox" Width="90" Height="36"
                                         TextChanged="OnCatalogFilterChanged"
                                         ToolTip="Exact set abbreviation (e.g. MH3, CMM)"
                                         Padding="7,4" Background="{DynamicResource VaultPanelRaised}"
                                         Foreground="{DynamicResource VaultText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="RARITY" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="RarityFilterBox" Width="135" Height="36"
                                          SelectedIndex="0"
                                          SelectionChanged="OnCatalogFilterChanged"
                                          Background="{DynamicResource VaultPanelRaised}"
                                          Foreground="{DynamicResource VaultText}">
                                    <ComboBoxItem Content="All rarities" Tag=""/>
                                    <ComboBoxItem Content="Common" Tag="common"/>
                                    <ComboBoxItem Content="Uncommon" Tag="uncommon"/>
                                    <ComboBoxItem Content="Rare" Tag="rare"/>
                                    <ComboBoxItem Content="Mythic" Tag="mythic"/>
                                    <ComboBoxItem Content="Special" Tag="special"/>
                                    <ComboBoxItem Content="Bonus" Tag="bonus"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="UTILIZATION TAG" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="RoleFilterBox" Width="155" Height="36"
                                          SelectedIndex="0"
                                          SelectionChanged="OnCatalogFilterChanged"
                                          ToolTip="Heuristics from cached Scryfall Oracle text; a card can have multiple tags">
                                    <ComboBoxItem Content="All roles" Tag=""/>
                                    <ComboBoxItem Content="Ramp" Tag="Ramp"/>
                                    <ComboBoxItem Content="Removal" Tag="Removal"/>
                                    <ComboBoxItem Content="Board Wipe" Tag="Board Wipe"/>
                                    <ComboBoxItem Content="Discard" Tag="Discard"/>
                                    <ComboBoxItem Content="Counterspell" Tag="Counterspell"/>
                                    <ComboBoxItem Content="Card Draw" Tag="Card Draw"/>
                                    <ComboBoxItem Content="Card Selection" Tag="Card Selection"/>
                                    <ComboBoxItem Content="Lifegain" Tag="Lifegain"/>
                                    <ComboBoxItem Content="Tutor" Tag="Tutor"/>
                                    <ComboBoxItem Content="Stax" Tag="Stax"/>
                                    <ComboBoxItem Content="Haste" Tag="Haste"/>
                                    <ComboBoxItem Content="Protection" Tag="Protection"/>
                                    <ComboBoxItem Content="Recursion" Tag="Recursion"/>
                                    <ComboBoxItem Content="Sacrifice" Tag="Sacrifice"/>
                                    <ComboBoxItem Content="Tokens" Tag="Tokens"/>
                                    <ComboBoxItem Content="Graveyard Hate" Tag="Graveyard Hate"/>
                                    <ComboBoxItem Content="Finisher" Tag="Finisher"/>
                                    <ComboBoxItem Content="Equipment" Tag="Equipment"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="TYPE CONTAINS" Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="TypeFilterBox" Width="163" Height="36"
                                         TextChanged="OnCatalogFilterChanged"
                                         ToolTip="Filter oracle card type line: Creature, Enchantment, Wizard, etc."
                                         Padding="7,4" Background="{DynamicResource VaultPanelRaised}"
                                         Foreground="{DynamicResource VaultText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,7">
                                <TextBlock Text="CATALOG SCOPE"
                                           Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <Border Height="36" Padding="6,0"
                                        Background="{DynamicResource VaultPanelRaised}"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="1" CornerRadius="5">
                                    <CheckBox x:Name="ArenaOnlyBox"
                                              Content="Arena catalog (one per card)"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource VaultText}"
                                              Checked="OnCatalogFilterChanged"
                                              Unchecked="OnCatalogFilterChanged"
                                              ToolTip="Show only cards available in MTG Arena, once per card name. This is NOT your owned Arena inventory; use Collection Ownership to filter owned cards."/>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,7">
                                <TextBlock Text="COLLECTION OWNERSHIP"
                                           Style="{StaticResource VaultEyebrow}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="OwnershipFilterBox" Width="227" Height="36"
                                          SelectedIndex="1"
                                          SelectionChanged="OnCatalogFilterChanged"
                                          Background="{DynamicResource VaultPanelRaised}"
                                          Foreground="{DynamicResource VaultText}"
                                          ToolTip="Physical requires matching exact printing ID; Arena uses card names">
                                    <ComboBoxItem Content="All printings"/>
                                    <ComboBoxItem Content="Owned physical printing"/>
                                    <ComboBoxItem Content="Physical not verified owned"/>
                                    <ComboBoxItem Content="Owned on Arena (card name)"/>
                                    <ComboBoxItem Content="Not owned on Arena (name)"/>
                                </ComboBox>
                                <CheckBox x:Name="CatalogIncludeProxiesBox"
                                          Content="Include Proxies"
                                          IsEnabled="True" IsChecked="False"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged"
                                          Margin="0,7,0,0"
                                          Foreground="{DynamicResource VaultText}"
                                          ToolTip="With Owned physical printing, also show names recorded as paper proxies. These are not verified owned printings, are shown once per name, and never contribute to prices or collection value."/>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="COLOR IDENTITY" Style="{StaticResource VaultEyebrow}"
                                       VerticalAlignment="Center" Margin="0,0,11,6"/>
                            <ToggleButton x:Name="ColorWBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="White color identity — click to toggle"
                                          AutomationProperties.Name="White color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="W" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorUBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Blue color identity — click to toggle"
                                          AutomationProperties.Name="Blue color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="U" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorBBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Black color identity — click to toggle"
                                          AutomationProperties.Name="Black color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="B" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorRBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Red color identity — click to toggle"
                                          AutomationProperties.Name="Red color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="R" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorGBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Green color identity — click to toggle"
                                          AutomationProperties.Name="Green color identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="G" Width="22" Height="22"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ColorlessOnlyBox"
                                          Style="{StaticResource VaultColorToggleStyle}"
                                          ToolTip="Colorless identity only — click to toggle"
                                          AutomationProperties.Name="Colorless identity filter"
                                          Checked="OnCatalogFilterChanged"
                                          Unchecked="OnCatalogFilterChanged">
                                <local:NativeManaSymbol Symbol="C" Width="22" Height="22"/>
                            </ToggleButton>
                            <ComboBox x:Name="ColorMatchBox" SelectedIndex="0"
                                      SelectionChanged="OnCatalogFilterChanged"
                                      Width="127" Height="28" Margin="0,0,0,6"
                                      Background="{DynamicResource VaultPanelRaised}"
                                      Foreground="{DynamicResource VaultText}"
                                      ToolTip="Includes all: W+U shows Azorius and more colors; Exact: only WU">
                                <ComboBoxItem Content="Contains all"/>
                                <ComboBoxItem Content="Exact colors"/>
                                <ComboBoxItem Content="Contains any"/>
                            </ComboBox>
                        </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="CATALOG VIEW" Style="{StaticResource VaultEyebrow}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CatalogViewMode" Width="225" SelectedIndex="2"
                                  SelectionChanged="OnCatalogViewModeChanged"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  Foreground="{DynamicResource VaultText}"
                                  Padding="6,4" Height="32"
                                  ToolTip="Switch between detailed, dense and tile layouts">
                            <ComboBoxItem Content="Detailed list"/>
                            <ComboBoxItem Content="Compact list"/>
                            <ComboBoxItem Content="Card art"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" MinHeight="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                    Background="{DynamicResource VaultPanel}"
                    BorderBrush="{DynamicResource VaultEdgeLift}"
                    BorderThickness="1" CornerRadius="16"
                    Effect="{StaticResource VaultPanelShadow}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="CatalogColumnHeaders" Grid.Row="0" Background="{DynamicResource VaultPanelRaised}"
                          Height="45">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="126"/>
                            <ColumnDefinition Width="116"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CARD NAME" Grid.Column="0"
                                   Style="{StaticResource VaultEyebrow}"
                                   Foreground="{DynamicResource VaultMuted}"
                                   Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SET" Grid.Column="1"
                                   Style="{StaticResource VaultEyebrow}"
                                   Foreground="{DynamicResource VaultMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="COLLECTOR #" Grid.Column="2"
                                   Style="{StaticResource VaultEyebrow}"
                                   Foreground="{DynamicResource VaultMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ListView Grid.Row="1" x:Name="CardsList"
                              SelectionChanged="OnCatalogRowSelectionChanged"
                              SizeChanged="OnCatalogListSizeChanged"
                              HorizontalContentAlignment="Stretch"
                              MouseDoubleClick="OnCatalogCardRowDoubleClick"
                              Background="{DynamicResource VaultPanel}"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3,2" Padding="12,12"
                                        CornerRadius="8" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource VaultLine}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="126"/>
                                            <ColumnDefinition Width="104"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource VaultText}"/>
                                            <TextBlock Text="{Binding OwnershipLabel}"
                                                       Foreground="{DynamicResource VaultAccent}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RolesLabel}"
                                                       Foreground="{DynamicResource VaultGood}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTip="Derived from Scryfall Oracle text and type"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="11"
                                                HorizontalAlignment="Left"
                                                Padding="10,5"
                                                Background="{DynamicResource VaultAccentSurface}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding DisplaySetCode}" FontSize="11"
                                                       Foreground="{DynamicResource VaultAccent}"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayCollectorNumber}"
                                                   Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource VaultMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" Margin="12,8,12,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="CatalogPageStatus"
                                   Text="No catalog results" VerticalAlignment="Center"
                                   Foreground="{DynamicResource VaultMuted}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0"/>
                        <Button Grid.Column="1" x:Name="PreviousCatalogPageButton"
                                Content="Previous" Click="OnPreviousCatalogPageClicked"
                                IsEnabled="False" Padding="12,6" Margin="0,0,8,0"
                                Background="{DynamicResource VaultPanelRaised}"
                                Foreground="{DynamicResource VaultText}"
                                ToolTip="Show the previous page of matching cards"/>
                        <TextBlock Grid.Column="2" x:Name="CatalogPageLabel"
                                   Text="Page 1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource VaultText}"
                                   FontSize="12" Margin="4,0,12,0"/>
                        <Button Grid.Column="3" x:Name="NextCatalogPageButton"
                                Content="Next" Click="OnNextCatalogPageClicked"
                                IsEnabled="False" Padding="12,6"
                                Background="{DynamicResource VaultPanelRaised}"
                                Foreground="{DynamicResource VaultText}"
                                ToolTip="Show the next page of matching cards"/>
                    </Grid>
                </Grid>
            </Border>

                <!-- Persistent context: choose another catalog card without
                     opening or closing a separate window. Only the inspector
                     requests additional metadata and art for its current card. -->
                <Border x:Name="CardInspectorPanel" Grid.Column="1"
                        Width="342" Visibility="Collapsed"
                        Margin="12,0,0,0" Padding="13"
                        Background="{DynamicResource VaultTileWash}"
                        BorderBrush="{DynamicResource VaultEdgeLift}"
                        BorderThickness="1" CornerRadius="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource VaultEyebrow}"
                                           Text="CARD INSPECTOR"/>
                                <TextBlock x:Name="InspectorName" Text="Select a card"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource VaultText}"
                                           TextWrapping="Wrap" MaxHeight="55"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" FontSize="18" Width="30"
                                    Height="30" Padding="0" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Click="OnInspectorCloseClicked"
                                    Background="{DynamicResource VaultPanelRaised}"
                                    Foreground="{DynamicResource VaultText}"
                                    ToolTip="Hide card inspector; click another card to reopen"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel>
                                <Border Width="182" Height="255" CornerRadius="9"
                                        HorizontalAlignment="Center" ClipToBounds="True"
                                        BorderThickness="1" BorderBrush="{DynamicResource VaultEdgeLift}"
                                        Background="{DynamicResource VaultPanel}">
                                    <Grid>
                                        <TextBlock Text="No artwork cached"
                                                   Style="{StaticResource VaultMutedText}"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="10" VerticalAlignment="Center"/>
                                        <local:NativeCardArtImage x:Name="InspectorArt" DecodeWidth="350"
                                                                  Width="180" Height="253"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="InspectorPrinting" Margin="0,10,0,0"
                                           FontSize="11" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VaultAccent}"/>
                                <TextBlock x:Name="InspectorOwnership" Margin="0,6,0,0"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VaultMuted}"/>
                                <TextBlock x:Name="InspectorType" Margin="0,10,0,0"
                                           FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VaultText}"/>
                                <TextBlock Text="MANA COST (EXACT)"
                                           Style="{StaticResource VaultEyebrow}" Margin="0,10,0,5"/>
                                <local:NativeManaStrip x:Name="InspectorManaCost"
                                                       Kind="Cost" SymbolSize="21"
                                                       AutomationProperties.Name="Exact official catalog card mana cost"/>
                                <TextBlock Text="COLOR IDENTITY" Margin="0,10,0,5"
                                           Style="{StaticResource VaultEyebrow}"/>
                                <ItemsControl x:Name="InspectorIdentityIcons">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:NativeManaSymbol Symbol="{Binding Symbol}"
                                                                    Width="25" Height="25"
                                                                    Margin="0,0,5,0"
                                                                    ToolTip="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="{DynamicResource VaultEdgeLift}"
                                        BorderThickness="0,1,0,0" Margin="0,13,0,8"
                                        Padding="0,10,0,0">
                                    <TextBlock Text="ORACLE TEXT"
                                               Style="{StaticResource VaultEyebrow}"/>
                                </Border>
                                <!-- Native reading surface: no caret, text-box bezel,
                                     or editable-looking input chrome. -->
                                <FlowDocumentScrollViewer x:Name="InspectorOracle"
                                     Height="192"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource VaultText}"
                                     IsToolBarVisible="False" IsSelectionEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Selected card Oracle text with official symbols"/>
                                <TextBlock x:Name="InspectorStatus"
                                           Margin="0,7,0,0" FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource VaultMuted}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="InspectorFullDetailsButton"
                                    Content="Open full details &amp; printings"
                                    Click="OnInspectorFullDetailsClicked"
                                    Padding="10,8"
                                    Background="{DynamicResource VaultAccentSurface}"
                                    Foreground="{DynamicResource VaultText}"
                                    ToolTip="Optional full Card Details window for printings and ownership actions"/>
                            <Button x:Name="InspectorExpandButton"
                                    Content="Widen inspector"
                                    Click="OnInspectorExpandClicked"
                                    Padding="10,6" Margin="0,6,0,0"
                                    Background="{DynamicResource VaultPanelRaised}"
                                    Foreground="{DynamicResource VaultText}"
                                    ToolTip="Expand or restore the in-app inspector width"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Margin="0,14,0,0"
                    BorderBrush="{DynamicResource VaultEdgeLift}"
                    BorderThickness="0,1,0,0" Padding="4,11,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="●  WORKSPACE" Foreground="{DynamicResource VaultGood}"
                               FontWeight="SemiBold" FontSize="11"
                               Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeStatus"
                                   Foreground="{DynamicResource VaultMuted}"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Text="A new vault can start empty, then add physical and Arena cards using the native collection."/>
                        <TextBlock x:Name="FilterStatus" Margin="0,3,0,0"
                                   Foreground="{DynamicResource VaultMuted}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="No catalog loaded"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Embedded native workspace; Collection and Deck Library use the same
             verified data and editor flows as the old popup, without a Window. -->
        <ContentControl x:Name="NativeWorkspaceHost" Grid.Column="1"
                        Margin="10,12,10,12" Visibility="Collapsed"/>
        <!-- EDH commander discovery occupies the same central workspace
             as Card Catalog and Deck Library. No floating browser window. -->
        <Grid x:Name="EdhLabHost" Grid.Column="1"
              Margin="10,12,10,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,6"
                    BorderBrush="{DynamicResource VaultLine}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="EDH LAB" Foreground="{DynamicResource VaultAccent}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               DockPanel.Dock="Left" Margin="4,0,14,0"/>
                    <Button x:Name="EdhShowCommandersButton"
                            Content="Commander browser"
                            Click="OnEdhShowCommandersClicked"
                            Padding="10,5" Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            Background="{DynamicResource VaultPanelRaised}"
                            Foreground="{DynamicResource VaultText}"/>
                    <Button x:Name="EdhReturnToDraftButton"
                            Content="Return to draft"
                            Click="OnEdhReturnToDraftClicked" IsEnabled="False"
                            Padding="10,5" DockPanel.Dock="Left"
                            Background="{DynamicResource VaultPanelRaised}"
                            Foreground="{DynamicResource VaultText}"/>
                </DockPanel>
            </Border>
            <ContentControl x:Name="EdhLabSurface" Grid.Row="1"/>
        </Grid>

        <!-- App-owned, nonmodal notices and short session activity history.
             Empty grid areas do not intercept catalog navigation. -->
        <StackPanel Grid.ColumnSpan="2" Panel.ZIndex="90"
                    Width="395" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,34,18,0">
            <Border x:Name="ActivityHistoryPanel" Visibility="Collapsed"
                    Padding="12" Margin="0,0,0,9" MaxHeight="360"
                    Background="{DynamicResource VaultPanelRaised}"
                    BorderBrush="{DynamicResource VaultEdgeLift}"
                    BorderThickness="1" CornerRadius="13">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Clear history"
                                Click="OnClearActivityClicked"
                                Background="{DynamicResource VaultPanel}"
                                Foreground="{DynamicResource VaultText}"
                                Padding="8,4" Margin="8,0,0,0"/>
                        <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource VaultEyebrow}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="295">
                        <ItemsControl x:Name="ActivityHistoryItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource VaultLine}"
                                            BorderThickness="0,0,0,1" Padding="3,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding TimestampLabel}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="{DynamicResource VaultMuted}"
                                                           FontSize="10"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                           Foreground="{DynamicResource VaultText}"
                                                           FontSize="12"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource VaultMuted}"
                                                       MaxHeight="85"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <ItemsControl x:Name="ActiveNoticeItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,7" Padding="13,10" CornerRadius="12"
                                Background="{DynamicResource VaultPanelRaised}"
                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                BorderThickness="1" Effect="{StaticResource VaultPanelShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource VaultText}"/>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="11.5" TextWrapping="Wrap"
                                               MaxHeight="100"
                                               Foreground="{DynamicResource VaultMuted}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" Width="25" Height="25"
                                        Padding="0" Margin="7,0,0,0"
                                        Tag="{Binding Id}" Click="OnDismissNoticeClicked"
                                        Background="{DynamicResource VaultPanel}"
                                        Foreground="{DynamicResource VaultText}"
                                        ToolTip="Dismiss this in-app notification"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>