<Window x:Class="ArcaneVault.Next.Desktop.NativeShortlistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault — My Shortlist"
        Width="980" Height="680" MinWidth="780" MinHeight="530"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="SAVED CARDS" Style="{StaticResource VaultEyebrow}"
                       Margin="0,0,0,5"/>
            <TextBlock Text="My Shortlist" FontWeight="Bold" FontSize="26"
                       Foreground="{DynamicResource VaultText}"/>
            <TextBlock Text="Bookmarks for future decks, not additional owned cards. Legacy WebView favorites carry forward in your native full backup."
                       Foreground="{DynamicResource VaultMuted}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                <TextBlock Text="SEARCH" Style="{StaticResource VaultEyebrow}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="290" Height="32"
                         TextChanged="OnFilterChanged"
                         ToolTip="Filter saved card names without changing the shortlist"
                         Background="{DynamicResource VaultPanelRaised}"
                         Foreground="{DynamicResource VaultText}"
                         BorderBrush="{DynamicResource VaultLine}"
                         Padding="8,5"/>
            </StackPanel>
            <CheckBox x:Name="NotConfirmedOnly" Content="No verified owned copies"
                      Foreground="{DynamicResource VaultText}"
                      VerticalAlignment="Center" Margin="0,0,15,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                      ToolTip="Shows cards without verified paper copies or Arena copies; may include unresolved paper holdings"/>
            <Button Content="Refresh ownership" Click="OnRefreshClicked"
                    Padding="11,6" Background="{DynamicResource VaultPanelRaised}"
                    Foreground="{DynamicResource VaultText}"
                    BorderBrush="{DynamicResource VaultLine}"/>
        </WrapPanel>
        <Border Grid.Row="2" Style="{StaticResource VaultPanelCard}" Padding="8">
            <ListView x:Name="ShortlistList" SelectionChanged="OnCardSelected"
                      MouseDoubleClick="OnCardDoubleClicked"
                      Background="{DynamicResource VaultPanelRaised}"
                      Foreground="{DynamicResource VaultText}"
                      BorderBrush="{DynamicResource VaultLine}"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Card name" Width="242"
                                        DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Physical verified" Width="135"
                                        DisplayMemberBinding="{Binding PhysicalLabel}"/>
                        <GridViewColumn Header="Physical unresolved" Width="140"
                                        DisplayMemberBinding="{Binding UnresolvedLabel}"/>
                        <GridViewColumn Header="Arena owned" Width="100"
                                        DisplayMemberBinding="{Binding ArenaLabel}"/>
                        <GridViewColumn Header="Collection status" Width="270"
                                        DisplayMemberBinding="{Binding OwnershipLabel}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,11,0,8"
                   TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}"
                   Text="Reading the saved shortlist…"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Double-click a saved card for its offline details. Export uses one copy per bookmarked name, just like the legacy app."
                       FontSize="11" Foreground="{DynamicResource VaultMuted}"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyAllButton" Content="Copy as Arena list"
                        Click="OnCopyClicked" Padding="12,8" Margin="0,0,8,0"
                        IsEnabled="False"
                        Background="{DynamicResource VaultPanelRaised}"
                        Foreground="{DynamicResource VaultText}"
                        BorderBrush="{DynamicResource VaultLine}"/>
                <Button x:Name="ViewDetailsButton" Content="Card details"
                        Click="OnDetailsClicked" Padding="12,8" Margin="0,0,8,0"
                        IsEnabled="False"
                        Background="{DynamicResource VaultPanelRaised}"
                        Foreground="{DynamicResource VaultText}"
                        BorderBrush="{DynamicResource VaultLine}"/>
                <Button x:Name="RemoveButton" Content="Remove bookmark"
                        Click="OnRemoveClicked" Padding="12,8" Margin="0,0,8,0"
                        IsEnabled="False"
                        Background="{DynamicResource VaultAccent}"
                        Foreground="White"/>
                <Button Content="Close" Click="OnCloseClicked" Padding="12,8"
                        Background="{DynamicResource VaultPanelRaised}"
                        Foreground="{DynamicResource VaultText}"
                        BorderBrush="{DynamicResource VaultLine}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
