<Window x:Class="ArcaneVault.Next.Desktop.NativeCollectionClearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault — Clear inventory"
        Width="540" Height="455" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="DESTRUCTIVE COLLECTION ACTION"
                       Foreground="{DynamicResource VaultWarning}"
                       FontWeight="Bold" FontSize="11" Margin="0,0,0,7"/>
            <TextBlock Text="Clear an inventory scope" FontSize="22"
                       Foreground="{DynamicResource VaultText}"
                       FontWeight="Bold" Margin="0,0,0,9"/>
            <TextBlock Text="This clears owned quantities from the selected scope only. Your saved decks, revisions, shortlist, preferred artwork and other scope remain intact. A verified native recovery copy will be saved before the replacement."
                       TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="CurrentTotals"
                   TextWrapping="Wrap" Margin="0,0,0,13"
                   Foreground="{DynamicResource VaultText}"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,13">
            <TextBlock Text="Choose what to clear" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="ScopeBox" SelectedIndex="-1"
                      SelectionChanged="OnInputsChanged"
                      Padding="8,7" Height="37"
                      Background="{DynamicResource VaultPanelRaised}"
                      Foreground="{DynamicResource VaultText}">
                <ComboBoxItem Content="Physical collection only"/>
                <ComboBoxItem Content="Arena collection only"/>
                <ComboBoxItem Content="Both physical and Arena collections"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,11">
            <TextBlock x:Name="ConfirmationPrompt" TextWrapping="Wrap"
                       Text="Select a scope to see its confirmation phrase."
                       Foreground="{DynamicResource VaultWarning}"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="ConfirmationText" TextChanged="OnInputsChanged"
                     Padding="9,7" FontSize="13"
                     Background="{DynamicResource VaultPanelRaised}"
                     Foreground="{DynamicResource VaultText}"/>
        </StackPanel>
        <CheckBox Grid.Row="4" x:Name="Acknowledged"
                  Checked="OnInputsChanged" Unchecked="OnInputsChanged"
                  Margin="0,7,0,0"
                  Foreground="{DynamicResource VaultText}">
            <TextBlock TextWrapping="Wrap" Width="420"
                       Text="I understand I must explicitly reimport the cleared cards, and I have checked my full backup."/>
        </CheckBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True"
                    Padding="13,8" Margin="0,0,10,0"
                    Background="{DynamicResource VaultPanelRaised}"
                    Foreground="{DynamicResource VaultText}"/>
            <Button x:Name="ConfirmButton" Content="Clear selected inventory"
                    Click="OnConfirmClicked" IsEnabled="False"
                    Padding="13,8"
                    Background="#663438"
                    Foreground="{DynamicResource VaultText}"
                    BorderBrush="{DynamicResource VaultWarning}"/>
        </StackPanel>
    </Grid>
</Window>