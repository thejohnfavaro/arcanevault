<Window x:Class="ArcaneVault.Next.Desktop.NativeCardDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault — Card Details"
        Width="960" Height="700" MinWidth="720" MinHeight="555"
        Background="{StaticResource VaultBackground}"
        Foreground="{StaticResource VaultText}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="CARD DETAILS" Style="{StaticResource VaultEyebrow}"
                       Margin="0,0,0,7"/>
            <TextBlock x:Name="CardName"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource VaultText}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The original WebView viewer gave artwork strong presence.
                 Artwork is loaded on demand ONLY inside this details dialog;
                 no catalog list triggers per-row network image requests. -->
            <Border Grid.Column="0" Style="{StaticResource VaultPanelCard}"
                    Padding="14" VerticalAlignment="Top">
                <StackPanel>
                    <Border Height="384" CornerRadius="12"
                            BorderBrush="{StaticResource VaultAccentBorder}"
                            BorderThickness="1" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#342B51" Offset="0"/>
                                <GradientStop Color="#1B2336" Offset="0.65"/>
                                <GradientStop Color="#121722" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel x:Name="ArtworkFallback"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="✦" FontSize="80"
                                           Foreground="{StaticResource VaultAccent}"
                                           Opacity="0.6" TextAlignment="Center"/>
                                <TextBlock Text="ARCANE VAULT"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource VaultMuted}"
                                           TextAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="CardArtwork"
                                   Visibility="Collapsed" Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ArtworkStatus" TextWrapping="Wrap"
                               Foreground="{StaticResource VaultMuted}"
                               FontSize="11" Margin="4,12,4,0"
                               Text="Checking cached Scryfall artwork…"/>
                    <Button x:Name="OpenArtworkGalleryButton" Content="Browse printings &amp; artwork"
                            Click="OnOpenArtworkGalleryClicked"
                            Padding="11,9" Margin="3,12,3,0"
                            Background="{StaticResource VaultAccentSurface}"
                            Foreground="{StaticResource VaultText}"
                            BorderBrush="{StaticResource VaultAccentBorder}"
                            ToolTip="Explore official Scryfall printings; choose saved display artwork without changing ownership"/>
                    <Button x:Name="BookmarkCardButton"
                            Content="☆  Bookmark in My Shortlist"
                            Click="OnBookmarkClicked"
                            Padding="11,9" Margin="3,9,3,0"
                            Background="{StaticResource VaultPanelRaised}"
                            Foreground="{StaticResource VaultText}"
                            BorderBrush="{StaticResource VaultLine}"
                            ToolTip="Save or remove this card name from your planning shortlist; never changes owned copies"/>
                    <TextBlock x:Name="BookmarkStatus"
                               Foreground="{StaticResource VaultMuted}"
                               TextWrapping="Wrap" FontSize="11"
                               Margin="4,5,4,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource VaultPanelCard}"
                        Margin="0,0,0,13" Padding="17">
                    <StackPanel>
                        <TextBlock Style="{StaticResource VaultEyebrow}"
                                   Text="YOUR OWNERSHIP" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Ownership"
                                   FontSize="13" Foreground="{StaticResource VaultGood}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource VaultPanelCard}"
                        Margin="0,0,0,13" Padding="17">
                    <StackPanel>
                        <TextBlock Style="{StaticResource VaultEyebrow}"
                                   Text="CARD METADATA" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CardMetadata"
                                   Foreground="{StaticResource VaultText}"
                                   TextWrapping="Wrap" FontSize="12.5"/>
                        <!-- The Scryfall database stores format legalities as JSON.
                             Never render its raw serialization to the user. -->
                        <Expander IsExpanded="True" Margin="0,13,0,0"
                                  Foreground="{StaticResource VaultText}">
                            <Expander.Header>
                                <TextBlock x:Name="LegalitySummary"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource VaultAccent}"
                                           FontSize="12"
                                           Text="FORMAT LEGALITIES"/>
                            </Expander.Header>
                            <StackPanel Margin="0,9,0,0">
                                <TextBlock x:Name="LegalityNotice"
                                           Text="Cached Scryfall data · verify current bans before play"
                                           Foreground="{StaticResource VaultMuted}"
                                           TextWrapping="Wrap"
                                           FontSize="11" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="156">
                                    <ItemsControl x:Name="LegalityRows">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource VaultPanelRaised}"
                                                        BorderBrush="{StaticResource VaultLine}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="8,6" Margin="0,0,9,7">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   DockPanel.Dock="Right"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11.5"
                                                                   Margin="8,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource VaultMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="legal">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{StaticResource VaultGood}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="banned">
                                                                            <Setter Property="Foreground" Value="#F0A9C4"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="restricted">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{StaticResource VaultWarning}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="unknown">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{StaticResource VaultWarning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource VaultText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"
                                                                   FontSize="11.5"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource VaultPanelCard}"
                        Padding="17" MinHeight="140">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ORACLE TEXT"
                                   Style="{StaticResource VaultEyebrow}"
                                   Margin="0,0,0,11"/>
                        <TextBox Grid.Row="1" x:Name="OracleText"
                                 Background="{StaticResource VaultPanelRaised}"
                                 Foreground="{StaticResource VaultText}"
                                 BorderBrush="{StaticResource VaultLine}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="14,12" FontSize="13.5"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource VaultLine}"
                BorderThickness="0,1,0,0" Margin="0,15,0,0"
                Padding="0,12,0,0">
            <TextBlock Foreground="{StaticResource VaultMuted}"
                       FontSize="11" TextWrapping="Wrap"
                       Text="Art may be a different printing from the one you own. Saving a preferred image changes display only and creates a complete, recoverable native backup."/>
        </Border>
    </Grid>
</Window>