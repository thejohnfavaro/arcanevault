<Window x:Class="ArcaneVault.Next.Desktop.NativeCardDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcaneVault.Next.Desktop"
        Title="Arcane Vault — Card Details"
        Width="1140" Height="860" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Grid Margin="17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="CARD DETAILS" Style="{StaticResource VaultEyebrow}"
                       Margin="0,0,0,7"/>
            <TextBlock x:Name="CardName"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource VaultText}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="75"/>
            <Border HorizontalAlignment="Left" Margin="0,8,0,0"
                    Padding="10,4" CornerRadius="10"
                    Background="{DynamicResource VaultAccentSurface}"
                    BorderBrush="{DynamicResource VaultEdgeLift}" BorderThickness="1">
                <TextBlock x:Name="CardRarityBadge" Text="RARITY"
                           FontSize="11" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource VaultMuted}"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="uncommon">
                                    <Setter Property="Foreground" Value="#C9D1DD"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="rare">
                                    <Setter Property="Foreground" Value="#EDC875"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="mythic">
                                    <Setter Property="Foreground" Value="#FFAD79"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="CardContentGrid" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The original WebView viewer gave artwork strong presence.
                 Artwork is loaded on demand ONLY inside this details dialog;
                 no catalog list triggers per-row network image requests. -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource VaultElevatedPanel}"
                            Padding="8">
                        <StackPanel>
                    <Border x:Name="CardArtFrame" Height="445" CornerRadius="12"
                            Background="{DynamicResource VaultHeroWash}"
                            BorderBrush="{DynamicResource VaultEdgeLift}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <StackPanel x:Name="ArtworkFallback"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="✦" FontSize="80"
                                           Foreground="{DynamicResource VaultAccent}"
                                           Opacity="0.6" TextAlignment="Center"/>
                                <TextBlock Text="ARCANE VAULT"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource VaultMuted}"
                                           TextAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="CardArtwork"
                                   Visibility="Collapsed" Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ArtworkStatus" TextWrapping="Wrap"
                               Foreground="{DynamicResource VaultMuted}"
                               FontSize="11" Margin="4,12,4,0"
                               Text="Checking cached Scryfall artwork…"/>
                        </StackPanel>
                    </Border>
                    <!-- Keep ownership beside artwork and printings rather
                         than using the Oracle text column's vertical space. -->
                    <Border Style="{StaticResource VaultPanelCard}"
                            Padding="11,9" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource VaultEyebrow}"
                                       Text="YOUR OWNERSHIP" Margin="0,0,0,4"/>
                            <TextBlock x:Name="Ownership" FontSize="12"
                                       Foreground="{DynamicResource VaultGood}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="CardMetadataPanel"
                        Style="{StaticResource VaultElevatedPanel}"
                        Margin="0,0,0,10" Padding="12"
                        MaxHeight="230">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <TextBlock Style="{StaticResource VaultEyebrow}"
                                   Text="CARD METADATA" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CardMetadata"
                                   Foreground="{DynamicResource VaultText}"
                                   TextWrapping="Wrap" FontSize="12.5"/>
                        <!-- This is Scryfall COLOR IDENTITY, not casting mana cost.
                             Each glyph has a text name and an automation label. -->
                        <TextBlock Text="COLOR IDENTITY" Style="{StaticResource VaultEyebrow}"
                                   Margin="0,13,0,6"/>
                        <ItemsControl x:Name="ColorIdentitySymbols"
                                      AutomationProperties.Name="Card color identity mana symbols">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:NativeManaSymbol Symbol="{Binding Symbol}"
                                                            Width="27" Height="27"
                                                            Margin="0,0,6,0"
                                                            ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ColorIdentityLabel"
                                   Foreground="{DynamicResource VaultMuted}"
                                   TextWrapping="Wrap" FontSize="11.5"
                                   Margin="0,6,0,0"
                                   Text="Unknown color identity"/>
                        <!-- The Scryfall database stores format legalities as JSON.
                             Never render its raw serialization to the user. -->
                        <Expander IsExpanded="True" Margin="0,13,0,0"
                                  Foreground="{DynamicResource VaultText}">
                            <Expander.Header>
                                <TextBlock x:Name="LegalitySummary"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource VaultAccent}"
                                           FontSize="12"
                                           Text="FORMAT LEGALITIES"/>
                            </Expander.Header>
                            <StackPanel Margin="0,9,0,0">
                                <TextBlock x:Name="LegalityNotice"
                                           Text="Cached Scryfall data · verify current bans before play"
                                           Foreground="{DynamicResource VaultMuted}"
                                           TextWrapping="Wrap"
                                           FontSize="11" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="156">
                                    <ItemsControl x:Name="LegalityRows">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource VaultPanelRaised}"
                                                        BorderBrush="{DynamicResource VaultLine}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="8,6" Margin="0,0,9,7">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   DockPanel.Dock="Right"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11.5"
                                                                   Margin="8,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource VaultMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="legal">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource VaultGood}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="banned">
                                                                            <Setter Property="Foreground" Value="#F0A9C4"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="restricted">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource VaultWarning}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="unknown">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource VaultWarning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource VaultText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"
                                                                   FontSize="11.5"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource VaultElevatedPanel}"
                        Padding="14" MinHeight="190">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,9">
                            <Button DockPanel.Dock="Right" Content="Copy exact text"
                                    ToolTip="Copy original Oracle wording including {W}, {T}, and other symbol tokens"
                                    Click="OnCopyOracleClicked" Padding="10,5"
                                    Background="{DynamicResource VaultAccentSurface}"
                                    Foreground="{DynamicResource VaultText}"
                                    BorderBrush="{DynamicResource VaultAccentBorder}"/>
                            <TextBlock Text="ORACLE TEXT" VerticalAlignment="Center"
                                       Style="{StaticResource VaultEyebrow}"/>
                        </DockPanel>
                        <RichTextBox Grid.Row="1" x:Name="OracleText"
                                     Background="{DynamicResource VaultPanelRaised}"
                                     Foreground="{DynamicResource VaultText}"
                                     BorderBrush="{DynamicResource VaultLine}"
                                     IsReadOnly="True" IsDocumentEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Padding="12,9" FontSize="13.5"
                                     AutomationProperties.Name="Oracle text with official Magic symbol artwork"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Important actions remain visible at opening size. Only the
             long artwork/ownership, legalities and Oracle content scroll. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource VaultLine}"
                BorderThickness="0,1,0,0" Margin="0,10,0,0"
                Padding="0,9,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenArtworkGalleryButton" Grid.Row="0" Grid.Column="0"
                        Content="Browse printings &amp; artwork"
                        Click="OnOpenArtworkGalleryClicked" Padding="10,7" Margin="0,0,8,0"
                        Background="{DynamicResource VaultAccentSurface}"
                        Foreground="{DynamicResource VaultText}"
                        BorderBrush="{DynamicResource VaultAccentBorder}"
                        ToolTip="Explore official Scryfall printings; choose display art without changing ownership"/>
                <Button x:Name="BookmarkCardButton" Grid.Row="0" Grid.Column="1"
                        Content="☆  Bookmark in My Shortlist"
                        Click="OnBookmarkClicked" Padding="10,7" Margin="0,0,10,0"
                        Background="{DynamicResource VaultPanelRaised}"
                        Foreground="{DynamicResource VaultText}"
                        BorderBrush="{DynamicResource VaultLine}"
                        ToolTip="Save or remove from shortlist without changing owned copies"/>
                <TextBlock x:Name="BookmarkStatus" Grid.Row="0" Grid.Column="2"
                           Foreground="{DynamicResource VaultMuted}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="11"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                           Foreground="{DynamicResource VaultMuted}"
                           FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Display artwork may differ from your owned printing. Preferred-art changes preserve a recoverable native backup."/>
            </Grid>
        </Border>
    </Grid>
</Window>