                    <ScrollViewer x:Name="EdhImproveScroll" VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <StackPanel Margin="10,8,10,12">
                            <TextBlock Text="Collection-aware improvements" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource VaultAccent}"/>
                            <Border Background="{DynamicResource VaultPanelRaised}"
                                    BorderBrush="{DynamicResource VaultLine}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="DECK STRATEGY PRIORITY"
                                               FontWeight="SemiBold" FontSize="11"
                                               Foreground="{DynamicResource VaultAccent}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="EdhStrategyFocusBox"
                                              SelectionChanged="OnEdhStrategyFocusChanged"
                                              Background="{DynamicResource VaultPanel}"
                                              Foreground="{DynamicResource VaultText}"
                                              ToolTip="Choose which strategy matters most for card recommendations. This is an unsaved analysis preference; it will not modify your deck.">
                                        <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                        <ComboBoxItem Content="Faster starts" Tag="FastStart"/>
                                        <ComboBoxItem Content="Card advantage" Tag="CardAdvantage"/>
                                        <ComboBoxItem Content="Interaction &amp; protection" Tag="Interaction"/>
                                        <ComboBoxItem Content="Commander synergy" Tag="CommanderSynergy"/>
                                    </ComboBox>
                                    <TextBlock x:Name="EdhStrategyExplanation"
                                               TextWrapping="Wrap" FontSize="11"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource VaultMuted}"
                                               Text="Balance curve, scarce roles, and recognized commander mechanics."/>
                                    <TextBlock Text="Analysis only · not saved as a deck attribute · no automatic swaps"
                                               TextWrapping="Wrap" FontSize="10"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource VaultMuted}"/>
                                </StackPanel>
                            </Border>
                        <Expander x:Name="EdhMissingExpander"
                                  Header="Resolve missing cards — recorded alternatives"
                                  IsExpanded="True" Margin="0,2,0,9"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}"
                                  BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                                <TextBlock x:Name="EdhMissingHeadline"
                                           FontWeight="SemiBold" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,7"
                                           Foreground="{DynamicResource VaultAccent}"
                                           Text="Checking missing recorded copies…"/>
                                <ListBox x:Name="EdhMissingShortagesList"
                                         SelectionChanged="OnEdhMissingShortageSelected"
                                         DisplayMemberPath="Display"
                                         Height="114" Margin="0,0,0,6"
                                         Background="{DynamicResource VaultPanel}"
                                         Foreground="{DynamicResource VaultText}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"/>
                                <TextBlock x:Name="EdhMissingAlternativesStatus"
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Margin="0,0,0,5"
                                           Text="Choose a shortage to see recorded, format-eligible alternatives."/>
                                <ListBox x:Name="EdhMissingAlternativesList"
                                         SelectionChanged="OnEdhMissingAlternativeSelected"
                                         DisplayMemberPath="Display"
                                         Height="145" Margin="0,0,0,6"
                                         Background="{DynamicResource VaultPanel}"
                                         Foreground="{DynamicResource VaultText}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"/>
                                <TextBlock x:Name="EdhMissingAlternativeDetails"
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Margin="0,0,0,7"
                                           Text="Nothing will change until you explicitly confirm a swap."/>
                                <!-- Wrap to one column on narrow Deck Studio panes; do not
                                     stretch or clip the app's scrollable Improve tab. -->
                                <StackPanel x:Name="EdhMissingComparisonPanel"
                                            Visibility="Collapsed" Margin="0,4,0,10">
                                    <TextBlock Text="CARD-BY-CARD COMPARISON"
                                               Style="{StaticResource VaultEyebrow}"
                                               Margin="0,0,0,6"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Border Width="224" CornerRadius="8" Padding="9"
                                                Margin="0,0,8,8"
                                                Background="{DynamicResource VaultPanel}"
                                                BorderBrush="{DynamicResource VaultLine}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="CURRENT · MISSING"
                                                           Style="{StaticResource VaultEyebrow}"/>
                                                <TextBlock x:Name="EdhCompareSourceName"
                                                           TextWrapping="Wrap" FontWeight="SemiBold"
                                                           FontSize="13" Margin="0,5,0,3"/>
                                                <TextBlock x:Name="EdhCompareSourceType"
                                                           TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource VaultMuted}"/>
                                                <TextBlock x:Name="EdhCompareSourceManaValue"
                                                           FontSize="11" Foreground="{DynamicResource VaultMuted}"/>
                                                <FlowDocumentScrollViewer x:Name="EdhCompareSourceMana"
                                                           Height="30" IsToolBarVisible="False"
                                                           IsSelectionEnabled="True"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           VerticalScrollBarVisibility="Hidden"
                                                           HorizontalScrollBarVisibility="Disabled"/>
                                                <TextBlock x:Name="EdhCompareSourceRoles"
                                                           TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource VaultText}"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock x:Name="EdhCompareSourceInventory"
                                                           TextWrapping="Wrap" FontSize="10.5"
                                                           Foreground="{DynamicResource VaultMuted}"
                                                           Margin="0,4,0,6"/>
                                                <FlowDocumentScrollViewer x:Name="EdhCompareSourceOracle"
                                                           Height="135" IsToolBarVisible="False"
                                                           IsSelectionEnabled="True"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           VerticalScrollBarVisibility="Auto"
                                                           HorizontalScrollBarVisibility="Disabled"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="224" CornerRadius="8" Padding="9"
                                                Margin="0,0,0,8"
                                                Background="{DynamicResource VaultPanel}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="ALTERNATIVE · RECORDED"
                                                           Style="{StaticResource VaultEyebrow}"/>
                                                <TextBlock x:Name="EdhCompareCandidateName"
                                                           TextWrapping="Wrap" FontWeight="SemiBold"
                                                           FontSize="13" Margin="0,5,0,3"/>
                                                <TextBlock x:Name="EdhCompareCandidateType"
                                                           TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource VaultMuted}"/>
                                                <TextBlock x:Name="EdhCompareCandidateManaValue"
                                                           FontSize="11" Foreground="{DynamicResource VaultMuted}"/>
                                                <FlowDocumentScrollViewer x:Name="EdhCompareCandidateMana"
                                                           Height="30" IsToolBarVisible="False"
                                                           IsSelectionEnabled="True"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           VerticalScrollBarVisibility="Hidden"
                                                           HorizontalScrollBarVisibility="Disabled"/>
                                                <TextBlock x:Name="EdhCompareCandidateRoles"
                                                           TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource VaultText}"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock x:Name="EdhCompareCandidateInventory"
                                                           TextWrapping="Wrap" FontSize="10.5"
                                                           Foreground="{DynamicResource VaultMuted}"
                                                           Margin="0,4,0,6"/>
                                                <FlowDocumentScrollViewer x:Name="EdhCompareCandidateOracle"
                                                           Height="135" IsToolBarVisible="False"
                                                           IsSelectionEnabled="True"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           VerticalScrollBarVisibility="Auto"
                                                           HorizontalScrollBarVisibility="Disabled"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="WHY THIS RANKED HERE"
                                               Style="{StaticResource VaultEyebrow}"
                                               Margin="0,2,0,5"/>
                                    <TextBlock x:Name="EdhMissingRankingRationale"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource VaultText}"/>
                                    <TextBlock Text="Heuristic role matching is not a rules-equivalence, legality or deck-power guarantee."
                                               TextWrapping="Wrap" FontSize="10"
                                               Foreground="{DynamicResource VaultMuted}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <Expander x:Name="EdhMissingImpactPanel"
                                          Header="Projected whole-deck impact · read-only"
