<Window x:Class="ArcaneVault.Next.Desktop.NativeDeckEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault Next — Saved deck editor" Width="1280" Height="850"
        MinWidth="1030" MinHeight="650" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#0D1017" Foreground="#F0F1F6">
    <Window.Resources>
        <Style x:Key="VaultDeckTabStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#202737"/>
            <Setter Property="Foreground" Value="#DCE5F0"/>
            <Setter Property="BorderBrush" Value="#514276"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#514276"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DeckChartBarTemplate">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="#DBE2EE" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" Height="12" Minimum="0"
                             Maximum="{Binding Maximum}" Value="{Binding Count}"
                             Foreground="{Binding Fill}" Background="#283043"
                             BorderThickness="0" VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}"
                           Margin="6,0,0,0" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="#EDF2F7"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Create saved deck"
                   FontWeight="SemiBold" FontSize="21" Margin="0,0,0,7"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#B5B7CB"
                   Margin="0,0,0,8" Text="Edit a local deck with card browsing, mana and strategy tools. Review color identity, format legality and owned-card warnings before saving."/>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Deck name" Margin="0,0,0,6"/>
                <TextBox x:Name="DeckNameBox" Padding="10,8" FontSize="14"
                         Background="#202737" Foreground="White" BorderBrush="#514276"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Commander (optional)" Margin="0,0,0,6"/>
                <TextBox x:Name="CommanderBox" TextChanged="OnDraftChanged" Padding="10,8" FontSize="14"
                         Background="#202737" Foreground="White" BorderBrush="#514276"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Deck format" Margin="0,0,0,6"/>
                <ComboBox x:Name="FormatBox" IsEditable="True" SelectionChanged="OnFormatChanged"
                          Padding="6,7" FontSize="13"
                          Background="#D7E4EB" Foreground="#0D1017">
                    <ComboBoxItem Content="Commander"/>
                    <ComboBoxItem Content="Arena Brawl"/>
                    <ComboBoxItem Content="60-card"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12"
                    VerticalAlignment="Center">
            <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="FolderBox" Width="235" Padding="10,7"
                     Text="Unfiled"
                     Background="#202737" Foreground="White" BorderBrush="#514276"
                     ToolTip="Deck-library folder name (up to 64 characters)"/>
            <CheckBox x:Name="FavoriteDeckBox" Content="★ Favorite"
                      VerticalAlignment="Center" Margin="23,0,0,0"
                      Foreground="#E5BF79"
                      ToolTip="Show this deck first in the saved library"/>
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" MinWidth="275"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2.9*" MinWidth="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.8*" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Sort A–Z"
                            Click="OnSortMainboardClicked"
                            Padding="9,3" Margin="8,0,0,0"
                            Background="#202737" Foreground="White"
                            BorderBrush="#514276"
                            ToolTip="Sort the unsaved mainboard; rejects invalid lines rather than dropping them"/>
                    <TextBlock Text="Mainboard — click a card line to preview"
                               VerticalAlignment="Center" Foreground="#E5BF79"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Click a card line, or use Up/Down to move the caret, to view its official catalog card image and text in CARD PREVIEW. No deck or ownership changes."/>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="MainboardBox" TextChanged="OnDraftChanged"
                         SelectionChanged="OnMainboardSelectionChanged"
                         GotKeyboardFocus="OnMainboardGotKeyboardFocus"
                         PreviewMouseLeftButtonUp="OnMainboardMouseReleased"
                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontSize="14" FontFamily="Consolas"
                         Padding="12" Background="#171C28"
                         Foreground="#F2F5FA" BorderBrush="#514276"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="8" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#343A4D"/>
            <TabControl x:Name="EdhWorkspaceTabs" Grid.Column="2" TabStripPlacement="Top"
                        Background="#171C28" Foreground="#F2F5FA"
                        BorderBrush="{DynamicResource VaultLine}" Padding="3"
                        Loaded="OnEdhWorkspaceLoaded"
                        SizeChanged="OnEdhWorkspaceSizeChanged">
                <TabItem x:Name="EdhCardsTab" Header="Cards" Style="{StaticResource VaultDeckTabStyle}">
                    <Grid Margin="6,6,6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="OwnedCardsHeading" Text="Add from owned cards"
                               Foreground="{DynamicResource VaultAccent}"/>
                    <StackPanel x:Name="EdhSuggestionTools"
                                Visibility="Collapsed" Margin="0,8,0,0">
                        <Expander x:Name="EdhCardsFilters" Header="Filters &amp; commander matches"
                                  IsExpanded="False" Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}" BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                        <CheckBox x:Name="EdhRecordedOnly" Content="Recorded in my inventory only"
                                  Margin="0,0,0,7" IsChecked="True"
                                  Checked="OnEdhSuggestionsChanged"
                                  Unchecked="OnEdhSuggestionsChanged"/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,7">
                            <TextBlock Text="Role hints" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="EdhRoleBox" SelectedIndex="0"
                                      SelectionChanged="OnEdhSuggestionsChanged"
                                      Background="#D7E4EB" Foreground="#0D1017">
                                <ComboBoxItem Content="All roles" Tag=""/>
                                <ComboBoxItem Content="Lands" Tag="Land"/>
                                <ComboBoxItem Content="Ramp" Tag="Ramp"/>
                                <ComboBoxItem Content="Card Draw" Tag="Card Draw"/>
                                <ComboBoxItem Content="Removal" Tag="Removal"/>
                                <ComboBoxItem Content="Board Wipe" Tag="Board Wipe"/>
                                <ComboBoxItem Content="Tutor" Tag="Tutor"/>
                                <ComboBoxItem Content="Protection" Tag="Protection"/>
                                <ComboBoxItem Content="Token Maker" Tag="Token Maker"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox x:Name="EdhPrioritizeSynergy"
                                  Content="Commander mechanic matches first (owned first)"
                                  IsChecked="True" Margin="0,0,0,6"
                                  Checked="OnEdhSuggestionsChanged"
                                  Unchecked="OnEdhSuggestionsChanged"
                                  ToolTip="Advisory Oracle-text mechanic matches; does not estimate power or guarantee combos"/>
                        <CheckBox x:Name="EdhSynergyOnly"
                                  Content="Only show commander mechanic matches"
                                  Margin="0,0,0,6"
                                  Checked="OnEdhSuggestionsChanged"
                                  Unchecked="OnEdhSuggestionsChanged"/>
                        <TextBlock x:Name="EdhSynergyStatus" TextWrapping="Wrap"
                                   Margin="0,0,0,6" FontSize="11"
                                   Foreground="{DynamicResource VaultText}"
                                   Text="Reading cached commander text for mechanic matches…"/>
                        <TextBlock x:Name="EdhSuggestionsStatus" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource VaultMuted}"
                                   Text="Local color-identity and legality suggestions loading…"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
                <ComboBox Grid.Row="1" x:Name="OwnedPoolBox"
                          SelectionChanged="OnOwnedPoolChanged"
                          Background="#D7E4EB" Foreground="#0D1017"
                          Margin="0,0,0,8">
                    <ComboBoxItem Content="Physical collection"/>
                    <ComboBoxItem Content="Arena collection"/>
                </ComboBox>
                <TextBox Grid.Row="2" x:Name="OwnedSearchBox"
                         TextChanged="OnOwnedSearchChanged"
                         Padding="9,7" Margin="0,0,0,8"
                         ToolTip="Filter owned card names; shows up to 200 matches"
                         Background="#202737" Foreground="White"
                         BorderBrush="#514276"/>
                <ListBox Grid.Row="3" x:Name="OwnedCardsList"
                         DisplayMemberPath="Display"
                         SelectionChanged="OnOwnedCardSelectionChanged"
                         MouseDoubleClick="OnOwnedCardDoubleClicked"
                         Background="#171C28" Foreground="#F2F5FA"
                         BorderBrush="#514276"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add (+1)" Click="OnAddOwnedClicked"
                            Padding="10,7" Margin="0,0,7,0"
                            Background="#202737" Foreground="White" BorderBrush="#514276"/>
                    <Button Content="Remove (−1)" Click="OnRemoveOwnedClicked"
                            Padding="10,7"
                            Background="#202737" Foreground="White" BorderBrush="#514276"
                            ToolTip="Decrease the selected card's count in the unsaved deck; does not change ownership"/>
                </StackPanel>
                <TextBlock Grid.Row="5" x:Name="DeckSummaryText" Margin="0,12,0,5"
                           TextWrapping="Wrap" Foreground="#E5BF79"
                           Text="Deck totals will appear here."/>
                <StackPanel Grid.Row="6">
                    <TextBlock x:Name="DeckShortageText"
                               TextWrapping="Wrap" Foreground="#C9A9A9"
                               MaxHeight="100"
                               ToolTip="Only the selected ownership pool is counted; missing copies are not auto-added."/>
                    <TextBlock x:Name="EdhLegalityText"
                               TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"
                               Foreground="{DynamicResource VaultWarning}"/>
                </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="EdhManaTab" Header="Mana &amp; Roles" Visibility="Collapsed"
                         Style="{StaticResource VaultDeckTabStyle}">
                    <!-- Height is bounded at runtime to the available tab viewport;
                         expanding multiple sections scrolls instead of overflowing. -->
                    <ScrollViewer x:Name="EdhManaScroll" VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <StackPanel Margin="10,8,10,12">
                            <TextBlock Text="Mana base &amp; deck roles" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource VaultAccent}"/>
                        <Border Margin="0,8,0,0" Padding="9" CornerRadius="7"
                                Background="{DynamicResource VaultPanelRaised}"
                                BorderBrush="{DynamicResource VaultLine}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DECK BLUEPRINT" FontWeight="SemiBold"
                                           FontSize="11" Foreground="{DynamicResource VaultAccent}"/>
                                <TextBlock x:Name="EdhBlueprintText" Margin="0,5,0,6"
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultText}"
                                           Text="Loading suggested role coverage…"/>
                                <Button x:Name="EdhFindGapButton" Content="Find next role"
                                        Click="OnEdhFindGapClicked" IsEnabled="False"
                                        HorizontalAlignment="Left" Padding="9,5"
                                        Foreground="{DynamicResource VaultText}"
                                        Background="{DynamicResource VaultAccentMuted}"
                                        BorderBrush="{DynamicResource VaultAccentBorder}"
                                        ToolTip="Browse collection-owned eligible cards for the largest relative role gap; does not add or save cards"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="EdhManaHeadline" Margin="0,8,0,3"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource VaultAccent}"
                                   Text="Mana base: evaluating local deck…"/>
                        <Expander Header="Arena-style land balancing" IsExpanded="True"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}"
                                  BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Text="Auto mode changes only regular basic-land counts in this unsaved draft. New EDH drafts start with auto mode enabled; saved decks are opt-in. Existing nonbasic and snow lands are preserved."/>
                                <WrapPanel Margin="0,8,0,5" Orientation="Horizontal">
                                    <CheckBox x:Name="EdhAutoBalanceLands"
                                              Content="Auto-balance basics"
                                              VerticalAlignment="Center"
                                              Margin="0,0,9,5"
                                              Checked="OnEdhAutoBalanceChanged"
                                              Unchecked="OnEdhAutoBalanceChanged"/>
                                    <TextBlock Text="Land target"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,5"/>
                                    <TextBox x:Name="EdhLandTargetBox"
                                             Width="38" Text="36" Padding="3,3"
                                             Margin="0,0,8,5"
                                             Background="{DynamicResource VaultPanel}"
                                             Foreground="{DynamicResource VaultText}"
                                             TextChanged="OnEdhLandTargetChanged"
                                             ToolTip="Target 20–60 lands. The 99-card mainboard limit is always respected."/>
                                    <Button x:Name="EdhBalanceNowButton" Content="Balance now"
                                            Click="OnEdhBalanceNowClicked"
                                            Margin="0,0,0,5" Padding="7,3"
                                            Background="{DynamicResource VaultAccentMuted}"
                                            Foreground="{DynamicResource VaultText}"
                                            BorderBrush="{DynamicResource VaultAccentBorder}"/>
                                </WrapPanel>
                                <CheckBox x:Name="EdhWeightSpellPips"
                                          Content="Weight basics by spell mana symbols"
                                          IsChecked="True" Margin="0,1,0,6"
                                          Checked="OnEdhPipModeChanged"
                                          Unchecked="OnEdhPipModeChanged"
                                          ToolTip="Smoothed colored mana requirements of nonland spells; requires a refreshed native Scryfall catalog, otherwise falls back to even split"/>
                                <TextBlock x:Name="EdhManaDetails" TextWrapping="Wrap"
                                           FontSize="11" Foreground="{DynamicResource VaultText}"
                                           Text="Loading land advice…"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="EdhCurveHeadline" Margin="0,10,0,3"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource VaultAccent}"
                                   Text="Curve and casting consistency: evaluating draft…"/>
                        <Expander Header="Mana curve &amp; casting consistency" IsExpanded="True"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}"
                                  BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Margin="0,0,0,6"
                                           Text="Read-only estimates: natural land drops from a 7-card opener with no mulligans; colored-source warnings are separate, approximate signals, not complete casting probabilities."/>
                                <TextBlock x:Name="EdhCurveDetails"
                                           FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource VaultText}"
                                           Text="Waiting for local card metadata…"/>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="EdhImproveTab" Header="Improve" Visibility="Collapsed"
                         Style="{StaticResource VaultDeckTabStyle}">
                    <ScrollViewer x:Name="EdhImproveScroll" VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <StackPanel Margin="10,8,10,12">
                            <TextBlock Text="Collection-aware improvements" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource VaultAccent}"/>
                            <Border Background="{DynamicResource VaultPanelRaised}"
                                    BorderBrush="{DynamicResource VaultLine}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="DECK STRATEGY PRIORITY"
                                               FontWeight="SemiBold" FontSize="11"
                                               Foreground="{DynamicResource VaultAccent}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="EdhStrategyFocusBox"
                                              SelectionChanged="OnEdhStrategyFocusChanged"
                                              Background="{DynamicResource VaultPanel}"
                                              Foreground="{DynamicResource VaultText}"
                                              ToolTip="Choose which strategy matters most for card recommendations. This is an unsaved analysis preference; it will not modify your deck.">
                                        <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                        <ComboBoxItem Content="Faster starts" Tag="FastStart"/>
                                        <ComboBoxItem Content="Card advantage" Tag="CardAdvantage"/>
                                        <ComboBoxItem Content="Interaction &amp; protection" Tag="Interaction"/>
                                        <ComboBoxItem Content="Commander synergy" Tag="CommanderSynergy"/>
                                    </ComboBox>
                                    <TextBlock x:Name="EdhStrategyExplanation"
                                               TextWrapping="Wrap" FontSize="11"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource VaultMuted}"
                                               Text="Balance curve, scarce roles, and recognized commander mechanics."/>
                                    <TextBlock Text="Analysis only · not saved as a deck attribute · no automatic swaps"
                                               TextWrapping="Wrap" FontSize="10"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource VaultMuted}"/>
                                </StackPanel>
                            </Border>
                        <TextBlock x:Name="EdhOptimizationHeadline"
                                   Margin="0,10,0,3" TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource VaultAccent}"
                                   Text="Optimization: evaluating owned early spells…"/>
                        <Expander Header="Collection-aware deck optimization" IsExpanded="True"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}"
                                  BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Margin="0,0,0,7"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Text="Advisory curve thresholds, never automatic cuts. Suggestions come only from locally eligible, unused recorded cards for this deck's format and color identity."/>
                                <TextBlock x:Name="EdhOptimizationDetails"
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultText}"
                                           Text="Loading recorded improvement candidates…"/>
                                <Button x:Name="EdhBrowseImprovementsButton"
                                        Content="Browse owned early-play candidates"
                                        Click="OnEdhBrowseImprovementsClicked"
                                        IsEnabled="False" Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Padding="9,5"
                                        Background="{DynamicResource VaultAccentMuted}"
                                        Foreground="{DynamicResource VaultText}"
                                        BorderBrush="{DynamicResource VaultAccentBorder}"
                                        ToolTip="Filter the existing EDH Lab card browser to owned, format-eligible early-play options; does not swap, remove, add, craft or save anything"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Commander synergy packages — preview only"
                                  IsExpanded="False" Margin="0,3,0,9"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}"
                                  BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                                <TextBlock Text="MECHANIC" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VaultAccent}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="EdhPackageThemeBox" Margin="0,0,0,6"
                                          SelectionChanged="OnEdhPackageThemeChanged"
                                          Background="{DynamicResource VaultPanel}"
                                          Foreground="{DynamicResource VaultText}"
                                          ToolTip="Choose one recognized commander mechanic or show all."/>
                                <TextBlock x:Name="EdhPackagesStatus" TextWrapping="Wrap"
                                           FontSize="11" Margin="0,0,0,7"
                                           Foreground="{DynamicResource VaultText}"
                                           Text="Reading cached commander mechanics…"/>
                                <ListBox x:Name="EdhPackagesList" Height="166"
                                         SelectionChanged="OnEdhPackageSelectionChanged"
                                         Background="{DynamicResource VaultPanel}"
                                         Foreground="{DynamicResource VaultText}"
                                         BorderBrush="{DynamicResource VaultAccentBorder}"
                                         DisplayMemberPath="Display"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="EdhPackagePreviewText"
                                           TextWrapping="Wrap" FontSize="11"
                                           Margin="0,7,0,0"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Text="Select a package card to preview its exact text and artwork. Nothing is added, crafted, removed or saved."/>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="EdhSwapHeadline" Margin="0,10,0,3"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource VaultAccent}"
                                   Text="Swap Lab: checking role-aware cuts…"/>
                        <Expander Header="Swap Lab — review one-for-one edits"
                                  IsExpanded="True"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}"
                                  BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Margin="0,0,0,7"
                                           Text="Opt-in, heuristic swaps only. Suggestions use unused owned cards, keep locally tracked critical roles and identified commander synergy, and never edit the saved deck or collection."/>
                                <TextBlock x:Name="EdhSwapStatus" TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource VaultText}"
                                           Text="Waiting for eligible deck suggestions…"/>
                                <ListBox x:Name="EdhSwapProposalsList" Height="116"
                                         Margin="0,7,0,4"
                                         DisplayMemberPath="Display"
                                         SelectionChanged="OnEdhSwapSelectionChanged"
                                         Background="{DynamicResource VaultPanel}"
                                         Foreground="{DynamicResource VaultText}"
                                         BorderBrush="{DynamicResource VaultLine}"/>
                                <TextBlock x:Name="EdhSwapPreviewText"
                                           Margin="0,5,0,7" TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource VaultMuted}"
                                           Text="Select a proposed cut and replacement to inspect the tradeoff."/>
                                <Button x:Name="EdhApplySwapButton"
                                        Content="Apply selected swap to unsaved draft…"
                                        Click="OnEdhApplySwapClicked"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left" Padding="9,6"
                                        Background="{DynamicResource VaultAccentMuted}"
                                        Foreground="{DynamicResource VaultText}"
                                        BorderBrush="{DynamicResource VaultAccentBorder}"
                                        ToolTip="Requires explicit confirmation; protected native Review and Save is still separate"/>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="3" Width="8" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#343A4D"/>
            <Border Grid.Column="4" CornerRadius="9" Padding="12"
                    Background="#171C28" BorderBrush="#514276" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CARD PREVIEW" FontSize="11"
                               Foreground="#E5BF79" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="PreviewCardName" Grid.Row="1"
                               FontSize="15" FontWeight="SemiBold" Foreground="#F0F1F6"
                               TextWrapping="Wrap" Text="Select an owned card"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="PreviewOwnership" Grid.Row="2"
                               FontSize="11" Foreground="#70B992"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border CornerRadius="7" Background="#242A3C"
                                    BorderBrush="#514276" BorderThickness="1"
                                    Padding="6" HorizontalAlignment="Center">
                                <Grid Width="152" Height="210">
                                    <TextBlock x:Name="PreviewArtFallback"
                                               Text="ARCANE VAULT&#10;Card artwork"
                                               TextAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#9DA9BD" FontSize="12"/>
                                    <Image x:Name="PreviewArtwork" Visibility="Collapsed"
                                           Stretch="Uniform" SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PreviewSynergyText" Margin="0,9,0,4"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource VaultAccent}"
                                       Text="Commander mechanic matches appear here."/>
                            <TextBlock x:Name="PreviewMetadata" Margin="0,9,0,4"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="#D8DEEB"
                                       Text="Select a card to see local catalog information."/>
                            <TextBlock x:Name="PreviewOracleText" Margin="0,3,0,0"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="#B5C1D3"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="PreviewStatus" Grid.Row="4"
                               Margin="0,8,0,0" FontSize="10"
                               Foreground="#9DA9BD" TextWrapping="Wrap"
                               Text="Preview is read-only. Artwork is illustrative, not proof of an owned printing."/>
                </Grid>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="5" Margin="0,10,0,0">
            <Button Content="Import .txt" Click="OnImportTextClicked"
                    Padding="11,8" Margin="0,0,8,4"
                    Background="#202737" Foreground="White" BorderBrush="#514276"/>
            <Button Content="Paste Arena list" Click="OnPasteDeckClicked"
                    Padding="11,8" Margin="0,0,8,4"
                    Background="#202737" Foreground="White" BorderBrush="#514276"/>
            <Button Content="Copy Arena list" Click="OnCopyDeckClicked"
                    Padding="11,8" Margin="0,0,8,4"
                    Background="#202737" Foreground="White" BorderBrush="#514276"/>
            <Button Content="Export .txt" Click="OnExportTextClicked"
                    Padding="11,8" Margin="0,0,8,4"
                    Background="#202737" Foreground="White" BorderBrush="#514276"/>
            <Button x:Name="AnalyzeDeckButton" Content="Analyze deck"
                    Click="OnAnalyzeDeckClicked" Padding="11,8" Margin="0,0,8,4"
                    Background="#473A70" Foreground="White" BorderBrush="#7663B3"/>
        </WrapPanel>
        <Grid Grid.Row="6" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Expander x:Name="AnalyticsPanel" Grid.Row="0"
                      IsExpanded="False" MaxHeight="310"
                      Background="#171C28" BorderBrush="#514276"
                      BorderThickness="1" Padding="8">
                <Expander.Header>
                    <TextBlock Text="Deck analytics · mana curve / color identity / card types"
                               FontWeight="SemiBold" Foreground="#E5BF79"/>
                </Expander.Header>
                <StackPanel Margin="6,8,6,4">
                    <TextBlock x:Name="AnalyticsText" TextWrapping="Wrap"
                               Foreground="#B8D8D0" FontSize="12"
                               Text="Select Analyze deck to load offline deck statistics."/>
                    <ScrollViewer MaxHeight="226" Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="AnalyticsCharts" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MANA CURVE" Foreground="#E5BF79"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ManaCurveBars"
                                              ItemTemplate="{StaticResource DeckChartBarTemplate}"/>
                                <TextBlock x:Name="AverageManaText" Margin="0,7,0,0"
                                           FontSize="11" Foreground="#B5C1D3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COLOR IDENTITY" Foreground="#E5BF79"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ColorIdentityBars"
                                              ItemTemplate="{StaticResource DeckChartBarTemplate}"/>
                                <TextBlock Text="Exclusive identity groups, by copies"
                                           Margin="0,7,0,0" FontSize="11"
                                           Foreground="#B5C1D3" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="CARD TYPES" Foreground="#E5BF79"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="CardTypeBars"
                                              ItemTemplate="{StaticResource DeckChartBarTemplate}"/>
                                <TextBlock Text="One primary type per card copy"
                                           Margin="0,7,0,0" FontSize="11"
                                           Foreground="#B5C1D3" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Expander>
            <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,6,0,0"
                       Foreground="#9DA9BD" TextWrapping="Wrap"
                       Text="Every successful save retains the complete previous native collection as a recovery file."/>
        </Grid>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True"
                    Padding="18,10" Margin="0,0,12,0"
                    Background="#202737" Foreground="White" BorderBrush="#514276"/>
            <Button x:Name="SaveDeckButton" Content="Review and save deck"
                    Click="OnSaveDeckClicked" Padding="18,10"
                    Background="#7663B3" Foreground="White" BorderBrush="#B59BFC"/>
        </StackPanel>
    </Grid>
</Window>