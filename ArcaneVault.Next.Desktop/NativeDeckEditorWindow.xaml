<Window x:Class="ArcaneVault.Next.Desktop.NativeDeckEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcaneVault.Next.Desktop"
        Title="Arcane Vault Next — Saved deck editor" Width="1280" Height="850"
        MinWidth="1030" MinHeight="650" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Window.Resources>
        <!-- Explicit tab header template prevents default WPF theme brushes from
             turning the selected header white-on-white in light system themes. -->
        <Style x:Key="VaultDeckTabStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#252E3E"/>
            <Setter Property="Foreground" Value="#E5ECF7"/>
            <Setter Property="BorderBrush" Value="#586477"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabHeaderChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeaderChrome" Property="Background" Value="#314F69"/>
                                <Setter TargetName="TabHeaderChrome" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccentSurface}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabHeaderChrome" Property="Background" Value="#3A475A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabHeaderChrome" Property="BorderBrush" Value="#F0BB73"/>
                                <Setter TargetName="TabHeaderChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#99A4B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DeckChartBarTemplate">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="#DBE2EE" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" Height="12" Minimum="0"
                             Maximum="{Binding Maximum}" Value="{Binding Count}"
                             Foreground="{Binding Fill}" Background="#283043"
                             BorderThickness="0" VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}"
                           Margin="6,0,0,0" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="#EDF2F7"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Create saved deck"
                   Foreground="{DynamicResource VaultText}"
                   FontWeight="Bold" FontSize="25" Margin="0,0,0,7"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}"
                   Margin="0,0,0,8" Text="Edit a local deck with card browsing, mana and strategy tools. Review color identity, format legality and owned-card warnings before saving."/>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Deck name" Margin="0,0,0,6"/>
                <TextBox x:Name="DeckNameBox" Padding="10,8" FontSize="14"
                         Background="{DynamicResource VaultPanelRaised}"
                         Foreground="{DynamicResource VaultText}"
                         BorderBrush="{DynamicResource VaultEdgeLift}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Commander (optional)" Margin="0,0,0,6"/>
                <TextBox x:Name="CommanderBox" TextChanged="OnDraftChanged" Padding="10,8" FontSize="14"
                         Background="{DynamicResource VaultPanelRaised}"
                         Foreground="{DynamicResource VaultText}"
                         BorderBrush="{DynamicResource VaultEdgeLift}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Deck format" Margin="0,0,0,6"/>
                <ComboBox x:Name="FormatBox" IsEditable="True" SelectionChanged="OnFormatChanged"
                          Padding="6,7" FontSize="13"
                          Background="#D7E4EB" Foreground="#0D1017">
                    <ComboBoxItem Content="Commander"/>
                    <ComboBoxItem Content="Arena Brawl"/>
                    <ComboBoxItem Content="60-card"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12"
                    VerticalAlignment="Center">
            <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="FolderBox" Width="235" Padding="10,7"
                     Text="Unfiled"
                     Background="{DynamicResource VaultPanelRaised}"
                     Foreground="{DynamicResource VaultText}"
                     BorderBrush="{DynamicResource VaultEdgeLift}"
                     ToolTip="Deck-library folder name (up to 64 characters)"/>
            <CheckBox x:Name="FavoriteDeckBox" Content="★ Favorite"
                      VerticalAlignment="Center" Margin="23,0,0,0"
                      Foreground="#E5BF79"
                      ToolTip="Show this deck first in the saved library"/>
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" MinWidth="275"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2.9*" MinWidth="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.8*" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Sort A–Z"
                            Click="OnSortMainboardClicked"
                            Padding="9,3" Margin="8,0,0,0"
                            Background="#202737" Foreground="White"
                            BorderBrush="#514276"
                            ToolTip="Sort the unsaved mainboard; rejects invalid lines rather than dropping them"/>
                    <TextBlock Text="Mainboard — manage cards or edit text"
                               VerticalAlignment="Center" Foreground="#E5BF79"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="EDH Lab: select a card in Manage to preview and adjust its unsaved count. Text remains the authoritative deck list."/>
                </DockPanel>
                <TabControl Grid.Row="1" x:Name="MainboardModes"
                            Background="{DynamicResource VaultPanel}"
                            Foreground="{DynamicResource VaultText}"
                            BorderBrush="{DynamicResource VaultEdgeLift}">
                    <TabItem x:Name="MainboardManageTab" Header="Manage"
                             Style="{StaticResource VaultDeckTabStyle}"
                             Visibility="Collapsed">
                        <Grid Margin="8,10,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="MainboardFilterBox" Grid.Column="0"
                                          SelectedIndex="0" FontSize="11"
                                          SelectionChanged="OnMainboardManagerFilterChanged"
                                          Background="#D7E4EB" Foreground="#0D1017"
                                          ToolTip="Show all cards or a particular type of card in the unsaved mainboard">
                                    <ComboBoxItem Content="All cards" Tag="All"/>
                                    <ComboBoxItem Content="Lands" Tag="Lands"/>
                                    <ComboBoxItem Content="Creatures" Tag="Creatures"/>
                                    <ComboBoxItem Content="Artifacts" Tag="Artifacts"/>
                                    <ComboBoxItem Content="Enchantments" Tag="Enchantments"/>
                                    <ComboBoxItem Content="Instants &amp; sorceries" Tag="Spells"/>
                                    <ComboBoxItem Content="Other / unverified" Tag="Other"/>
                                </ComboBox>
                                <ComboBox x:Name="MainboardSortBox" Grid.Column="2"
                                          SelectedIndex="0" FontSize="11"
                                          SelectionChanged="OnMainboardManagerFilterChanged"
                                          Background="#D7E4EB" Foreground="#0D1017"
                                          ToolTip="Organize the visual view; sorting does not rewrite the source deck list">
                                    <ComboBoxItem Content="By card type" Tag="Type"/>
                                    <ComboBoxItem Content="Name A–Z" Tag="Name"/>
                                    <ComboBoxItem Content="Quantity ↓" Tag="Quantity"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Search mainboard · name, type or role"
                                       Margin="0,7,0,0" FontSize="10"
                                       Foreground="{DynamicResource VaultMuted}"/>
                            <TextBox x:Name="MainboardManagerSearchBox"
                                     Margin="0,3,0,0" Padding="8,6"
                                     MaxLength="255"
                                     TextChanged="OnMainboardManagerSearchChanged"
                                     ToolTip="Filter the unsaved mainboard by card name, type or role; never modifies deck contents"
                                     Background="#202737" Foreground="White"
                                     BorderBrush="#514276"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" x:Name="MainboardManagerStatus"
                                       Text="Visual mainboard loading…"
                                       Margin="0,0,0,7" FontSize="11"
                                       Foreground="{DynamicResource VaultMuted}"
                                       TextWrapping="Wrap"/>
                            <ListBox Grid.Row="2" x:Name="MainboardManagerList"
                                     SelectionChanged="OnMainboardManagerSelected"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     Background="{DynamicResource VaultPanelRaised}"
                                     Foreground="{DynamicResource VaultText}"
                                     BorderBrush="{DynamicResource VaultEdgeLift}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="5,6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="#252C3D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Virtualized row art: only a realized image may load.
                                                 Fallback remains visible when art is missing/offline. -->
                                            <Border Grid.RowSpan="2" Grid.Column="0"
                                                    Width="40" Height="56" CornerRadius="3"
                                                    Margin="0,0,8,0" ClipToBounds="True"
                                                    BorderBrush="{DynamicResource VaultLine}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource VaultPanel}">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="✦" FontSize="18"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource VaultMuted}"/>
                                                    <Image Loaded="OnMainboardThumbnailLoaded"
                                                           Unloaded="OnMainboardThumbnailUnloaded"
                                                           DataContextChanged="OnMainboardThumbnailContextChanged"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           ToolTip="Illustrative official card artwork; not proof of an owned printing"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding NameLabel}" FontSize="12"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource VaultText}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       Text="{Binding QuantityLabel}"
                                                       Margin="8,0,0,0" FontWeight="Bold"
                                                       Foreground="#E5BF79" VerticalAlignment="Bottom"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding DetailsLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource VaultMuted}"
                                                       FontSize="10" Margin="0,3,0,0"
                                                       VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="3" x:Name="MainboardManagerSelectedText"
                                       Text="Select a card to view its details and adjust its quantity."
                                       Margin="0,9,0,5" FontSize="11"
                                       Foreground="{DynamicResource VaultText}"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Grid.Row="4">
                                <Button x:Name="MainboardManagerMinus" Content="−1"
                                        Click="OnMainboardManagerMinusClicked" IsEnabled="False"
                                        Margin="0,0,6,4" Padding="10,6"
                                        Background="#202737" Foreground="White"
                                        BorderBrush="#514276"
                                        ToolTip="Reduce the selected card quantity by one"/>
                                <Button x:Name="MainboardManagerPlus" Content="+1"
                                        Click="OnMainboardManagerPlusClicked" IsEnabled="False"
                                        Margin="0,0,6,4" Padding="10,6"
                                        Background="#202737" Foreground="White"
                                        BorderBrush="#514276"
                                        ToolTip="Increase a selected card only when its local format copy limit allows"/>
                                <Button x:Name="MainboardManagerRemove" Content="Remove all"
                                        Click="OnMainboardManagerRemoveClicked" IsEnabled="False"
                                        Margin="0,0,0,4" Padding="9,6"
                                        Background="#202737" Foreground="White"
                                        BorderBrush="#514276"
                                        ToolTip="Remove every copy of the selected mainboard card (unsaved; does not remove owned copies)"/>
                            </WrapPanel>
                            <StackPanel Grid.Row="5" Margin="0,7,0,0">
                                <TextBlock Text="Deck-specific artwork printing"
                                           Foreground="{DynamicResource VaultAccent}"/>
                                <ComboBox x:Name="MainboardPrintingBox" IsEnabled="False"
                                          DisplayMemberPath="Display" Background="#D7E4EB"
                                          Foreground="#0D1017" Margin="0,4,0,4"/>
                                <Button x:Name="MainboardPrintingApply" Content="Use selected printing"
                                        Click="OnMainboardPrintingApplyClicked" IsEnabled="False"
                                        Padding="9,5" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="MainboardPrintingStatus"
                                           Text="Select a mainboard card to browse available printings."
                                           TextWrapping="Wrap" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource VaultMuted}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="MainboardTextTab" Header="Text"
                             Style="{StaticResource VaultDeckTabStyle}">
                        <TextBox x:Name="MainboardBox" TextChanged="OnDraftChanged"
                                 SelectionChanged="OnMainboardSelectionChanged"
                                 GotKeyboardFocus="OnMainboardGotKeyboardFocus"
                                 PreviewMouseLeftButtonUp="OnMainboardMouseReleased"
                                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontSize="14" FontFamily="Consolas"
                                 Padding="12" Background="{DynamicResource VaultPanel}"
                                 Foreground="{DynamicResource VaultText}"
                                 BorderBrush="{DynamicResource VaultEdgeLift}"/>
                    </TabItem>
                </TabControl>
            </Grid>
            <GridSplitter Grid.Column="1" Width="8" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#343A4D"/>
            <TabControl x:Name="EdhWorkspaceTabs" Grid.Column="2" TabStripPlacement="Top"
                        Background="{DynamicResource VaultPanel}"
                        Foreground="{DynamicResource VaultText}"
                        BorderBrush="{DynamicResource VaultEdgeLift}" Padding="3"
                        Loaded="OnEdhWorkspaceLoaded"
                        SizeChanged="OnEdhWorkspaceSizeChanged">
                <TabItem x:Name="EdhCardsTab" Header="Cards" Style="{StaticResource VaultDeckTabStyle}">
                    <Grid Margin="6,6,6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="OwnedCardsHeading" Text="Add from owned cards"
                               Foreground="{DynamicResource VaultAccent}"/>
                    <StackPanel x:Name="EdhSuggestionTools"
                                Visibility="Collapsed" Margin="0,8,0,0">
                        <Expander x:Name="EdhCardsFilters" Header="Filters &amp; commander matches"
                                  IsExpanded="False" Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}" BorderThickness="1" Padding="7">
                            <StackPanel Margin="0,5,0,3">
                        <CheckBox x:Name="EdhRecordedOnly" Content="Recorded in my inventory only"
                                  Margin="0,0,0,7" IsChecked="True"
                                  Checked="OnEdhSuggestionsChanged"
                                  Unchecked="OnEdhSuggestionsChanged"/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,7">
                            <TextBlock Text="Deck status" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="EdhCardPresenceBox" SelectedIndex="0"
                                      SelectionChanged="OnEdhCardPresenceChanged"
                                      Background="#D7E4EB" Foreground="#0D1017"
                                      ToolTip="Available: recorded eligible names not yet in the unsaved mainboard. In deck: eligible cards already in the mainboard (including unowned cards).">
                                <ComboBoxItem Content="Available · not in deck" Tag="Available"/>
                                <ComboBoxItem Content="In deck" Tag="InDeck"/>
                                <ComboBoxItem Content="All eligible" Tag="All"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,7">
                            <TextBlock Text="Role hints" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="EdhRoleBox" SelectedIndex="0"
                                      SelectionChanged="OnEdhSuggestionsChanged"
                                      Background="#D7E4EB" Foreground="#0D1017">
                                <ComboBoxItem Content="All roles" Tag=""/>
                                <ComboBoxItem Content="Lands" Tag="Land"/>
                                <ComboBoxItem Content="Ramp" Tag="Ramp"/>
                                <ComboBoxItem Content="Card Draw" Tag="Card Draw"/>
                                <ComboBoxItem Content="Removal" Tag="Removal"/>
                                <ComboBoxItem Content="Board Wipe" Tag="Board Wipe"/>
                                <ComboBoxItem Content="Tutor" Tag="Tutor"/>
                                <ComboBoxItem Content="Protection" Tag="Protection"/>
                                <ComboBoxItem Content="Token Maker" Tag="Token Maker"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox x:Name="EdhPrioritizeSynergy"
                                  Content="Commander mechanic matches first (owned first)"
                                  IsChecked="True" Margin="0,0,0,6"
                                  Checked="OnEdhSuggestionsChanged"
                                  Unchecked="OnEdhSuggestionsChanged"
                                  ToolTip="Advisory Oracle-text mechanic matches; does not estimate power or guarantee combos"/>
                        <CheckBox x:Name="EdhSynergyOnly"
                                  Content="Only show commander mechanic matches"
                                  Margin="0,0,0,6"
                                  Checked="OnEdhSuggestionsChanged"
                                  Unchecked="OnEdhSuggestionsChanged"/>
                        <TextBlock x:Name="EdhSynergyStatus" TextWrapping="Wrap"
                                   Margin="0,0,0,6" FontSize="11"
                                   Foreground="{DynamicResource VaultText}"
                                   Text="Reading cached commander text for mechanic matches…"/>
                        <TextBlock x:Name="EdhSuggestionsStatus" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource VaultMuted}"
                                   Text="Local color-identity and legality suggestions loading…"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
                <ComboBox Grid.Row="1" x:Name="OwnedPoolBox"
                          SelectionChanged="OnOwnedPoolChanged"
                          Background="#D7E4EB" Foreground="#0D1017"
                          Margin="0,0,0,8">
                    <ComboBoxItem Content="Physical collection"/>
                    <ComboBoxItem Content="Arena collection"/>
                </ComboBox>
                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                    <TextBox x:Name="OwnedSearchBox"
                             TextChanged="OnOwnedSearchChanged"
                             Padding="9,7" Margin="0,0,0,4"
                             ToolTip="Filter card names; shows up to 200 eligible matches"
                             Background="#202737" Foreground="White"
                             BorderBrush="#514276"/>
                    <TextBlock x:Name="EdhBrowserStatus" Visibility="Collapsed"
                               Text="Deck-aware card status loading…"
                               FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource VaultMuted}"/>
                    <TextBlock x:Name="EdhClickInstructions" Visibility="Collapsed"
                               Text="Single-click to preview · Double-click to add one copy"
                               FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource VaultAccent}"/>
                </StackPanel>
                <ListBox Grid.Row="3" x:Name="OwnedCardsList"
                         DisplayMemberPath="Display"
                         SelectionChanged="OnOwnedCardSelectionChanged"
                         PreviewMouseLeftButtonDown="OnOwnedCardPreviewMouseDown"
                         Background="#171C28" Foreground="#F2F5FA"
                         BorderBrush="#514276"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add (+1)" Click="OnAddOwnedClicked"
                            Padding="10,7" Margin="0,0,7,0"
                            Background="#202737" Foreground="White" BorderBrush="#514276"/>
                    <Button Content="Remove (−1)" Click="OnRemoveOwnedClicked"
                            Padding="10,7"
                            Background="#202737" Foreground="White" BorderBrush="#514276"
                            ToolTip="Decrease the selected card's count in the unsaved deck; does not change ownership"/>
                </StackPanel>
                <TextBlock Grid.Row="5" x:Name="DeckSummaryText" Margin="0,12,0,5"
                           TextWrapping="Wrap" Foreground="#E5BF79"
                           Text="Deck totals will appear here."/>
                <StackPanel Grid.Row="6">
                    <TextBlock x:Name="DeckShortageText"
                               TextWrapping="Wrap" Foreground="#C9A9A9"
                               MaxHeight="100"
                               ToolTip="Only the selected ownership pool is counted; missing copies are not auto-added."/>
                    <TextBlock x:Name="EdhLegalityText"
                               TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"
                               Foreground="{DynamicResource VaultWarning}"/>
                </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="EdhManaTab" Header="Mana &amp; Roles" Visibility="Collapsed"
                         Style="{StaticResource VaultDeckTabStyle}">
                    <!-- Height is bounded at runtime to the available tab viewport;
                         expanding multiple sections scrolls instead of overflowing. -->
                    <ScrollViewer x:Name="EdhManaScroll" VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <StackPanel Margin="10,8,10,12">
                            <TextBlock Text="Mana base &amp; deck roles" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource VaultAccent}"/>
                        <Border Margin="0,8,0,0" Padding="9" CornerRadius="7"
                                Background="{DynamicResource VaultPanelRaised}"
                                BorderBrush="{DynamicResource VaultLine}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DECK BLUEPRINT" FontWeight="SemiBold"
                                           FontSize="11" Foreground="{DynamicResource VaultAccent}"/>
                                <TextBlock x:Name="EdhBlueprintText" Margin="0,5,0,6"
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource VaultText}"
                                           Text="Loading suggested role coverage…"/>
