                                           Foreground="{DynamicResource VaultMuted}"
                                           Text="Select a package card to inspect exact text and artwork. Only a deliberate double-click or Add action changes the unsaved deck."/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Synergy chains — possible two-card links"
                                  IsExpanded="False" Margin="0,3,0,9"
                                  Background="{DynamicResource VaultPanelRaised}"
                                  BorderBrush="{DynamicResource VaultLine}"
                                  BorderThickness="1" Padding="7">
