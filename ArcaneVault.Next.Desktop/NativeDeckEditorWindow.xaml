                                                <TextBlock x:Name="EdhChainPayoffFallback"
                                                           Text="Choose a chain" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource VaultMuted}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
