<Application x:Class="ArcaneVault.Next.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Reuses the original WebView Arcane Vault dark/lavender design tokens.
             Keeping resources in one dictionary lets collection dialogs, editor
             surfaces and future Windows screens stay visually consistent. -->
        <SolidColorBrush x:Key="VaultBackground" Color="#0D1017"/>
        <SolidColorBrush x:Key="VaultSidebar" Color="#121722"/>
        <SolidColorBrush x:Key="VaultPanel" Color="#171C28"/>
        <SolidColorBrush x:Key="VaultPanelRaised" Color="#202737"/>
        <SolidColorBrush x:Key="VaultLine" Color="#343D51"/>
        <SolidColorBrush x:Key="VaultText" Color="#F0F1F6"/>
        <SolidColorBrush x:Key="VaultMuted" Color="#9DA9BD"/>
        <SolidColorBrush x:Key="VaultAccent" Color="#B59BFC"/>
        <SolidColorBrush x:Key="VaultAccentMuted" Color="#7663B3"/>
        <SolidColorBrush x:Key="VaultAccentSurface" Color="#27233E"/>
        <SolidColorBrush x:Key="VaultAccentBorder" Color="#514276"/>
        <SolidColorBrush x:Key="VaultTeal" Color="#7FCAE1"/>
        <SolidColorBrush x:Key="VaultGood" Color="#8BD3AC"/>
        <SolidColorBrush x:Key="VaultWarning" Color="#E5BF79"/>
        <SolidColorBrush x:Key="VaultDanger" Color="#9A5277"/>
        <!-- The original color-identity themes had visible mana gradients.
             Runtime changes replace this shared brush with a new gradient. -->
        <LinearGradientBrush x:Key="VaultThemeBanner" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B59BFC" Offset="0"/>
            <GradientStop Color="#7FCAE1" Offset="1"/>
        </LinearGradientBrush>

        <!-- v0.9.59: layered, theme-aware surfaces. VaultThemeManager replaces
             these gradients as immutable NEW brushes whenever a theme changes.
             Expensive shadows are reserved for static panels, never list rows. -->
        <LinearGradientBrush x:Key="VaultHeroWash" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#332C48" Offset="0"/>
            <GradientStop Color="#211F30" Offset="0.55"/>
            <GradientStop Color="#171C28" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VaultSidebarWash" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#222232" Offset="0"/>
            <GradientStop Color="#121722" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VaultTileWash" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A2A43" Offset="0"/>
            <GradientStop Color="#202737" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="VaultNavHoverWash" Color="#2E304A"/>
        <SolidColorBrush x:Key="VaultEdgeLift" Color="#665A8D"/>

        <!-- Only on large decorative surfaces, not repeated card templates.
             Keeping all catalog ListViews fully virtualized is essential. -->
        <DropShadowEffect x:Key="VaultPanelShadow" BlurRadius="20"
                          ShadowDepth="6" Direction="270" Opacity="0.30"
                          Color="#05080F"/>
        <DropShadowEffect x:Key="VaultHeroShadow" BlurRadius="34"
                          ShadowDepth="10" Direction="270" Opacity="0.34"
                          Color="#05080F"/>

        <Style TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{DynamicResource VaultBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultPrimaryButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource VaultAccentMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="VaultNavButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinHeight" Value="43"/>
        </Style>
        <!-- Rich hover / focus feedback without animations or extra UI trees. -->
        <Style x:Key="VaultNavButtonDepth" TargetType="{x:Type Button}"
               BasedOn="{StaticResource VaultNavButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VaultNavHoverWash}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource VaultEdgeLift}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VaultNavHoverWash}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VaultNavPrimary" TargetType="{x:Type Button}"
               BasedOn="{StaticResource VaultNavButton}">
            <Setter Property="Background" Value="{DynamicResource VaultAccentSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VaultNavHoverWash}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource VaultAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VaultDangerButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#382438"/>
            <Setter Property="BorderBrush" Value="#79516C"/>
            <Setter Property="Foreground" Value="#F2CBDD"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource VaultAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Ensure the text line fits inside the border even with DPI rounding. -->
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxSurface"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxSurface" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxSurface" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Native ComboBox popup and item surfaces must share the app's dark
             palette. Windows' stock popup otherwise renders a white background
             with inherited white text (white-on-white). Editable ComboBoxes keep
             their system text editor, but receive contrasting popup item colors. -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Content"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background"
                                        Value="{DynamicResource VaultAccentSurface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background"
                                        Value="{DynamicResource VaultAccentBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxDropDownHeight" Value="340"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEditable" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBox}">
                                <Grid>
                                    <Border x:Name="ComboSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7"/>
                                    <ToggleButton x:Name="Toggle"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Grid Background="Transparent">
                                                    <Path Data="M 0,0 L 4,4 L 8,0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"
                                                          Stroke="{DynamicResource VaultText}"
                                                          StrokeThickness="1.5"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="10,0,27,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      RecognizesAccessKey="True"/>
                                    <Popup x:Name="PART_Popup"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           StaysOpen="False"
                                           IsOpen="{Binding IsDropDownOpen,
                                               RelativeSource={RelativeSource TemplatedParent},
                                               Mode=TwoWay}">
                                        <Border x:Name="DropDownSurface"
                                                MinWidth="{Binding ActualWidth,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                Background="{DynamicResource VaultPanelRaised}"
                                                BorderBrush="{DynamicResource VaultAccentBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="True">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="ComboSurface"
                                                Property="BorderBrush"
                                                Value="{DynamicResource VaultAccent}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ComboSurface" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource VaultMuted}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="{DynamicResource VaultPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VaultAccentSurface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource VaultPanelRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Background" Value="{DynamicResource VaultLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{DynamicResource VaultPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource VaultMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background"
                                        Value="{DynamicResource VaultAccentSurface}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource VaultText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush"
                                        Value="{DynamicResource VaultAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultEyebrow" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource VaultAccent}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="VaultMutedText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource VaultMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Lifted dashboard tiles: restrained shadow only on a few large
             panels. Theme-specific fills/borders update in place. -->
        <Style x:Key="VaultElevatedPanel" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource VaultTileWash}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultEdgeLift}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Effect" Value="{StaticResource VaultPanelShadow}"/>
        </Style>
        <Style x:Key="VaultPanelCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource VaultPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VaultLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Application.Resources>
</Application>