<UserControl x:Class="ArcaneVault.Next.Desktop.NativeCardPeekPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ArcaneVault.Next.Desktop"
             Background="Transparent" Foreground="{DynamicResource VaultText}">
    <Border Background="{DynamicResource VaultTileWash}"
            BorderBrush="{DynamicResource VaultEdgeLift}" BorderThickness="1"
            CornerRadius="13" Padding="12" MinWidth="230">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="CARD INSPECTOR" Style="{StaticResource VaultEyebrow}"/>
                <TextBlock x:Name="PeekName" Text="Select a card" FontSize="16"
                           FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="64"
                           Foreground="{DynamicResource VaultText}" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" MinHeight="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <Border HorizontalAlignment="Center" Width="160" Height="223"
                            Background="{DynamicResource VaultPanel}" CornerRadius="9"
                            BorderBrush="{DynamicResource VaultLine}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Artwork not cached" FontSize="11"
                                       Foreground="{DynamicResource VaultMuted}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="8"/>
                            <local:NativeCardArtImage x:Name="PeekArt" Width="158"
                                                      Height="221" DecodeWidth="320"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PeekOwnership" Margin="0,10,0,0"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource VaultAccent}"/>
                    <TextBlock x:Name="PeekType" Margin="0,8,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource VaultText}"/>
                    <TextBlock Text="COLOR IDENTITY" Style="{StaticResource VaultEyebrow}"
                               Margin="0,11,0,6"/>
                    <ItemsControl x:Name="PeekIdentity">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:NativeManaSymbol Symbol="{Binding Symbol}"
                                                        Width="25" Height="25"
                                                        Margin="0,0,6,0"
                                                        ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource VaultEdgeLift}"
                            BorderThickness="0,1,0,0" Margin="0,12,0,7"
                            Padding="0,9,0,0">
                        <TextBlock Text="ORACLE TEXT" Style="{StaticResource VaultEyebrow}"/>
                    </Border>
                    <FlowDocumentScrollViewer x:Name="PeekOracle"
                                               Height="170" Background="Transparent"
                                               BorderThickness="0" Padding="0"
                                               IsSelectionEnabled="True"
                                               IsToolBarVisible="False"
                                               Foreground="{DynamicResource VaultText}"
                                               VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Disabled"
                                               AutomationProperties.Name="Selected card Oracle rules with official mana symbols"/>
                    <TextBlock x:Name="PeekStatus" Text="Read-only preview"
                               Foreground="{DynamicResource VaultMuted}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="2" x:Name="PeekFullDetails"
                    Content="Full details &amp; printings"
                    Click="OnFullDetailsClicked"
                    IsEnabled="False" Margin="0,10,0,0" Padding="10,7"
                    Background="{DynamicResource VaultAccentSurface}"
                    Foreground="{DynamicResource VaultText}"
                    BorderBrush="{DynamicResource VaultAccentBorder}"
                    ToolTip="Open read-only full Card Details and artwork browser without changing ownership"/>
        </Grid>
    </Border>
</UserControl>