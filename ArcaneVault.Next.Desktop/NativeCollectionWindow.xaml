<Window x:Class="ArcaneVault.Next.Desktop.NativeCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault — Collection &amp; Deck Library"
        Width="1320" Height="860" MinWidth="930" MinHeight="625"
        Background="{StaticResource VaultBackground}"
        Foreground="{StaticResource VaultText}">
    <Grid Margin="24,22,24,17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource VaultEyebrow}"
                           Text="YOUR VAULT" Margin="0,0,0,6"/>
                <TextBlock Text="Collection &amp; Deck Library"
                           FontSize="29" FontWeight="Bold"/>
                <TextBlock x:Name="DataSourceLabel"
                           Style="{StaticResource VaultMutedText}"
                           Text="Read-only exported backup preview — not an import"
                           Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{StaticResource VaultAccentSurface}"
                    BorderBrush="{StaticResource VaultAccentBorder}"
                    BorderThickness="1" CornerRadius="18"
                    VerticalAlignment="Top" Padding="12,7" Margin="12,5,0,0">
                <TextBlock Text="✦  ARCANE VAULT"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource VaultAccent}"/>
            </Border>
        </Grid>

        <!-- Summary tiles mirror the original dashboard stats, but only
             show verified live/native data instead of guessed ownership. -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="13"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource VaultPanelCard}">
                <StackPanel>
                    <TextBlock Text="OWNED INVENTORY"
                               Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TotalsText"
                               Foreground="{StaticResource VaultText}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource VaultPanelCard}">
                <StackPanel>
                    <TextBlock Text="PRINTING VERIFICATION"
                               Style="{StaticResource VaultEyebrow}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="VerificationText"
                               Foreground="{StaticResource VaultGood}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource VaultPanelCard}"
                Padding="12,10" Margin="0,0,0,13">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="MissingOnly"
                              Content="Unresolved printings only"
                              Margin="0,0,16,0"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                    <Button Content="Card details" Click="OnDetailsClicked"
                            Style="{StaticResource VaultPrimaryButton}"
                            Padding="17,9"/>
                </StackPanel>
                <TextBox x:Name="SearchBox"
                         ToolTip="Filter card names, set hints, collector numbers and verification"
                         TextChanged="OnFilterChanged"
                         Padding="11,9" FontSize="14"
                         Background="{StaticResource VaultPanelRaised}"
                         Foreground="{StaticResource VaultText}"
                         BorderBrush="{StaticResource VaultLine}"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="3" x:Name="CollectionTabs"
                    Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}" BorderBrush="{StaticResource VaultLine}">
            <TabItem Header="Physical Collection">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,4,0,12">
                        <Button x:Name="AddPhysicalButton" Content="＋  Add physical printing"
                                Click="OnAddPhysicalClicked" IsEnabled="False"
                                Style="{StaticResource VaultPrimaryButton}"
                                Padding="14,9" Margin="0,0,10,0"/>
                        <Button x:Name="AdjustPhysicalButton" Content="Edit selected quantity"
                                Click="OnAdjustPhysicalClicked" IsEnabled="False"
                                Style="{StaticResource VaultDangerButton}"
                                Padding="14,9" Margin="0,0,12,0"/>
                        <TextBlock Text="Verified set and collector number • foil variants stay separate"
                                   Style="{StaticResource VaultMutedText}"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                <ListView Grid.Row="1" x:Name="PhysicalList" MouseDoubleClick="OnDetailsClicked"
                          Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Card" Width="285" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Qty" Width="50" DisplayMemberBinding="{Binding Quantity}"/>
                            <GridViewColumn Header="Set / #" Width="135" DisplayMemberBinding="{Binding SetAndNumber}"/>
                            <GridViewColumn Header="Finish" Width="95" DisplayMemberBinding="{Binding Finish}"/>
                            <GridViewColumn Header="Printing verification" Width="300" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Arena Collection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                Margin="8,9,8,9">
                        <Button x:Name="AddArenaButton" Content="Add Arena card"
                                Click="OnAddArenaClicked" IsEnabled="False"
                                Padding="14,8" Margin="0,0,12,0"
                                Background="{StaticResource VaultAccentMuted}" Foreground="White"
                                BorderBrush="{StaticResource VaultAccent}"/>
                        <Button x:Name="EditArenaButton" Content="Edit / remove selected Arena card"
                                Click="OnEditArenaClicked" IsEnabled="False"
                                Padding="14,8" Background="#382438"
                                Foreground="White" BorderBrush="#79516C"/>
                        <TextBlock VerticalAlignment="Center" Margin="17,0,0,0"
                                   Foreground="{StaticResource VaultMuted}" Text="Arena is name-only; no printing ID required."/>
                    </StackPanel>
                <ListView Grid.Row="1" x:Name="ArenaList" MouseDoubleClick="OnDetailsClicked"
                          Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Card" Width="470" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Owned" Width="100" DisplayMemberBinding="{Binding Quantity}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Deck Library">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button x:Name="AddDeckButton" Content="New deck"
                                Click="OnAddDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{StaticResource VaultAccentMuted}" Foreground="White"
                                BorderBrush="{StaticResource VaultAccent}"/>
                        <Button x:Name="EditDeckButton" Content="Edit selected deck"
                                Click="OnEditDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{StaticResource VaultPanelRaised}" Foreground="White"
                                BorderBrush="#65778B"/>
                        <Button x:Name="DuplicateDeckButton" Content="Duplicate selected deck"
                                Click="OnDuplicateDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="{StaticResource VaultPanelRaised}" Foreground="White"
                                BorderBrush="#65778B"/>
                        <Button x:Name="DeleteDeckButton" Content="Delete selected deck"
                                Click="OnDeleteDeckClicked" Padding="14,8"
                                IsEnabled="False" Margin="0,0,10,0"
                                Background="#382438" Foreground="White"
                                BorderBrush="#79516C"/>
                    </WrapPanel>
                    <ListView Grid.Row="1" x:Name="DeckLibraryList"
                              SelectionChanged="OnDeckSelected"
                              Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Deck" Width="240"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Commander" Width="230"
                                                DisplayMemberBinding="{Binding Commander}"/>
                                <GridViewColumn Header="Format" Width="110"
                                                DisplayMemberBinding="{Binding Format}"/>
                                <GridViewColumn Header="Folder" Width="120"
                                                DisplayMemberBinding="{Binding Folder}"/>
                                <GridViewColumn Header="Card names" Width="92"
                                                DisplayMemberBinding="{Binding EntryCount}"/>
                                <GridViewColumn Header="Copies" Width="68"
                                                DisplayMemberBinding="{Binding TotalCopies}"/>
                                <GridViewColumn Header="Revisions" Width="80"
                                                DisplayMemberBinding="{Binding Revisions}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="2" x:Name="DeckLibraryStatus"
                               Foreground="{StaticResource VaultMuted}" TextWrapping="Wrap"
                               Margin="0,11,0,0"
                               Text="Saved decks are distinct from ownership. Format legality is not yet validated."/>
                </Grid>
            </TabItem>
            <TabItem Header="Set Progress">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Find a set" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SetSearch" Width="220" Padding="8,5"
                                 Background="{StaticResource VaultPanelRaised}" Foreground="White" BorderBrush="{StaticResource VaultLine}"
                                 TextChanged="OnSetFilterChanged" Margin="0,0,18,0"/>
                        <CheckBox x:Name="ShowEmptySets" Content="Include sets with 0 verified slots"
                                  IsChecked="False" VerticalAlignment="Center"
                                  Checked="OnSetFilterChanged" Unchecked="OnSetFilterChanged"/>
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="SetSummaryList"
                              SelectionChanged="OnSetSelected"
                              Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Set" Width="70" DisplayMemberBinding="{Binding SetCode}"/>
                                <GridViewColumn Header="Set name" Width="215" DisplayMemberBinding="{Binding SetName}"/>
                                <GridViewColumn Header="Released" Width="110" DisplayMemberBinding="{Binding Released}"/>
                                <GridViewColumn Header="Owned slots" Width="100" DisplayMemberBinding="{Binding SlotsLabel}"/>
                                <GridViewColumn Header="Progress" Width="100" DisplayMemberBinding="{Binding PercentLabel}"/>
                                <GridViewColumn Header="Verified copies" Width="115" DisplayMemberBinding="{Binding VerifiedCopies}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="SetDetailsHeader" Grid.Row="2" Foreground="{StaticResource VaultWarning}"
                               Margin="0,12,0,8" TextWrapping="Wrap"
                               Text="Select a set to inspect its collector-number checklist."/>
                    <ListView Grid.Row="3" x:Name="SetSlotsList"
                              MouseDoubleClick="OnDetailsClicked"
                              Background="{StaticResource VaultPanel}" Foreground="{StaticResource VaultText}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Collector #" Width="140" DisplayMemberBinding="{Binding CollectorNumber}"/>
                                <GridViewColumn Header="Card" Width="410" DisplayMemberBinding="{Binding CardName}"/>
                                <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Ownership}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0"
                   Foreground="#B7C9D8" TextWrapping="Wrap"
                   Text="The viewer never changes collection data. Verified set totals are not completion percentages."/>
    </Grid>
</Window>
