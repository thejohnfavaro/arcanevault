<Window x:Class="ArcaneVault.Next.Desktop.NativeCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault Next — Collection Backup (Read-only)"
        Width="1120" Height="760" MinWidth="780" MinHeight="540"
        Background="#101620" Foreground="#EAF0F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Physical &amp; Arena Collection" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Read-only preview of an exported full backup — not your live Windows collection"
                       Foreground="#B4C8D8" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="TotalsText" Foreground="#E3B87C"
                   TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox DockPanel.Dock="Right" x:Name="MissingOnly"
                      Content="Missing/invalid printing ID only" Margin="18,5,0,0"
                      Foreground="#C8D4DD" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
            <TextBox x:Name="SearchBox" Padding="10,7" FontSize="14"
                     ToolTip="Find owned card names, set codes, and collector numbers"
                     TextChanged="OnFilterChanged"
                     Background="#202C3B" Foreground="#FFFFFF" BorderBrush="#526377"/>
        </DockPanel>
        <TabControl Grid.Row="3" x:Name="CollectionTabs"
                    Background="#172231" Foreground="#EAF0F6" BorderBrush="#3C5165">
            <TabItem Header="Physical Collection">
                <ListView x:Name="PhysicalList"
                          Background="#172231" Foreground="#EAF0F6"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Card" Width="280" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Qty" Width="55" DisplayMemberBinding="{Binding Quantity}"/>
                            <GridViewColumn Header="Set / #" Width="135" DisplayMemberBinding="{Binding SetAndNumber}"/>
                            <GridViewColumn Header="Finish" Width="100" DisplayMemberBinding="{Binding Finish}"/>
                            <GridViewColumn Header="Printing identity" Width="270" DisplayMemberBinding="{Binding PrintingStatus}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Arena Collection">
                <ListView x:Name="ArenaList"
                          Background="#172231" Foreground="#EAF0F6"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Card" Width="470" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Owned" Width="100" DisplayMemberBinding="{Binding Quantity}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0"
                   Foreground="#B7C9D8" TextWrapping="Wrap"
                   Text="Only a saved backup is displayed. IDs are not catalog-verified and nothing is written, synced, restored, or counted toward Set Progress."/>
    </Grid>
</Window>
