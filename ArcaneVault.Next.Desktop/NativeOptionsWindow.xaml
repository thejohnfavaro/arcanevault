<Window x:Class="ArcaneVault.Next.Desktop.NativeOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault — Options" Width="700" Height="530"
        MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VaultBackground}"
        Foreground="{DynamicResource VaultText}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="OPTIONS" Foreground="{DynamicResource VaultAccent}"
                       FontSize="12" FontWeight="Bold" Margin="0,0,0,7"/>
            <TextBlock Text="Make Arcane Vault yours" FontSize="26"
                       FontWeight="Bold" Foreground="{DynamicResource VaultText}"/>
            <TextBlock Text="Your appearance preference is stored separately from cards and decks."
                       Foreground="{DynamicResource VaultMuted}"
                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" CornerRadius="12" Padding="22"
                Background="{DynamicResource VaultPanel}"
                BorderBrush="{DynamicResource VaultLine}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="APPLICATION THEME"
                           FontWeight="SemiBold" Foreground="{DynamicResource VaultAccent}"/>
                <TextBlock Grid.Row="1" Margin="0,9,0,12"
                           TextWrapping="Wrap" Foreground="{DynamicResource VaultMuted}"
                           Text="Five classic themes and all 32 Magic color identities. Choose a theme to preview instantly; save to keep it after restarting."/>
                <ComboBox Grid.Row="2" x:Name="ThemeChoice"
                          SelectionChanged="OnThemeChanged"
                          DisplayMemberPath="Label" SelectedValuePath="Id"
                          MaxDropDownHeight="285" MinHeight="38"
                          Foreground="{DynamicResource VaultText}"/>
                <StackPanel Grid.Row="3" Margin="0,22,0,0">
                    <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource VaultMuted}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SelectedItem.Description, ElementName=ThemeChoice}"
                               Foreground="{DynamicResource VaultMuted}"
                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SelectedItem.PreviewColors, ElementName=ThemeChoice}"
                                  Margin="0,0,0,13"
                                  ToolTip="Actual theme accent colors, including each selected mana color">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding}" Width="42" Height="16"
                                        CornerRadius="4" Margin="0,0,5,0"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource VaultThemeBanner}"
                            Height="5" CornerRadius="3" Margin="0,0,0,10"/>
                    <Border CornerRadius="9" Padding="16"
                            Background="{DynamicResource VaultSidebar}"
                            BorderBrush="{DynamicResource VaultLine}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ARCANE VAULT" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource VaultAccent}"/>
                            <TextBlock Text="Card Catalog  •  Deck Library  •  Set Progress"
                                       TextWrapping="Wrap" Margin="0,7,0,10"
                                       Foreground="{DynamicResource VaultText}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource VaultAccentSurface}"
                                        BorderBrush="{DynamicResource VaultAccentBorder}"
                                        BorderThickness="1" CornerRadius="7"
                                        Padding="10,6" Margin="0,0,9,0">
                                    <TextBlock Text="Selected card"
                                               Foreground="{DynamicResource VaultAccent}"/>
                                </Border>
                                <Border Background="{DynamicResource VaultPanelRaised}"
                                        BorderBrush="{DynamicResource VaultLine}"
                                        BorderThickness="1" CornerRadius="7" Padding="10,6">
                                    <TextBlock Text="Sample collection preview"
                                               Foreground="{DynamicResource VaultText}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="ThemeStatus" Grid.Row="4"
                           Foreground="{DynamicResource VaultMuted}"
                           TextWrapping="Wrap" Margin="0,9,0,0"
                           Text="Select a theme to preview it."/>
            </Grid>
        </Border>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Restore default" Click="OnResetClicked"
                    Padding="14,8" Margin="0,0,9,0"
                    Background="{DynamicResource VaultPanelRaised}"
                    Foreground="{DynamicResource VaultText}"/>
            <Button Content="Cancel" Click="OnCancelClicked"
                    Padding="14,8" Margin="0,0,9,0"
                    Background="{DynamicResource VaultPanelRaised}"
                    Foreground="{DynamicResource VaultText}"/>
            <Button Content="Save appearance" Click="OnSaveClicked"
                    Padding="14,8" Style="{StaticResource VaultPrimaryButton}"/>
        </WrapPanel>
    </Grid>
</Window>