<Window x:Class="ArcaneVault.Next.Desktop.NativeOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Vault — Options" Width="700" Height="530"
        MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource VaultBackground}"
        Foreground="{StaticResource VaultText}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="OPTIONS" Foreground="{StaticResource VaultAccent}"
                       FontSize="12" FontWeight="Bold" Margin="0,0,0,7"/>
            <TextBlock Text="Make Arcane Vault yours" FontSize="26"
                       FontWeight="Bold" Foreground="{StaticResource VaultText}"/>
            <TextBlock Text="Your appearance preference is stored separately from cards and decks."
                       Foreground="{StaticResource VaultMuted}"
                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" CornerRadius="12" Padding="22"
                Background="{StaticResource VaultPanel}"
                BorderBrush="{StaticResource VaultLine}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="APPLICATION THEME"
                           FontWeight="SemiBold" Foreground="{StaticResource VaultAccent}"/>
                <TextBlock Grid.Row="1" Margin="0,9,0,12"
                           TextWrapping="Wrap" Foreground="{StaticResource VaultMuted}"
                           Text="Five classic themes and all 32 Magic color identities. Choose a theme to preview instantly; save to keep it after restarting."/>
                <ComboBox Grid.Row="2" x:Name="ThemeChoice"
                          SelectionChanged="OnThemeChanged"
                          DisplayMemberPath="Label" SelectedValuePath="Id"
                          MaxDropDownHeight="285" MinHeight="38"
                          Foreground="{StaticResource VaultText}"/>
                <StackPanel Grid.Row="3" Margin="0,22,0,0">
                    <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource VaultMuted}" Margin="0,0,0,8"/>
                    <Border CornerRadius="9" Padding="16"
                            Background="{StaticResource VaultSidebar}"
                            BorderBrush="{StaticResource VaultLine}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ARCANE VAULT" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource VaultAccent}"/>
                            <TextBlock Text="Card Catalog  •  Deck Library  •  Set Progress"
                                       TextWrapping="Wrap" Margin="0,7,0,10"
                                       Foreground="{StaticResource VaultText}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource VaultAccentSurface}"
                                        BorderBrush="{StaticResource VaultAccentBorder}"
                                        BorderThickness="1" CornerRadius="7"
                                        Padding="10,6" Margin="0,0,9,0">
                                    <TextBlock Text="Selected card"
                                               Foreground="{StaticResource VaultAccent}"/>
                                </Border>
                                <Border Background="{StaticResource VaultPanelRaised}"
                                        BorderBrush="{StaticResource VaultLine}"
                                        BorderThickness="1" CornerRadius="7" Padding="10,6">
                                    <TextBlock Text="Sample collection preview"
                                               Foreground="{StaticResource VaultText}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="ThemeStatus" Grid.Row="4"
                           Foreground="{StaticResource VaultMuted}"
                           TextWrapping="Wrap" Margin="0,9,0,0"
                           Text="Select a theme to preview it."/>
            </Grid>
        </Border>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Restore default" Click="OnResetClicked"
                    Padding="14,8" Margin="0,0,9,0"
                    Background="{StaticResource VaultPanelRaised}"
                    Foreground="{StaticResource VaultText}"/>
            <Button Content="Cancel" Click="OnCancelClicked"
                    Padding="14,8" Margin="0,0,9,0"
                    Background="{StaticResource VaultPanelRaised}"
                    Foreground="{StaticResource VaultText}"/>
            <Button Content="Save appearance" Click="OnSaveClicked"
                    Padding="14,8" Style="{StaticResource VaultPrimaryButton}"/>
        </WrapPanel>
    </Grid>
</Window>